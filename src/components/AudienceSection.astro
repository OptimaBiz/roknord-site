---
const audiences = [
  { id: "audience-testing", title: "Испытательные лаборатории", standard: "ГОСТ ISO/IEC 17025" },
  { id: "audience-calibration", title: "Калибровочные лаборатории", standard: "ГОСТ ISO/IEC 17025" },
  { id: "audience-medical", title: "Медицинские лаборатории", standard: "ГОСТ Р ИСО 15189" },
  { id: "audience-cert-product", title: "Органы по сертификации продукции и услуг", standard: "ГОСТ Р ИСО/МЭК 17065" },
  { id: "audience-cert-ms", title: "Органы по сертификации систем менеджмента", standard: "ГОСТ Р ИСО/МЭК 17021-1" },
  { id: "audience-inspection", title: "Органы инспекции", standard: "ГОСТ Р ИСО/МЭК 17020" },
  { id: "audience-msi", title: "Провайдеры межлабораторных сличительных испытаний (МСИ)", standard: "ГОСТ ISO/IEC 17043" },
  { id: "audience-halal", title: "Органы по сертификации Халяль", standard: "Стандарты серии ГОСТ Р Халяль" },
];
---

<section id="deliverables" class="section section--light audience-section" aria-labelledby="audience-title">
  <div class="section__inner page-container">
    <header class="audience-intro">
      <p class="section__eyebrow">Направления</p>
      <h2 id="audience-title" class="section__title">Специфика каждого типа аккредитованного лица — учтена</h2>
      <p class="section__lead">Мы не работаем по шаблонным чек-листам. У каждого направления — свой порядок подтверждения компетентности, специфические критерии ФСА и особые требования к доказательной базе.</p>
    </header>

    <ol class="audience-grid">
      {audiences.map((item, index) => (
        <li id={item.id}>
          <span class="audience-grid__num" aria-hidden="true">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p class="audience-grid__standard">{item.standard}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .audience-section .section__inner,.audience-intro{display:grid}.audience-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}
  .audience-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.audience-intro .section__eyebrow{grid-column:1/-1}.audience-intro .section__title,.audience-intro .section__lead{margin:0}
  .audience-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-border);border-left:1px solid var(--lrqa-border)}
  .audience-grid li{display:grid;align-content:start;gap:.65rem;min-height:11rem;padding:clamp(1.15rem,2vw,1.75rem);border-right:1px solid var(--lrqa-border);border-bottom:1px solid var(--lrqa-border);scroll-margin-top:calc(var(--header-total-height) + var(--space-4))}
  .audience-grid h3,.audience-grid p{margin:0}
  .audience-grid__num{color:var(--lrqa-muted-2);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}
  .audience-grid h3{font-size:clamp(1rem,.35vw + .95rem,1.2rem);line-height:1.25;text-wrap:balance}
  .audience-grid__standard{margin-top:auto;padding-top:.75rem;color:var(--lrqa-muted);font-family:var(--font-family-mono);font-size:var(--font-size-2xs);line-height:1.4}
  @media(max-width:64rem){.audience-intro{grid-template-columns:1fr}.audience-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:36rem){.audience-grid{grid-template-columns:1fr}.audience-grid li{min-height:0}}
</style>

---
const audiences = [
  { id: "audience-testing", title: "Испытательные и калибровочные лаборатории", text: "ПК, РОА, первичная аккредитация, замечания и постоянная поддержка качества.", href: "/testing-labs/", image: "/images/materials/lab.webp", imageAlt: "Работа в лаборатории" },
  { id: "audience-cert-ms", title: "Органы по сертификации", text: "СМК, компетентность, выборка дел, область и подготовка к оценке.", href: "/certification-bodies/", image: "/images/materials/смк.webp", imageAlt: "Рабочая встреча по системе менеджмента" },
  { id: "audience-inspection", title: "Органы инспекции и специальные направления", text: "Процедуры, записи, наблюдения и доказательства для вашей области.", href: "#contact", image: "/images/materials/insp.webp", imageAlt: "Проверка документов и процессов" },
];
---

<section id="deliverables" class="section section--light audience-section" aria-labelledby="audience-title">
  <div class="section__inner page-container">
    <header class="audience-intro">
      <p class="section__eyebrow">Кому помогаем</p>
      <h2 id="audience-title" class="section__title">Работаем с теми, чья компетентность должна быть доказана</h2>
      <p class="section__lead">У каждого типа аккредитованного лица свои требования и практика. Поэтому начинаем не с шаблона, а с вашей области, процессов и команды.</p>
    </header>

    <div class="audience-grid">
      {audiences.map((item, index) => (
        <article id={item.id} class="audience-card">
          <img class="audience-card__media" src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
          <div class="audience-card__content">
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a href={item.href}><span>Подробнее</span><span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>

    <div class="audience-note">
      <strong>Не нашли свой тип организации?</strong>
      <p>Работаем также с медицинскими лабораториями, провайдерами МСИ и нетиповыми областями. Сначала уточним задачу и честно скажем, можем ли быть полезны.</p>
      <a href="#contact">Обсудить задачу <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .audience-section .section__inner,.audience-intro{display:grid}.audience-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}.audience-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.audience-intro .section__eyebrow{grid-column:1/-1}.audience-intro .section__title,.audience-intro .section__lead{margin:0}
  .audience-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.audience-card{position:relative;min-height:28rem;overflow:hidden;isolation:isolate;scroll-margin-top:calc(var(--header-total-height) + var(--space-4))}.audience-card__media{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;filter:saturate(.35) contrast(.9) brightness(.88) grayscale(.15);transition:transform var(--duration-normal) var(--easing-standard)}.audience-card::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,color-mix(in srgb,var(--lrqa-navy) 12%,transparent),color-mix(in srgb,var(--lrqa-navy) 96%,transparent))}.audience-card__content{display:grid;align-content:end;gap:.85rem;min-height:100%;padding:clamp(1.4rem,2.6vw,2.6rem);color:var(--lrqa-white)}.audience-card__content>span,.audience-card h3,.audience-card p{margin:0}.audience-card__content>span{color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.audience-card h3{font-size:clamp(1.35rem,1.4vw + 1rem,2.25rem);line-height:1.08;text-wrap:balance}.audience-card p{color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}.audience-card a{display:inline-flex;gap:.65rem;width:fit-content;color:var(--lrqa-white);font-weight:var(--font-weight-semibold);text-decoration:none}.audience-card a span:last-child{color:var(--color-mint-action)}
  .audience-note{display:grid;grid-template-columns:minmax(14rem,.55fr) minmax(0,1.1fr) auto;gap:1rem clamp(2rem,5vw,5rem);align-items:start;padding-top:1.5rem;border-top:1px solid var(--lrqa-border)}.audience-note strong,.audience-note p{margin:0}.audience-note p{color:var(--lrqa-muted);line-height:var(--line-height-relaxed)}.audience-note a{display:inline-flex;gap:.55rem;color:var(--lrqa-black);font-weight:var(--font-weight-semibold);text-decoration:none;white-space:nowrap}.audience-note a span{color:var(--color-mint-action)}
  @media(hover:hover){.audience-card:hover .audience-card__media,.audience-card:focus-within .audience-card__media{transform:scale(1.035)}}@media(max-width:64rem){.audience-intro,.audience-note{grid-template-columns:1fr}.audience-grid{grid-template-columns:1fr 1fr}.audience-card:first-child{grid-column:1/-1}.audience-card{min-height:23rem}}@media(max-width:42rem){.audience-grid{grid-template-columns:1fr}.audience-card:first-child{grid-column:auto}.audience-card{min-height:22rem}}
</style>

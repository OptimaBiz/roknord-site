---
type Props = {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  showPhone?: boolean;
  showMessage?: boolean;
  submitLabel?: string;
  statusText?: string;
  successUrl?: string;
  subject?: string;
  formName?: string;
  embedded?: boolean;
  gateKey?: string;
};

const {
  id = "contact",
  eyebrow = "Контакты",
  title = "Свяжитесь с нами. Внимательно изучим вашу ситуацию.",
  description = "Укажите, что считаете уместным. Ответим в течение рабочего дня.",
  showPhone = true,
  showMessage = true,
  submitLabel = "Отправить",
  statusText = "Ответим в рабочее время",
  successUrl = "/thank-you/",
  subject = "Заявка с сайта Рокнорд",
  formName = "Контактная форма",
  embedded = false,
  gateKey = "",
} = Astro.props as Props;

const titleId = `${id}-form-title`;
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://api.roknord.ru/contact.php";
const consentVersion = "1.1-2026-08-13";
---

<section id={id} class:list={["contact-form-section", embedded && "contact-form-section--embedded"]} aria-labelledby={titleId}>
  <div class="contact-form-section__inner page-container">
    <div class="contact-form-shell">
      <div class="contact-form-copy">
        <p class="section__eyebrow">{eyebrow}</p>
        <h2 id={titleId}>{title}</h2>
        {description && <p>{description}</p>}
        <div class="contact-form-copy__signal" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <form
        class="contact-form"
        action={contactEndpoint}
        method="POST"
        data-contact-form
        data-success-url={successUrl}
        data-gate-key={gateKey}
        novalidate
      >
        <input type="hidden" name="_subject" value={subject} />
        <input type="hidden" name="form_name" value={formName} />
        <input type="hidden" name="consent_version" value={consentVersion} />
        <input type="hidden" name="consent_timestamp" value="" />
        <input type="hidden" name="consent_page" value="" />
        <input type="hidden" name="request_context" value="" data-contact-context-input />
        <input type="text" name="_gotcha" class="contact-form__trap" tabindex="-1" autocomplete="off" />

        <p class="contact-form__context" data-contact-context-display hidden></p>

        <div class="contact-form__grid">
          <label class="contact-field">
            <span>Имя</span>
            <input
              name="name"
              type="text"
              autocomplete="name"
              minlength="2"
              maxlength="80"
              placeholder="Ваше имя"
              required
            />
          </label>

          {showPhone && (
            <label class="contact-field">
              <span>Телефон</span>
              <input
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                pattern="^[+0-9()\\s-]{6,24}$"
                placeholder="+7 000 000 00 00"
                required
              />
            </label>
          )}
        </div>

        <label class="contact-field">
          <span>Электронная почта</span>
          <input name="email" type="email" autocomplete="email" placeholder="name@company.ru" required />
        </label>

        {showMessage && (
          <label class="contact-field">
            <span>Опишите задачу</span>
            <textarea
              name="message"
              rows="5"
              minlength="10"
              maxlength="1200"
              placeholder="Укажите тип организации, процедуру, предполагаемые сроки и основной вопрос"
              required
            ></textarea>
          </label>
        )}

        <label class="contact-consent">
          <input name="personal_data_consent" type="checkbox" value="accepted" required />
          <span class="contact-consent__content">
            <span>Я выражаю согласие на обработку персональных данных.</span>
            <span class="contact-consent__documents">
              <button class="contact-consent__link" type="button" data-legal-open="consent">Текст согласия</button>
              <button class="contact-consent__link" type="button" data-legal-open="privacy">Политика в отношении обработки персональных данных</button>
            </span>
          </span>
        </label>

        <button class="contact-form__submit cta-angled motion-control" type="submit" data-contact-submit data-default-text={submitLabel}>
          <span data-contact-submit-text>{submitLabel}</span>
        </button>

        <p class="contact-form__status" data-contact-status role="status" aria-live="polite">
          {statusText}
        </p>
      </form>

      <dialog class="legal-dialog" data-legal-dialog="consent" aria-labelledby="consent-dialog-title">
        <div class="legal-dialog__inner">
          <div class="legal-dialog__header">
            <h2 id="consent-dialog-title">Согласие на обработку персональных данных</h2>
            <button class="legal-dialog__close" type="button" data-legal-close aria-label="Закрыть текст согласия">×</button>
          </div>
          <div class="legal-dialog__body">
            <p>Я, субъект персональных данных, свободно, своей волей и в своём интересе выражаю согласие на обработку моих персональных данных оператором — Обществом с ограниченной ответственностью «РОКНОРД» (ООО «РОКНОРД»), адрес: 198320, Санкт-Петербург, г. Красное Село, ул. Свободы, д. 57Д, пом. 7-Н, офис 615.</p>
            <p><strong>Цель обработки:</strong> рассмотрение обращения, подготовка ответа, связь со мной, уточнение деталей задачи и подготовка предложения по согласованному формату работы.</p>
            <p><strong>Перечень данных:</strong> имя, номер телефона, адрес электронной почты, сведения об организации, содержание обращения и иные данные, которые я добровольно укажу в форме.</p>
            <p><strong>Действия:</strong> сбор, запись, систематизация, накопление, хранение, уточнение, извлечение, использование, передача в предусмотренных законом случаях, обезличивание, блокирование и удаление.</p>
            <p><strong>Срок:</strong> до достижения цели обработки либо до отзыва согласия, если иной срок не установлен законом. Отзыв направляется на <a href="mailto:hello@roknord.ru">hello@roknord.ru</a>.</p>
            <p>Согласие оформляется отдельно от иных подтверждаемых документов. Непредоставление согласия означает невозможность отправить обращение через форму сайта.</p>
            <p><strong>Редакция согласия:</strong> 1.1 от 13 августа 2026 года.</p>
            <p><a href="/personal-data-consent/">Открыть отдельную страницу согласия</a></p>
          </div>
        </div>
      </dialog>

      <dialog class="legal-dialog" data-legal-dialog="privacy" aria-labelledby="privacy-dialog-title">
        <div class="legal-dialog__inner">
          <div class="legal-dialog__header">
            <h2 id="privacy-dialog-title">Политика в отношении обработки персональных данных</h2>
            <button class="legal-dialog__close" type="button" data-legal-close aria-label="Закрыть политику в отношении обработки персональных данных">×</button>
          </div>
          <div class="legal-dialog__body">
            <p><strong>Оператор:</strong> Общество с ограниченной ответственностью «РОКНОРД» (ООО «РОКНОРД»), адрес: 198320, Санкт-Петербург, г. Красное Село, ул. Свободы, д. 57Д, пом. 7-Н, офис 615. ИНН 7807406530, КПП 780701001.</p>
            <p><strong>Какие данные обрабатываются:</strong> имя, телефон, электронная почта, сведения об организации, содержание обращения, а также необходимые для работы и безопасности сайта технические сведения.</p>
            <p><strong>Цели:</strong> регистрация и рассмотрение обращения, подготовка ответа, связь с пользователем, обеспечение работы и безопасности сайта. Данные формы обрабатываются на основании отдельно выраженного согласия.</p>
            <p><strong>Порядок и срок:</strong> данные обрабатываются только в необходимом объёме и хранятся до достижения заявленной цели либо до отзыва согласия, если иной срок не установлен законом.</p>
            <p><strong>Права пользователя:</strong> можно запросить сведения об обработке, уточнение, блокирование или удаление данных и отозвать согласие, направив обращение на <a href="mailto:hello@roknord.ru">hello@roknord.ru</a>.</p>
            <p><a href="/privacy-policy/">Открыть полную Политику в отношении обработки персональных данных</a></p>
          </div>
        </div>
      </dialog>
    </div>
  </div>

  <script is:inline>
    (() => {
      const contactRoot = document.currentScript?.closest(".contact-form-section");
      const contactForm = contactRoot?.querySelector("[data-contact-form]");
      const contactStatus = contactRoot?.querySelector("[data-contact-status]");
      const contactSubmit = contactRoot?.querySelector("[data-contact-submit]");
      const contactSubmitText = contactRoot?.querySelector("[data-contact-submit-text]");
      const contactContextInput = contactRoot?.querySelector("[data-contact-context-input]");
      const contactContextDisplay = contactRoot?.querySelector("[data-contact-context-display]");
      const legalDialogs = contactRoot?.querySelectorAll("[data-legal-dialog]") || [];

      const applyContactContext = (value) => {
        const context = typeof value === "string" ? value.trim() : "";
        if (contactContextInput instanceof HTMLInputElement) contactContextInput.value = context;
        if (contactContextDisplay instanceof HTMLElement) {
          contactContextDisplay.hidden = !context;
          contactContextDisplay.textContent = context ? `Вы выбрали: ${context}` : "";
        }
      };

      legalDialogs.forEach((dialog) => {
        if (!(dialog instanceof HTMLDialogElement)) return;
        dialog.querySelector("[data-legal-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });

      contactRoot?.querySelectorAll("[data-legal-open]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const documentName = trigger.getAttribute("data-legal-open");
          const dialog = contactRoot.querySelector(`[data-legal-dialog="${documentName}"]`);
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });

      if (contactRoot?.id === "contact" && !document.documentElement.hasAttribute("data-contact-anchor-ready")) {
        document.documentElement.setAttribute("data-contact-anchor-ready", "");
        applyContactContext(new URL(window.location.href).searchParams.get("context"));

        const getContactScrollTop = () => {
          const requestStrip = document.querySelector(".request-strip");
          const stickyOffset = requestStrip?.getBoundingClientRect().height || 0;
          return Math.max(0, contactRoot.getBoundingClientRect().top + window.scrollY - stickyOffset);
        };

        const alignContact = (behavior = "auto") => {
          window.scrollTo({ top: getContactScrollTop(), behavior });
        };

        const settleContactPosition = () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => alignContact("auto"));
          });
        };

        const scrollToContact = () => {
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          alignContact(reduceMotion ? "auto" : "smooth");

          if (reduceMotion) {
            settleContactPosition();
            return;
          }

          if ("onscrollend" in window) {
            window.addEventListener("scrollend", settleContactPosition, { once: true });
          } else {
            window.setTimeout(settleContactPosition, 900);
          }
        };

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          const anchor = event.target.closest('a[href="#contact"], a[href="/#contact"]');
          if (!(anchor instanceof HTMLAnchorElement)) return;

          const targetUrl = new URL(anchor.href, window.location.href);
          if (targetUrl.pathname !== window.location.pathname || targetUrl.hash !== "#contact") return;

          event.preventDefault();
          applyContactContext(anchor.dataset.contactContext || targetUrl.searchParams.get("context"));
          window.history.pushState(null, "", "#contact");
          scrollToContact();
        });

        if (window.location.hash === "#contact") {
          if (document.readyState === "complete") {
            settleContactPosition();
          } else {
            window.addEventListener("load", settleContactPosition, { once: true });
          }

          document.fonts?.ready.then(settleContactPosition);
        }
      }

      const setContactStatus = (message, type) => {
        if (!contactStatus) return;
        contactStatus.textContent = message;
        contactStatus.dataset.state = type;
      };

      contactForm?.addEventListener("submit", async (event) => {
        if (!(contactForm instanceof HTMLFormElement)) return;

        event.preventDefault();
        setContactStatus("", "");

        if (!contactForm.checkValidity()) {
          contactForm.reportValidity();
          setContactStatus("Заполните форму и подтвердите согласие.", "error");
          return;
        }

        if (contactSubmit instanceof HTMLButtonElement) contactSubmit.disabled = true;
        if (contactSubmitText) contactSubmitText.textContent = "Отправляем";
        setContactStatus("Передаём обращение.", "pending");

        try {
          const timestampInput = contactForm.elements.namedItem("consent_timestamp");
          const pageInput = contactForm.elements.namedItem("consent_page");
          if (timestampInput instanceof HTMLInputElement) timestampInput.value = new Date().toISOString();
          if (pageInput instanceof HTMLInputElement) pageInput.value = window.location.href;

          const response = await fetch(contactForm.action, {
            method: contactForm.method,
            body: new FormData(contactForm),
            headers: {
              Accept: "application/json",
            },
          });

          const responseData = await response.json().catch(() => null);

          if (!response.ok) {
            throw new Error(
              responseData?.message || "Не удалось отправить обращение. Попробуйте ещё раз или напишите на hello@roknord.ru.",
            );
          }

          const successUrl = contactForm.dataset.successUrl || "/thank-you/";
          const gateKey = contactForm.dataset.gateKey;
          if (gateKey) {
            try {
              window.sessionStorage.setItem(gateKey, "granted");
            } catch {}
          }
          window.location.assign(successUrl);
        } catch (error) {
          setContactStatus(
            error instanceof Error
              ? error.message
              : "Не удалось отправить обращение. Попробуйте ещё раз или напишите на hello@roknord.ru.",
            "error",
          );
        } finally {
          if (contactSubmit instanceof HTMLButtonElement) contactSubmit.disabled = false;
          if (contactSubmitText && contactSubmit instanceof HTMLButtonElement) {
            contactSubmitText.textContent = contactSubmit.dataset.defaultText || "Отправить";
          }
        }
      });
    })();
  </script>
</section>

<style>
  .contact-form-section {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 0;
    padding-block: var(--section-padding-y);
    border-top: 1px solid var(--color-border-strong);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--lrqa-mint) 10%, transparent) 0 1px, transparent 1px 100%),
      linear-gradient(180deg, color-mix(in srgb, var(--lrqa-white) 4.5%, transparent) 0 1px, transparent 1px 100%),
      linear-gradient(135deg, var(--lrqa-navy) 0%, var(--lrqa-nav) 48%, var(--lrqa-dark-mass) 100%);
    background-size: 5rem 5rem, 5rem 5rem, auto;
    color: var(--lrqa-white);
  }

  .contact-form-section--embedded {
    padding-block: 0;
    border-top: 0;
    background: transparent;
  }

  .contact-form-section--embedded::before {
    content: none;
  }

  .contact-form-section--embedded .contact-form-section__inner {
    max-width: none;
    padding-inline: 0;
  }

  .contact-form-section--embedded .contact-form-shell {
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-inline: 0;
    padding: clamp(var(--space-5), 3vw, var(--space-6));
    border-color: var(--lrqa-border-soft);
    background: var(--lrqa-white);
    color: var(--lrqa-black);
  }

  .contact-form-section--embedded .contact-form-copy h2 {
    color: var(--lrqa-black);
    font-size: var(--type-card-title);
    line-height: var(--line-height-snug);
  }

  .contact-form-section--embedded .contact-form-copy {
    gap: var(--space-3);
  }

  .contact-form-section--embedded .contact-form-copy .section__eyebrow {
    color: var(--lrqa-muted-dark);
  }

  .contact-form-section--embedded .contact-form-copy p:not(.section__eyebrow) {
    color: var(--lrqa-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .contact-form-section--embedded .contact-form-copy__signal {
    display: none;
  }

  .contact-form-section--embedded .contact-form {
    order: 0;
    gap: var(--space-3);
    padding: 0;
    border: 0;
    background: transparent;
  }

  .contact-form-section--embedded .contact-form::before,
  .contact-form-section--embedded .contact-form-shell::before,
  .contact-form-section--embedded .contact-form-shell::after {
    content: none;
  }

  .contact-form-section--embedded .contact-form__grid {
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .contact-form-section--embedded .contact-field {
    gap: var(--space-2);
  }

  .contact-form-section--embedded .contact-field span {
    color: var(--lrqa-muted);
  }

  .contact-form-section--embedded .contact-field input,
  .contact-form-section--embedded .contact-field textarea {
    min-height: 3rem;
    border-color: var(--lrqa-border);
    background: var(--lrqa-white-soft);
    color: var(--lrqa-black);
  }

  .contact-form-section--embedded .contact-field input::placeholder,
  .contact-form-section--embedded .contact-field textarea::placeholder {
    color: var(--lrqa-muted-2);
  }

  .contact-form-section--embedded .contact-consent {
    color: var(--lrqa-muted);
  }

  .contact-form-section--embedded .contact-consent a {
    color: var(--lrqa-black);
  }

  .contact-form-section--embedded .contact-form__status {
    color: var(--lrqa-muted);
  }

  .contact-form-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(100deg, transparent 0%, color-mix(in srgb, var(--lrqa-mint) 13%, transparent) 46%, transparent 68%);
    transform: translateX(-100%);
    opacity: 0.9;
  }

  .contact-form-section__inner {
    position: relative;
    z-index: 1;
  }

  .contact-form-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.72fr);
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    align-items: stretch;
    margin-inline: calc(var(--container-padding) * -1);
    padding-block: clamp(var(--space-5), 4vw, var(--space-8));
    padding-inline: var(--container-padding);
    border: 1px solid var(--color-border-strong);
    background: color-mix(in srgb, var(--lrqa-navy-2) 84%, transparent);
  }

  .contact-form-shell::before,
  .contact-form-shell::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .contact-form-shell::before {
    inset: 0;
    border-top: 2px solid var(--lrqa-mint);
    clip-path: polygon(0 0, 34% 0, 42% 0.55rem, 100% 0, 100% 100%, 0 100%);
    opacity: 0.72;
  }

  .contact-form-shell::after {
    right: var(--space-5);
    bottom: var(--space-5);
    width: 7.5rem;
    height: 7.5rem;
    border-right: 1px solid color-mix(in srgb, var(--lrqa-mint) 48%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--lrqa-mint) 48%, transparent);
  }

  .contact-form-copy {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    max-width: 45rem;
  }

  .contact-form-copy h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--type-section-title);
    font-weight: var(--font-weight-hero-title);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .contact-form-copy p:not(.section__eyebrow) {
    margin: 0;
    max-width: 38rem;
    color: var(--lrqa-border-soft);
    font-size: var(--type-lead);
    line-height: var(--line-height-relaxed);
  }

  .contact-form-copy__signal {
    display: grid;
    grid-template-columns: repeat(3, minmax(2rem, 5.5rem));
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-8);
  }

  .contact-form-copy__signal span {
    height: 0.32rem;
    background: var(--lrqa-mint);
    transform-origin: left center;
  }

  .contact-form-copy__signal span:nth-child(2) {
    opacity: 0.56;
  }

  .contact-form-copy__signal span:nth-child(3) {
    opacity: 0.28;
  }

  .contact-form {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border: 1px solid rgba(222, 221, 228, 0.34);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035)),
      var(--lrqa-navy-2);
  }

  .contact-form__context {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--lrqa-mint);
    background: color-mix(in srgb, var(--lrqa-mint) 9%, transparent);
    color: var(--lrqa-white);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .contact-form::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-left: 0.28rem solid var(--lrqa-mint);
    opacity: 0.9;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .contact-field {
    display: grid;
    gap: var(--space-2);
  }

  .contact-field span {
    color: var(--lrqa-border-soft);
    font-size: var(--type-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .contact-field input,
  .contact-field textarea {
    min-height: 3.1rem;
    border: 1px solid rgba(222, 221, 228, 0.5);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.06);
    color: var(--lrqa-white);
    font-size: var(--type-body);
    line-height: var(--line-height-base);
  }

  .contact-field textarea {
    min-height: 8.2rem;
    resize: vertical;
  }

  .contact-field input:user-invalid,
  .contact-field textarea:user-invalid,
  .contact-consent input:user-invalid {
    border-color: var(--color-danger);
  }

  .contact-form__submit {
    display: inline-flex;

---
import type { SiteLocale } from "../data/homepage";
type Props = { locale?: SiteLocale };
const { locale = "ru" } = Astro.props as Props;
const en = locale === "en";
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://api.roknord.ru/contact.php";
const copy = en ? {
  eyebrow: "No-cost first step",
  title: "Get a preliminary risk review and preparation plan within one working day",
  text: "Send your Rosaccreditation register number or company tax ID and the upcoming procedure. We will review the available scope data and send a preliminary cost and timeframe range.",
  registry: "Register number or tax ID", registryPlaceholder: "RA.RU.21… or company tax ID",
  procedure: "Upcoming procedure", contact: "Phone or email", contactPlaceholder: "+7… or name@company.com",
  submit: "Get a plan and cost estimate", consent: "I consent to personal data processing under the",
  consentLink: "consent terms", status: "No payment or document upload is required.", pending: "Sending…",
  error: "Please complete all fields and confirm your consent.", failure: "The request could not be sent. Please try again or email hello@roknord.ru.",
  options: ["Initial accreditation", "Competence confirmation: CC-1 / CC-2 / CC-5", "Scope extension", "Corrective action after nonconformities"],
} : {
  eyebrow: "Первый шаг без оплаты",
  title: "Узнайте риски и план подготовки к ближайшему ПК или аккредитации за 1 рабочий день",
  text: "Пришлите номер в реестре Росаккредитации или ИНН и тип предстоящей процедуры. Проверим доступные сведения об области и направим предварительное предложение с вилкой стоимости и сроков.",
  registry: "Номер в реестре РАЛ или ИНН", registryPlaceholder: "RA.RU.21… или ИНН организации",
  procedure: "Тип процедуры", contact: "Телефон или email", contactPlaceholder: "+7… или name@company.ru",
  submit: "Получить план и расчёт стоимости", consent: "Согласен на обработку персональных данных в соответствии с",
  consentLink: "текстом согласия", status: "Оплата и загрузка документов на этом этапе не требуются.", pending: "Отправляем…",
  error: "Заполните все поля и подтвердите согласие.", failure: "Не удалось отправить запрос. Попробуйте ещё раз или напишите на hello@roknord.ru.",
  options: ["Первичная аккредитация", "Подтверждение компетентности ПК-1 / ПК-2 / ПК-5", "Расширение области", "Устранение несоответствий"],
};
---

<section id="express-assessment" class="express-assessment" aria-labelledby="express-title">
  <div class="express-assessment__inner page-container">
    <div class="express-assessment__copy" data-reveal>
      <p class="section__eyebrow">{copy.eyebrow}</p>
      <h2 id="express-title">{copy.title}</h2>
      <p>{copy.text}</p>
    </div>

    <form class="express-form" action={endpoint} method="post" data-express-form data-reveal novalidate>
      <input type="hidden" name="form_name" value={en ? "English express assessment" : "Экспресс-оценка"} />
      <input type="hidden" name="consent_version" value="1.1-2026-08-13" />
      <input type="hidden" name="consent_timestamp" value="" />
      <input type="hidden" name="consent_page" value="" />
      <input type="hidden" name="attribution" value="" />
      <input type="text" name="_gotcha" class="express-form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <label><span>{copy.registry}</span><input class="ym-disable-keys" name="registry_or_inn" autocomplete="organization" maxlength="40" placeholder={copy.registryPlaceholder} required /></label>
      <label><span>{copy.procedure}</span><select name="procedure_type" required><option value="">—</option>{copy.options.map((option) => <option value={option}>{option}</option>)}</select></label>
      <label class="express-form__contact"><span>{copy.contact}</span><input class="ym-disable-keys" name="contact" maxlength="254" placeholder={copy.contactPlaceholder} required /></label>
      <label class="express-form__consent"><input name="personal_data_consent" type="checkbox" value="accepted" required /><span>{copy.consent} <a href="/personal-data-consent/">{copy.consentLink}</a>.</span></label>
      <button class="cta-angled motion-control" type="submit" data-express-submit>{copy.submit}</button>
      <p class="express-form__status" data-express-status role="status" aria-live="polite">{copy.status}</p>
    </form>
  </div>

  <script define:vars={{ errorMessage: copy.error, pendingMessage: copy.pending, failureMessage: copy.failure }}>
    (() => {
      const root = document.currentScript?.closest(".express-assessment");
      const form = root?.querySelector("[data-express-form]");
      const submit = root?.querySelector("[data-express-submit]");
      const status = root?.querySelector("[data-express-status]");
      if (!(form instanceof HTMLFormElement)) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          if (status) { status.textContent = errorMessage; status.dataset.state = "error"; }
          return;
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (status) { status.textContent = pendingMessage; status.dataset.state = "pending"; }
        const timestamp = form.elements.namedItem("consent_timestamp");
        const page = form.elements.namedItem("consent_page");
        const attribution = form.elements.namedItem("attribution");
        if (timestamp instanceof HTMLInputElement) timestamp.value = new Date().toISOString();
        if (page instanceof HTMLInputElement) page.value = location.href;
        if (attribution instanceof HTMLInputElement) attribution.value = sessionStorage.getItem("roknord-attribution") || "{}";
        try {
          const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body.message || failureMessage);
          window.__roknordStorePendingConversion?.({ form_name: form.elements.namedItem("form_name")?.value || "Экспресс-оценка", source_page: location.pathname });
          location.assign("/thank-you/");
        } catch (error) {
          if (status) { status.textContent = error instanceof Error ? error.message : failureMessage; status.dataset.state = "error"; }
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });
    })();
  </script>
</section>

<style>
  .express-assessment{padding-block:clamp(3rem,6vw,6rem);color:var(--lrqa-white);background:var(--lrqa-navy);border-bottom:1px solid var(--lrqa-dark-border)}
  .express-assessment__inner{display:grid;grid-template-columns:minmax(0,.85fr) minmax(28rem,1.15fr);gap:clamp(2rem,7vw,7rem);align-items:start}.express-assessment__copy{display:grid;gap:1rem}.express-assessment__copy h2,.express-assessment__copy p{margin:0}.express-assessment__copy h2{font-size:clamp(2rem,3.2vw,4rem);line-height:1.02}.express-assessment__copy>p:last-child{color:var(--lrqa-border);line-height:1.65}.express-assessment .section__eyebrow{color:var(--color-mint-action)}
  .express-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding:clamp(1.4rem,3vw,2.5rem);color:var(--lrqa-black);background:var(--lrqa-white)}.express-form label:not(.express-form__consent){display:grid;gap:.45rem}.express-form label>span{font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}.express-form input,.express-form select{width:100%;min-height:3.25rem;padding:.7rem 1rem;border:1px solid var(--lrqa-border);border-radius:0;background:var(--lrqa-white-soft);color:var(--lrqa-black);font:inherit}.express-form input:focus,.express-form select:focus{border-color:var(--color-mint-action);outline:2px solid color-mix(in srgb,var(--color-mint-action) 35%,transparent);outline-offset:1px}.express-form__contact,.express-form__consent,.express-form button,.express-form__status{grid-column:1/-1}.express-form__consent{display:grid;grid-template-columns:auto 1fr;gap:.65rem;align-items:start}.express-form__consent input{width:1.15rem;min-height:1.15rem;margin-top:.1rem}.express-form__consent span{color:var(--lrqa-muted);font-size:var(--font-size-xs);line-height:1.45}.express-form__consent a{color:var(--lrqa-navy);text-decoration:underline}.express-form button{min-height:3.5rem;border:0;padding:var(--space-3) var(--space-6);background:var(--gradient-button-primary);color:var(--lrqa-black);font:inherit;font-weight:var(--font-weight-bold);cursor:pointer}.express-form button:disabled{cursor:wait;opacity:.65}.express-form__status{margin:0;color:var(--lrqa-muted);font-size:var(--font-size-xs)}.express-form__status[data-state="error"]{color:var(--color-danger)}.express-form__trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important}
  @media(max-width:64rem){.express-assessment__inner{grid-template-columns:1fr}.express-assessment__copy{max-width:50rem}}
  @media(max-width:42rem){.express-form{grid-template-columns:1fr}.express-form label{grid-column:1}}
</style>

---
import { serviceGroups } from "../data/siteNavigation";
import type { SiteLocale } from "../data/homepage";
const { showCookieSettings = true, locale = "ru" } = Astro.props as { showCookieSettings?: boolean; locale?: SiteLocale };
const en = locale === "en";
const copy = en ? { home:'Roknord home page', slogan:'Complex procedures. Thorough preparation.', tagline:'We begin with an independent audit and support further preparation for accreditation and competence confirmation.', company:'ROKNORD LLC', tax:'Tax ID 7807406530 · 22% VAT · EDI', details:'Company details', work:'Work with us', portal:'Client portal', news:'News', materials:'Resources', about:'About', mission:'Mission, vision and values', careers:'Careers', partnerships:'Partnerships', services:'Services', contactsDocs:'Contacts and documents', contacts:'Contacts', documents:'Documents', privacy:'Personal data processing policy', consent:'Personal data processing consent', cookies:'Cookie settings', bottom:'© 2026 ROKNORD LLC · Saint Petersburg, Russia' } : { home:'Рокнорд, на главную страницу', slogan:'Сложные процедуры. Твёрдая подготовка.', tagline:'Начинаем с независимого аудита и ведём дальнейшую подготовку к аккредитации и подтверждению компетентности.', company:'ООО «РОКНОРД»', tax:'ИНН 7807406530 · НДС 22% · ЭДО', details:'Реквизиты', work:'Работа с нами', portal:'Личный кабинет', news:'Новости', materials:'Материалы', about:'О компании', mission:'Миссия, видение и ценности', careers:'Карьера', partnerships:'Сотрудничество', services:'Услуги', contactsDocs:'Контакты и документы', contacts:'Контакты', documents:'Документы', privacy:'Политика обработки ПД', consent:'Согласие на обработку ПД', cookies:'Настройки cookie', bottom:'© 2026 ООО «РОКНОРД» Санкт-Петербург, Россия' };
const dictionary: Record<string,string> = { 'Росаккредитация (ФСА)':'Rosaccreditation (FSA)','Охрана труда':'Occupational safety','Услуги по 152-ФЗ':'Personal data compliance','Подготовка к подтверждению компетентности':'Competence confirmation preparation','Аудит и актуализация области аккредитации':'Accreditation scope audit and update','Корректирующие действия после несоответствий':'Corrective action after nonconformities','Подготовка к первичной аккредитации':'Initial accreditation preparation','Специальные направления':'Specialist services' };
const tr = (value:string) => en ? (dictionary[value] || value) : value;
---

<footer class="footer">
  <div class="footer__columns page-container">
    <section class="footer__col footer__col--brand" aria-labelledby="footer-brand-title">
      <h2 class="footer__heading footer__heading--brand" id="footer-brand-title">
        <a class="footer__logo-link" href={en ? "/en/" : "/"} aria-label={copy.home}>
          <img class="footer__logo" src="/images/brand/roknord-logo-transparent.png" width="2115" height="316" alt="РОКНОРД" decoding="async" />
        </a>
      </h2>
      <p class="footer__brand-slogan">{copy.slogan}</p>
      <p class="footer__tagline">{copy.tagline}</p>
      <address class="footer__requisites">
        <a href="/company/"><strong>{copy.company}</strong></a>
        <span>{copy.tax}</span>
        <a href="/requisites/">{copy.details} <span aria-hidden="true">→</span></a>
      </address>
    </section>

    <section class="footer__col footer__col--nav" aria-labelledby="footer-work-title">
      <h2 class="footer__heading" id="footer-work-title">{copy.work}</h2>
      <nav class="footer__nav" aria-label={copy.work}>
        <a class="footer__nav-link" href="/account/">{copy.portal}</a>
        <a class="footer__nav-link" href="/news/">{copy.news}</a>
        <a class="footer__nav-link" href="/materials/">{copy.materials}</a>
        <a class="footer__nav-link" href="/company/">{copy.about}</a>
        <a class="footer__nav-link" href="/company/mission/">{copy.mission}</a>
        <a class="footer__nav-link" href={en ? "mailto:hello@roknord.ru?subject=Career%20at%20Roknord" : "mailto:hello@roknord.ru?subject=Карьера%20в%20Рокнорд"}>{copy.careers}</a>
        <a class="footer__nav-link" href={en ? "mailto:hello@roknord.ru?subject=Partnership%20with%20Roknord" : "mailto:hello@roknord.ru?subject=Сотрудничество%20с%20Рокнорд"}>{copy.partnerships}</a>
        <details class="footer__services">
          <summary>{copy.services}</summary>
          <div class="footer__services-panel">
            {serviceGroups.map((group) => group.links.length ? (
              <section class="footer__service-group" aria-label={tr(group.label)}>
                <p>{tr(group.label)}</p>
                <div>
                  {group.links.map((item) => <a class="footer__service-link" href={item.href}>{tr(item.label)}</a>)}
                </div>
              </section>
            ) : (
              <a class="footer__service-link footer__service-link--group" href={group.href}>{tr(group.label)}</a>
            ))}
          </div>
        </details>
      </nav>
    </section>

    <section class="footer__col footer__col--nav" aria-labelledby="footer-contact-title">
      <h2 class="footer__heading" id="footer-contact-title">{copy.contactsDocs}</h2>
      <address class="footer__contacts">
        <a class="footer__nav-link" href="/contacts/">{copy.contacts}</a>
        <a class="footer__nav-link" href="tel:+78123898178">+7(812)38-98-178</a>
        <a class="footer__nav-link" href="mailto:hello@roknord.ru">hello@roknord.ru</a>
      </address>
      <nav class="footer__nav footer__nav--legal" aria-label={copy.documents}>
        <a class="footer__nav-link" href="/privacy-policy/">{copy.privacy}</a>
        <a class="footer__nav-link" href="/personal-data-consent/">{copy.consent}</a>
        {showCookieSettings && <button class="footer__nav-link footer__nav-button" type="button" data-cookie-settings>{copy.cookies}</button>}
      </nav>
    </section>
  </div>

  <div class="footer__bottom page-container">
    <span>{copy.bottom}</span>
    <a href="https://db-ip.com/">IP Geolocation by DB-IP</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(var(--footer-padding-block), 5vw, var(--section-y-lg));
    background: var(--color-surface-footer);
    border-top: 1px solid var(--color-border-strong);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 1.15fr 0.9fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .footer__col {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .footer__heading {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__heading--brand {
    line-height: 1;
  }

  .footer__logo-link {
    display: inline-block;
  }

  .footer__logo {
    width: auto;
    height: 2rem;
    object-fit: contain;
  }

  .footer__brand-slogan,
  .footer__tagline {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .footer__brand-slogan {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .footer__tagline {
    max-width: 27rem;
  }

  .footer__requisites,
  .footer__contacts {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-style: normal;
    line-height: var(--line-height-relaxed);
  }

  .footer__requisites strong {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .footer__requisites a {
    width: fit-content;
    color: var(--color-mint-action);
  }

  .footer__nav {
    display: grid;
    gap: var(--space-3);
  }

  .footer__nav--legal {
    margin-top: var(--space-2);
  }

  .footer__services {
    width: 100%;
    max-width: 26rem;
    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .footer__services summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 2.75rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    list-style: none;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .footer__services summary::-webkit-details-marker {
    display: none;
  }

  .footer__services summary::after {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.16rem) rotate(45deg);
    transition: transform var(--duration-fast) var(--easing-standard);
  }

  .footer__services[open] summary::after {
    transform: translateY(0.16rem) rotate(225deg);
  }

  .footer__services summary:hover,
  .footer__services summary:focus-visible {
    color: var(--color-mint-action);
  }

  .footer__services-panel {
    display: grid;
    gap: var(--space-4);
    padding: 0 0 var(--space-5);
  }

  .footer__service-group {
    display: grid;
    gap: var(--space-2);
  }

  .footer__service-group p {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
  }

  .footer__service-group div {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-mint-action);
  }

  .footer__service-link {
    width: fit-content;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-relaxed);
    transition: var(--transition-fast);
  }

  .footer__service-link--group {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .footer__service-link:hover,
  .footer__service-link:focus-visible {
    color: var(--color-mint-action);
  }

  .footer__nav-link {
    width: fit-content;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    transition: var(--transition-fast);
  }

  .footer__nav-link:hover,
  .footer__nav-link:focus-visible,
  .footer__requisites a:hover,
  .footer__requisites a:focus-visible {
    color: var(--color-mint-action);
  }

  .footer__nav-button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-relaxed);
  }

  .footer__bottom a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__bottom a:hover,
  .footer__bottom a:focus-visible {
    color: var(--color-mint-action);
  }

  @media (max-width: 48rem) {
    .footer__columns {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>

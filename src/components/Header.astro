---
import MobileMenu from "./MobileMenu.astro";

const serviceLinks = [
  { label: "Подготовка к подтверждению компетентности", href: "/#scenario-confirmation" },
  { label: "Аудит и актуализация области аккредитации", href: "/#scenario-scope-audit" },
  { label: "Корректирующие действия после выявления несоответствий", href: "/#scenario-corrective-actions" },
  { label: "Подготовка к первичной аккредитации", href: "/#scenario-primary-accreditation" },
  { label: "Специальные направления", href: "/#scenario-special-directions" },
];
const serviceGroups = [
  { label: "Росаккредитация (ФСА)", links: serviceLinks },
  { label: "Охрана труда", href: "/occupational-safety/", links: [] },
  { label: "Услуги по 152-ФЗ", href: "/152-fz/", links: [] },
];
const sectionLinks = [
  { label: "Новости", href: "/news/" },
  { label: "Материалы для скачивания", href: "/materials/" },
  { label: "РАЛ-Атлас", href: "https://atlas.roknord.ru/" },
];
const utilityLinks = [
  { label: "О компании", href: "/company/mission/" },
  { label: "Личный кабинет", href: "#", isLogin: true },
  { label: "Карьера", href: "mailto:hello@roknord.ru?subject=Карьера%20в%20Рокнорд" },
  { label: "Сотрудничество", href: "mailto:hello@roknord.ru?subject=Сотрудничество%20с%20Рокнорд" },
  { label: "Контакты", href: "/#contact" },
];
---

<header class="header">
  <div class="header-service" aria-label="Служебная навигация">
    <div class="topbar__inner header-service-inner page-container">
      <nav class="utility-nav" aria-label="Служебные ссылки">
        {utilityLinks.map((item) => item.isLogin ? <a href={item.href} data-login-trigger>{item.label}</a> : <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="service-phone" href="tel:+78123898178">+7 (812) 389-81-78</a>
      <a class="service-account service-account--mobile" href="#" data-login-trigger>
        <img class="service-account__icon" src="/icons/account_icon_1.svg" alt="" aria-hidden="true" decoding="async" /><span>Личный кабинет</span>
      </a>
      <a class="service-cta cta-angled motion-control" href="/#contact">Разобрать задачу</a>
      <a class="service-cta service-cta--mobile motion-control" href="/#contact">Разобрать задачу</a>
    </div>
  </div>

  <div class="header__inner header-inner page-container">
    <div class="header-primary">
      <a class="brand" href="/" aria-label="Рокнорд, на главную страницу">
        <img class="brand-logo" src="/images/brand/roknord-logo-transparent.png" width="2508" height="627" alt="Рокнорд" decoding="async" />
        <span class="brand-slogan">Сложные процедуры. Твёрдая подготовка.</span>
      </a>
      <a class="header-atlas-compact" href="https://atlas.roknord.ru/">РАЛ-Атлас</a>
      <nav class="site-nav" aria-label="Основная навигация">
        <details class="nav-dropdown">
          <summary aria-controls="services-panel" aria-expanded="false">Услуги</summary>
          <div class="nav-dropdown-panel" id="services-panel"><div class="container nav-dropdown-inner"><p class="nav-dropdown-title">Услуги</p><div class="nav-dropdown-service-groups">{serviceGroups.map((group) => group.links.length ? <section class="nav-dropdown-service-group"><h3>{group.label}</h3><div class="nav-dropdown-list">{group.links.map((item) => <a href={item.href}>{item.label}</a>)}</div></section> : <a class="nav-dropdown-service-link" href={group.href}>{group.label}</a>)}</div></div></div>
        </details>
        {sectionLinks.map((item) => <a class="site-nav-link" href={item.href}>{item.label}</a>)}
      </nav>
      <MobileMenu serviceLinks={serviceLinks} sectionLinks={sectionLinks} utilityLinks={utilityLinks} />
    </div>
  </div>

  <script is:inline>
    (() => {
      const headerRoot = document.currentScript?.closest('header') || document.querySelector('.header');
      const dropdowns = headerRoot ? Array.from(headerRoot.querySelectorAll('.nav-dropdown')) : [];
      const mobileMenu = headerRoot?.querySelector('.mobile-menu');
      const mobileGroups = mobileMenu ? Array.from(mobileMenu.querySelectorAll('.mobile-menu-group')) : [];
      const getInertTargets = () => Array.from(document.querySelectorAll('main, footer, .cookie-panel, .scroll-up-control'));
      let lockedScrollY = 0;
      const syncExpandedState = (details) => {
        const summary = details.querySelector('summary');
        if (summary) summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
        const panel = details.querySelector('.nav-dropdown-panel, .mobile-menu-panel');
        if (panel?.id) summary?.setAttribute('aria-controls', panel.id);
      };
      const closeAll = () => {
        dropdowns.forEach((dropdown) => { dropdown.open = false; syncExpandedState(dropdown); });
        if (mobileMenu) { mobileMenu.open = false; syncExpandedState(mobileMenu); }
      };
      dropdowns.forEach((dropdown) => {
        syncExpandedState(dropdown);
        dropdown.addEventListener('toggle', () => {
          syncExpandedState(dropdown);
          if (!dropdown.open) return;
          dropdowns.forEach((other) => { if (other !== dropdown) { other.open = false; syncExpandedState(other); } });
          if (mobileMenu?.open) { mobileMenu.open = false; syncExpandedState(mobileMenu); }
        });
        dropdown.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeAll));
      });
      if (mobileMenu) {
        syncExpandedState(mobileMenu);
        mobileGroups.forEach((group) => {
          group.querySelector('summary')?.addEventListener('click', () => {
            if (group.open) return;
            mobileGroups.forEach((other) => { if (other !== group) other.open = false; });
          });
        });
        mobileMenu.addEventListener('toggle', () => {
          syncExpandedState(mobileMenu);
          if (mobileMenu.open) {
            lockedScrollY = window.scrollY;
            document.body.style.top = `-${lockedScrollY}px`;
            document.body.classList.add('mobile-menu-open');
            getInertTargets().forEach((target) => {
              if (target instanceof HTMLElement && !target.inert) {
                target.inert = true;
                target.dataset.mobileMenuInert = 'true';
              }
            });
            dropdowns.forEach((dropdown) => { dropdown.open = false; syncExpandedState(dropdown); });
          } else if (document.body.classList.contains('mobile-menu-open')) {
            mobileGroups.forEach((group) => { group.open = false; });
            document.body.classList.remove('mobile-menu-open');
            document.body.style.top = '';
            getInertTargets().forEach((target) => {
              if (target instanceof HTMLElement && target.dataset.mobileMenuInert === 'true') {
                target.inert = false;
                delete target.dataset.mobileMenuInert;
              }
            });
            window.scrollTo(0, lockedScrollY);
          }
        });
        mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeAll));
      }
      document.addEventListener('click', (event) => { if (event.target instanceof Element && !event.target.closest('.header')) closeAll(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeAll(); });
    })();
  </script>
</header>

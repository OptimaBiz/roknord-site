---
import MobileMenu from "./MobileMenu.astro";
import { audienceGroups, sectionLinks, serviceGroups, serviceLinks, utilityLinks } from "../data/siteNavigation";
import type { SiteLocale } from "../data/homepage";
type Props = { locale?: SiteLocale };
const { locale = "ru" } = Astro.props as Props;
const en = locale === "en";
const homeHref = en ? "/en/" : "/";
const contactHref = en ? "/en/#contact" : "/#contact";
const labels = en ? {
  serviceNav: "Utility navigation", utilityLinks: "Utility links", account: "Client portal", cta: "Discuss your needs", slogan: "Complex procedures. Thorough preparation.", home: "ROKNORD. Home page", mainNav: "Main navigation", services: "Services", audiences: "Who we help", audienceHint: "Select your role to see relevant tasks and preparation options.", sector: "Sector focus",
} : {
  serviceNav: "Служебная навигация", utilityLinks: "Служебные ссылки", account: "Личный кабинет", cta: "Разобрать задачу", slogan: "Сложные процедуры. Твёрдая подготовка.", home: "РОКНОРД. Сложные процедуры. Твёрдая подготовка. На главную страницу", mainNav: "Основная навигация", services: "Услуги", audiences: "Кому помогаем", audienceHint: "Выберите вашу роль — покажем релевантные задачи и формат подготовки.", sector: "Отраслевой фокус",
};
const englishLabels: Record<string, string> = {
  "О компании": "About", "Личный кабинет": "Client portal", "Карьера": "Careers", "Сотрудничество": "Partnerships", "Контакты": "Contacts", "Новости": "News", "РАЛ-Атлас": "RAL Atlas",
  "Росаккредитация (ФСА)": "Rosaccreditation (FSA)", "Охрана труда": "Occupational safety", "Услуги по 152-ФЗ": "Personal data compliance",
  "Подготовка к подтверждению компетентности": "Competence confirmation preparation", "Аудит и актуализация области аккредитации": "Accreditation scope audit and update", "Корректирующие действия после несоответствий": "Corrective action after nonconformities", "Подготовка к первичной аккредитации": "Initial accreditation preparation", "Специальные направления": "Specialist services",
  "Аккредитованным лицам": "Accredited bodies", "Лаборатории и органы оценки соответствия": "Laboratories and conformity assessment bodies", "Бизнесу и работодателям": "Businesses and employers", "Обязательные требования вне системы аккредитации": "Mandatory requirements outside accreditation", "Испытательным лабораториям": "Testing laboratories", "Медицинским лабораториям": "Medical laboratories", "Органам по сертификации систем менеджмента": "Management system certification bodies", "Органам по сертификации продукции": "Product certification bodies", "Органам инспекции": "Inspection bodies", "Калибровочным лабораториям": "Calibration laboratories", "Провайдерам МСИ": "Proficiency testing providers", "Органам по сертификации халяль": "Halal certification bodies", "Строительство": "Construction", "Промышленность": "Industry",
};
const tr = (value: string) => en ? (englishLabels[value] || value) : value;
---

<header class="header" data-menu-open={en ? "Open menu" : "Открыть меню"} data-menu-close={en ? "Close menu" : "Закрыть меню"} data-menu-label={en ? "Menu" : "Меню"} data-close-label={en ? "Close" : "Закрыть"}>
  <div class="header-service" aria-label={labels.serviceNav}>
    <div class="topbar__inner header-service-inner page-container">
      <nav class="utility-nav" aria-label={labels.utilityLinks}>
        {[...utilityLinks, ...sectionLinks].map((item) => <a class:list={{ 'utility-nav__atlas': item.href === 'https://atlas.roknord.ru/' }} href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{tr(item.label)}</a>)}
      </nav>
      <a class="service-phone" href="tel:+78123898178">+7(812)38-98-178</a>
      <a class="service-account service-account--mobile" href="/account/">
        <img class="service-account__icon" src="/icons/account_icon_1.svg" alt="" width="200" height="200" aria-hidden="true" decoding="async" /><span>{labels.account}</span>
      </a>
      <div class="language-switch" aria-label={en ? "Language" : "Язык"}><a href="/" data-language-link="ru" lang="ru" aria-current={!en ? "page" : undefined}>RU</a><a href="/en/" data-language-link="en" lang="en" aria-current={en ? "page" : undefined}>EN</a></div>
      <a class="service-cta cta-angled motion-control" href={contactHref}>{labels.cta}</a>
      <a class="service-cta service-cta--mobile motion-control" href={contactHref}>{labels.cta}</a>
    </div>
  </div>

  <div class="header__inner header-inner page-container">
    <div class="header-primary">
      <a class="brand" href={homeHref} aria-label={labels.home} title="ООО «РОКНОРД»">
        <img class="brand-logo" src="/images/brand/roknord-logo-transparent.png" width="2115" height="316" alt="РОКНОРД" decoding="async" />
        <span class="brand-slogan">{labels.slogan}</span>
      </a>
      <nav class="site-nav" aria-label={labels.mainNav}>
        <details class="nav-dropdown">
          <summary aria-controls="services-panel" aria-expanded="false">{labels.services}</summary>
          <div class="nav-dropdown-panel" id="services-panel"><div class="container nav-dropdown-inner"><p class="nav-dropdown-title">{labels.services}</p><div class="nav-dropdown-service-groups">{serviceGroups.map((group) => group.links.length ? <details class="nav-dropdown-service-group"><summary>{tr(group.label)}</summary><div class="nav-dropdown-list">{group.links.map((item) => <a href={item.href}>{tr(item.label)}</a>)}</div></details> : <a class="nav-dropdown-service-link" href={group.href}>{tr(group.label)}</a>)}</div></div></div>
        </details>
        <details class="nav-dropdown">
          <summary aria-controls="audiences-panel" aria-expanded="false">{labels.audiences}</summary>
          <div class="nav-dropdown-panel" id="audiences-panel">
            <div class="container nav-dropdown-inner nav-dropdown-inner--audiences">
              <div class="nav-dropdown-heading">
                <p class="nav-dropdown-title">{labels.audiences}</p>
                <p>{labels.audienceHint}</p>
              </div>
              <div class="nav-audience-groups">
                {audienceGroups.map((group, index) => (
                  <section class="nav-audience-group" aria-labelledby={`audience-group-${index}`}>
                    <div class="nav-audience-group__heading">
                      <h2 id={`audience-group-${index}`}>{tr(group.label)}</h2>
                      <p>{tr(group.description)}</p>
                    </div>
                    <div class="nav-audience-group__links">
                      {group.links.map(item => <a href={item.href}>{tr(item.label)}<span aria-hidden="true">→</span></a>)}
                    </div>
                    {group.sectors.length > 0 && <div class="nav-audience-sectors"><span>{labels.sector}</span>{group.sectors.map(sector => <strong>{tr(sector)}</strong>)}</div>}
                  </section>
                ))}
              </div>
            </div>
          </div>
        </details>
      </nav>
      <MobileMenu serviceLinks={serviceLinks} sectionLinks={sectionLinks} utilityLinks={utilityLinks} locale={locale} />
    </div>
  </div>

  <script is:inline>
    (() => {
      const headerRoot = document.currentScript?.closest('header') || document.querySelector('.header');
      const dropdowns = headerRoot ? Array.from(headerRoot.querySelectorAll('.nav-dropdown')) : [];
      const mobileMenu = headerRoot?.querySelector('.mobile-menu');
      const mobileGroups = mobileMenu ? Array.from(mobileMenu.querySelectorAll('.mobile-menu-group')) : [];
      const inertTargets = new Set();
      const mobileBreakpoint = window.matchMedia('(max-width: 47.99rem)');
      let menuLocked = false;
      let savedScrollY = 0;
      const updateMenuTop = () => {
        if (mobileMenu?.open) headerRoot.style.setProperty('--mobile-menu-top', Math.max(0, headerRoot.getBoundingClientRect().bottom) + 'px');
      };
      const syncExpandedState = (details) => {
        const summary = details.querySelector('summary');
        if (summary) summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
        const panel = details.querySelector('.nav-dropdown-panel, .mobile-menu-panel');
        if (panel?.id) summary?.setAttribute('aria-controls', panel.id);
      };
      const closeAll = () => {
        dropdowns.forEach((dropdown) => { dropdown.open = false; syncExpandedState(dropdown); });
        if (mobileMenu) { mobileMenu.open = false; syncMobileState(); }
      };
      const syncMobileState = () => {
        syncExpandedState(mobileMenu);
        const trigger = mobileMenu.querySelector(':scope > summary');
        trigger.setAttribute('aria-label', mobileMenu.open ? headerRoot.dataset.menuClose : headerRoot.dataset.menuOpen);
        trigger.querySelector('.mobile-menu__label').textContent = mobileMenu.open ? headerRoot.dataset.closeLabel : headerRoot.dataset.menuLabel;
        if (mobileMenu.open && !menuLocked) {
          savedScrollY = window.scrollY;
          document.body.style.setProperty('--mobile-menu-scroll-offset', -savedScrollY + 'px');
          document.body.classList.add('mobile-menu-open');
          menuLocked = true;
          // Only the disclosure remains interactive; preserve pre-existing inert states.
          let branch = mobileMenu;
          while (branch.parentElement) {
            Array.from(branch.parentElement.children).forEach(target => {
              if (target !== branch && target instanceof HTMLElement && !target.inert) {
                target.inert = true;
                inertTargets.add(target);
              }
            });
            if (branch.parentElement === document.body) break;
            branch = branch.parentElement;
          }
          dropdowns.forEach(dropdown => { dropdown.open = false; syncExpandedState(dropdown); });
          mobileGroups.forEach(group => {
            group.open = Boolean(group.querySelector('[aria-current="page"]'));
            syncExpandedState(group);
          });
          trigger.focus({ preventScroll: true });
          updateMenuTop();
        } else if (!mobileMenu.open && menuLocked) {
          menuLocked = false;
          inertTargets.forEach(target => { target.inert = false; });
          inertTargets.clear();
          document.body.classList.remove('mobile-menu-open');
          document.body.style.removeProperty('--mobile-menu-scroll-offset');
          window.scrollTo({ top: savedScrollY, behavior: 'instant' });
          mobileGroups.forEach(group => { group.open = false; syncExpandedState(group); });
          mobileMenu.querySelector('.mobile-menu-content').scrollTop = 0;
        }
      };
      dropdowns.forEach((dropdown) => {
        syncExpandedState(dropdown);
        dropdown.addEventListener('toggle', () => {
          syncExpandedState(dropdown);
          if (!dropdown.open) return;
          dropdowns.forEach((other) => { if (other !== dropdown) { other.open = false; syncExpandedState(other); } });
          if (mobileMenu?.open) { mobileMenu.open = false; syncExpandedState(mobileMenu); }
        });
        dropdown.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeAll));
      });
      if (mobileMenu) {
        syncExpandedState(mobileMenu);
        mobileGroups.forEach((group) => {
          syncExpandedState(group);
          group.addEventListener('toggle', () => syncExpandedState(group));
          group.querySelector('summary')?.addEventListener('click', () => {
            if (group.open) return;
            mobileGroups.forEach((other) => { if (other !== group) other.open = false; });
          });
        });
        mobileMenu.addEventListener('toggle', syncMobileState);
        mobileMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
          closeAll();
          mobileMenu.querySelector(':scope > summary').focus({ preventScroll: true });
          const destination = new URL(link.href);
          if (destination.pathname === location.pathname && destination.hash) {
            const target = document.getElementById(decodeURIComponent(destination.hash.slice(1)));
            if (target) requestAnimationFrame(() => {
              const hadTabindex = target.hasAttribute('tabindex');
              if (!hadTabindex) target.setAttribute('tabindex', '-1');
              target.focus({ preventScroll: true });
              if (!hadTabindex) target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
            });
          }
        }));
        mobileBreakpoint.addEventListener('change', () => {
          const wasOpen = mobileMenu.open;
          closeAll();
          if (wasOpen && !mobileBreakpoint.matches) headerRoot.querySelector('.brand')?.focus({ preventScroll: true });
        });
        window.addEventListener('resize', updateMenuTop);
        new ResizeObserver(updateMenuTop).observe(headerRoot);
        window.addEventListener('pagehide', closeAll);
      }
      document.addEventListener('click', (event) => { if (event.target instanceof Element && !event.target.closest('.header')) closeAll(); });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Tab' && mobileMenu?.open) {
          const controls = Array.from(mobileMenu.querySelectorAll('summary, a[href], button')).filter(item => item.getClientRects().length && !item.closest('[inert]'));
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
          return;
        }
        if (event.key !== 'Escape') return;
        const active = [...dropdowns, mobileMenu].find((item) => item?.open && item.contains(document.activeElement));
        closeAll();
        active?.querySelector('summary')?.focus();
      });
    })();
  </script>
</header>

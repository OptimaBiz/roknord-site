---
import HeroMedia from "./HeroMedia.astro";

const deliverables = [
  "Карта рисков с приоритетами",
  "План корректирующих действий",
  "Перечень недостающих доказательств",
];
---

<section id="top" class="hero hero--cinematic">
  <div class="hero__media-layer" aria-hidden="true">
    <HeroMedia
      posterSrc="/images/hero/roknord-hero-poster.jpg"
      posterAlt=""
      mobileVideoMp4Src="/videos/hero/hero-mobile.mp4"
      videoMp4Src="/videos/hero/reklamnyi-desktop-cropped.mp4"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__inner hero-layout page-container">
    <div class="hero-copy">
      <p class="hero-kicker">Комплексный аудит и подготовка к процедурам Росаккредитации</p>
      <h1 class="hero-title">Находим риски раньше, чем их найдёт экспертная группа</h1>
      <p class="hero-lead">
        Готовим лаборатории и органы по сертификации к аккредитации, ПК и расширению области.
      </p>
      <div class="hero-actions">
        <a class="hero-action hero-action--primary cta-angled motion-control" href="#contact"><span>Обсудить условия аудита</span><span aria-hidden="true">→</span></a>
        <a class="hero-action hero-action--secondary motion-control" href="#material">Карта рисков — скачать</a>
      </div>
    </div>

    <aside class="hero-assurance" aria-label="Результат первого этапа">
      <p class="hero-assurance__label">Первый шаг — первичный аудит</p>
      <h2>С чем вы выходите после первого этапа</h2>
      <ul>
        {deliverables.map((item, index) => <li><span aria-hidden="true">0{index + 1}</span><strong>{item}</strong></li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero-layout{grid-template-columns:minmax(0,1.22fr) minmax(19rem,.6fr);align-items:end;justify-items:stretch;gap:clamp(2rem,6vw,7rem)}
  .hero-copy{display:grid;gap:clamp(1rem,2vw,1.6rem);max-width:66rem;text-align:left}.hero-kicker,.hero-title,.hero-lead,.hero-assurance p,.hero-assurance h2{margin:0}
  .hero-kicker{color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .hero-title{max-width:17ch;font-size:clamp(2.45rem,5.35vw,5.8rem);font-weight:var(--font-weight-semibold);line-height:.96;text-align:left;text-wrap:balance}
  .hero-lead{max-width:52rem;color:var(--lrqa-white);font-size:clamp(1rem,.5vw + .95rem,1.28rem);line-height:1.55;text-align:left}
  .hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.4rem}.hero-action{display:inline-flex;align-items:center;justify-content:center;gap:.75rem;min-height:3.25rem;font-weight:var(--font-weight-semibold);text-decoration:none}.hero-action--primary{padding:var(--cta-padding-y) calc(var(--cta-padding-x) + var(--button-bevel)*.5);color:var(--lrqa-black);background:var(--gradient-button-primary)}.hero-action--secondary{color:var(--lrqa-white);border-bottom:1px solid color-mix(in srgb,var(--lrqa-white) 62%,transparent)}
  .hero-assurance{display:grid;gap:1.05rem;padding:clamp(1.35rem,2.6vw,2.25rem);background:rgba(18,19,22,.88);background:color-mix(in srgb,var(--lrqa-navy) 88%,transparent);border-top:3px solid var(--color-mint-action);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}.hero-assurance__label{color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.hero-assurance h2{max-width:17ch;color:var(--lrqa-white);font-size:clamp(1.4rem,1.8vw,2.2rem);line-height:1.1}.hero-assurance__text{color:var(--lrqa-border-soft);font-size:var(--font-size-sm);line-height:var(--line-height-relaxed)}.hero-assurance ul{display:grid;margin:0;padding:0;list-style:none}.hero-assurance li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.75rem;padding:.9rem 0;border-top:1px solid rgba(245,244,240,.2);border-top:1px solid color-mix(in srgb,var(--lrqa-white) 20%,transparent)}.hero-assurance li span{color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.hero-assurance li strong{color:var(--lrqa-white);font-size:.96rem;line-height:1.35}
  @media(max-width:64rem){.hero-layout{grid-template-columns:1fr;align-content:center}.hero-assurance{max-width:44rem}}
  @media(max-width:47.99rem){.hero{min-height:auto;padding-top:2rem}.hero-title{font-size:clamp(2.15rem,9.8vw,3.65rem)}.hero-actions,.hero-action--primary{width:100%}.hero-action--secondary{width:fit-content}.hero-assurance{-webkit-backdrop-filter:none;backdrop-filter:none}}
</style>

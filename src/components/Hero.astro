---
import HeroMedia from "./HeroMedia.astro";
import { homepageContent, type SiteLocale } from "../data/homepage";

type Props = { locale?: SiteLocale };
const { locale = "ru" } = Astro.props as Props;
const content = homepageContent[locale].hero;
---

<section id="top" class="hero hero--editorial">
  <div class="hero-editorial__media" aria-hidden="true">
    <HeroMedia
      posterSrc="/images/hero/roknord-hero-poster.webp"
      mobilePosterSrc="/images/hero/roknord-hero-poster-mobile.webp"
      posterAlt=""
    />
  </div>
  <div class="hero-editorial__veil" aria-hidden="true"></div>
  <div class="hero__inner hero-editorial page-container">
    <div class="hero-editorial__copy" data-hero-intro>
      <p class="hero-editorial__eyebrow">{content.eyebrow}</p>
      <h1 class="hero-editorial__title">{content.title}</h1>
      <p class="hero-editorial__lead">
        {content.lead[0]}<br />
        {content.lead[1]}
      </p>
      <div class="hero-editorial__actions">
        <a class="hero-editorial__primary hero-action--primary cta-angled motion-control" href="#express-assessment"><span>{content.primary}</span><span aria-hidden="true">→</span></a>
        <a class="hero-editorial__secondary" href="/materials/audit-report-example/">{content.secondary} <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="hero-editorial__principles" aria-label={content.principlesLabel}>
        {content.principles.map((item) => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}
      </ul>
      <details class="hero-editorial__mobile-proof">
        <summary>{locale === "en" ? "What is included in the review" : "Что входит в проверку"}</summary>
        <ul>{content.principles.map((item) => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}</ul>
      </details>
    </div>

  </div>
</section>

<style>
  .hero--editorial{min-height:auto;padding:0;background:var(--lrqa-navy);border-bottom:1px solid var(--lrqa-dark-border)}
  .hero-editorial__media,.hero-editorial__veil{position:absolute;inset:0;pointer-events:none}.hero-editorial__media{z-index:0}.hero-editorial__veil{z-index:1;background:linear-gradient(90deg,rgba(0,31,26,.46) 0%,rgba(0,31,26,.18) 48%,rgba(0,31,26,.3) 100%),linear-gradient(180deg,rgba(0,31,26,.08),rgba(0,31,26,.35))}
  .hero-editorial__media :global(.hero-media__poster),.hero-editorial__media :global(.hero-media__video){filter:saturate(.76) contrast(1.04) brightness(.82)}
  .hero-editorial{position:relative;z-index:3;display:flex;align-items:center;min-height:clamp(38rem,72svh,44rem)}
  .hero-editorial__copy{display:grid;align-content:center;gap:clamp(1rem,1.6vw,1.45rem);width:min(100%,58rem);min-width:0;margin-block:clamp(1.5rem,3.5vw,3rem);padding:clamp(1.75rem,3.4vw,3.2rem);background:rgba(245,244,240,.97);box-shadow:1rem 1rem 0 rgba(0,31,26,.28);animation:editorialIntro .75s var(--easing-emphasis) both}
  .hero-editorial__eyebrow{margin:0;color:var(--lrqa-muted);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .hero-editorial__title{max-width:24ch;margin:0;color:var(--lrqa-navy);font-family:var(--font-heading);font-size:clamp(2.55rem,3.5vw,4.25rem);font-weight:var(--font-weight-semibold);letter-spacing:-.045em;line-height:.98;text-wrap:balance}
  .hero-editorial__lead{max-width:43rem;margin:0;color:var(--lrqa-muted);font-size:clamp(1.08rem,.55vw + .98rem,1.35rem);line-height:1.58}
  .hero-editorial__actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.6rem}.hero-editorial__primary{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:3.35rem;padding:var(--cta-padding-y) calc(var(--cta-padding-x) + var(--button-bevel)*.5);color:var(--lrqa-black);background:var(--gradient-button-primary);font-weight:var(--font-weight-semibold);text-decoration:none}.hero-editorial__secondary{display:inline-flex;align-items:center;gap:.55rem;padding:.55rem 0;color:var(--lrqa-navy);font-weight:var(--font-weight-semibold);text-decoration:none;border-bottom:1px solid var(--lrqa-border)}.hero-editorial__secondary:hover,.hero-editorial__secondary:focus-visible{border-color:var(--lrqa-navy)}
  .hero-editorial__principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:.5rem 0 0;padding:0;list-style:none;border-top:1px solid var(--lrqa-border)}.hero-editorial__principles li{display:grid;gap:.25rem;padding:1rem 1rem 0 0}.hero-editorial__principles li+li{padding-left:1rem;border-left:1px solid var(--lrqa-border-soft)}.hero-editorial__principles strong{color:var(--lrqa-navy);font-size:.88rem}.hero-editorial__principles span{color:var(--lrqa-muted);font-size:var(--font-size-xs);line-height:1.4}
  .hero-editorial__mobile-proof{display:none}
  @keyframes editorialIntro{from{opacity:0;transform:translateY(1.15rem)}to{opacity:1;transform:none}}
  @media(max-width:64rem){.hero-editorial{min-height:auto}.hero-editorial__copy{width:min(100%,46rem)}.hero-editorial__title{max-width:16ch}}
  @media(max-width:47.99rem){.hero-editorial{min-height:auto}.hero-editorial__veil{background:rgba(0,31,26,.45)}.hero-editorial__copy{margin-block:1.25rem;padding:clamp(1.5rem,6vw,2rem);box-shadow:.65rem .65rem 0 rgba(0,31,26,.28)}.hero-editorial__title{font-size:clamp(1.85rem,7.8vw,2.35rem);overflow-wrap:anywhere}.hero-editorial__actions,.hero-editorial__primary{width:100%}.hero-editorial__secondary{width:fit-content}.hero-editorial__principles{grid-template-columns:1fr}.hero-editorial__principles li,.hero-editorial__principles li+li{grid-template-columns:7.75rem 1fr;gap:.75rem;padding:.7rem 0;border-left:0;border-bottom:1px solid var(--lrqa-border-soft)}}
  @media(max-width:47.99rem){
    .hero-editorial__copy{gap:1rem}
    .hero-editorial__lead{font-size:1rem;line-height:1.55}
    .hero-editorial__actions{display:block}
    .hero-editorial__primary{min-height:3.3rem}
    .hero-editorial__secondary,.hero-editorial__principles{display:none}
    .hero-editorial__mobile-proof{display:block;margin-top:.5rem;border-top:1px solid var(--lrqa-border);padding-top:.6rem}
    .hero-editorial__mobile-proof summary{padding:.6rem 0;color:var(--lrqa-navy);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);cursor:pointer}
    .hero-editorial__mobile-proof summary:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent-strong);outline-offset:var(--focus-outline-offset)}
    .hero-editorial__mobile-proof ul{display:grid;gap:.6rem;margin:.65rem 0 0;padding:0;list-style:none}
    .hero-editorial__mobile-proof li{display:grid;gap:.1rem;border-top:1px solid var(--lrqa-border-soft);padding-top:.6rem}
    .hero-editorial__mobile-proof li strong{color:var(--lrqa-navy);font-size:var(--font-size-sm)}
    .hero-editorial__mobile-proof li span{color:var(--lrqa-muted);font-size:var(--font-size-xs)}
  }
  @media(prefers-reduced-motion:reduce){.hero-editorial__copy{animation:none}.hero-editorial__media :global(.hero-media__video){display:none}}
</style>

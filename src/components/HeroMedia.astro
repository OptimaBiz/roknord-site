---
type Props = {
  posterSrc: string;
  mobilePosterSrc?: string;
  posterAlt?: string;
  videoWebmSrc?: string;
  mobileVideoMp4Src?: string;
  videoMp4Src?: string;
  class?: string;
};

const {
  posterSrc,
  mobilePosterSrc = "",
  posterAlt = "",
  videoWebmSrc = "",
  mobileVideoMp4Src = "",
  videoMp4Src = "",
  class: className = "",
} = Astro.props as Props;

const desktopSrc = videoMp4Src || videoWebmSrc || mobileVideoMp4Src;
const mobileSrc = mobileVideoMp4Src || desktopSrc;
const mobilePoster = mobilePosterSrc || posterSrc;
const hasVideo = Boolean(desktopSrc);
---

<div class={`hero-media ${className}`.trim()} aria-hidden="true">
  <picture class="hero-media__poster-frame">
    <source media="(max-width: 47.99rem)" srcset={mobilePoster} />
    <img
      class="hero-media__poster"
      src={posterSrc}
      alt={posterAlt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  {hasVideo && (
    <video
      class="hero-media__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      data-hero-video
      data-mobile-video-src={mobileSrc}
      data-desktop-video-src={desktopSrc}
    ></video>
  )}
</div>

{hasVideo && (
  <script is:inline>
    // Намеренно inline и без type="module": скрипт должен выполниться синхронно,
    // сразу за <video>. У элемента нет атрибута src — источник ставится здесь,
    // до того как браузер начнёт что-либо качать. Отложенный module-скрипт этого
    // не успевает, и телефон сначала тянет десктопный ролик, а потом обрывает его.
    (function () {
      var video = document.querySelector("[data-hero-video]:not([data-hero-ready])");
      if (!video) return;
      video.setAttribute("data-hero-ready", "");

      var desktopSrc = video.getAttribute("data-desktop-video-src") || "";
      var mobileSrc = video.getAttribute("data-mobile-video-src") || desktopSrc;
      var desktopQuery = window.matchMedia("(min-width: 48rem)");

      // Safari снимает autoplay, если muted выставлен только атрибутом.
      video.defaultMuted = true;
      video.muted = true;
      video.playsInline = true;

      function startVideo() {
        if (!video.paused) return;
        var played = video.play();
        if (played && typeof played.catch === "function") played.catch(function () {});
      }

      function syncVideoSource() {
        var preferred = desktopQuery.matches ? desktopSrc : mobileSrc;
        if (!preferred || video.getAttribute("src") === preferred) return;
        video.setAttribute("src", preferred);
        video.load();
      }

      syncVideoSource();
      startVideo();

      function handleViewportChange() {
        syncVideoSource();
        startVideo();
      }

      if (typeof desktopQuery.addEventListener === "function") {
        desktopQuery.addEventListener("change", handleViewportChange);
      } else if (typeof desktopQuery.addListener === "function") {
        desktopQuery.addListener(handleViewportChange);
      }

      video.addEventListener("loadeddata", startVideo);
      video.addEventListener("canplay", startVideo);
      // Safari возвращает страницу из bfcache с остановленным видео.
      window.addEventListener("pageshow", startVideo);
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") startVideo();
      });
    })();
  </script>
)}

---
type Props = {
  posterSrc: string;
  posterAlt?: string;
  videoWebmSrc?: string;
  mobileVideoMp4Src?: string;
  videoMp4Src?: string;
  class?: string;
};

const {
  posterSrc,
  posterAlt = "",
  videoWebmSrc = "",
  mobileVideoMp4Src = "",
  videoMp4Src = "",
  class: className = "",
} = Astro.props as Props;

const hasVideo = Boolean(mobileVideoMp4Src || videoWebmSrc || videoMp4Src);
const defaultVideoSrc = videoMp4Src || videoWebmSrc || mobileVideoMp4Src;
---

<div class={`hero-media ${className}`.trim()} aria-hidden="true">
  {hasVideo ? (
    <video
      class="hero-media__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      src={defaultVideoSrc}
      poster={posterSrc}
      disablepictureinpicture
      data-hero-video
      data-mobile-video-src={mobileVideoMp4Src}
      data-desktop-video-src={videoMp4Src || videoWebmSrc}
    >
      {videoMp4Src && <source src={videoMp4Src} type="video/mp4" media="(min-width: 48rem)" />}
      {videoWebmSrc && <source src={videoWebmSrc} type="video/webm" media="(min-width: 48rem)" />}
      {mobileVideoMp4Src && <source src={mobileVideoMp4Src} type="video/mp4" media="(max-width: 47.99rem)" />}
      {!videoMp4Src && videoWebmSrc && <source src={videoWebmSrc} type="video/webm" />}
      {!videoMp4Src && mobileVideoMp4Src && <source src={mobileVideoMp4Src} type="video/mp4" />}
    </video>
  ) : (
    <img
      class="hero-media__poster"
      src={posterSrc}
      alt={posterAlt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  )}
</div>

{hasVideo && (
  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

    if (video) {
      video.defaultMuted = true;
      video.muted = true;
      video.playsInline = true;
      video.autoplay = true;

      const desktopQuery = window.matchMedia('(min-width: 48rem)');
      const desktopSrc = video.dataset.desktopVideoSrc || video.currentSrc || video.src;
      const mobileSrc = video.dataset.mobileVideoSrc || desktopSrc;

      const getPreferredSrc = () => (desktopQuery.matches ? desktopSrc : mobileSrc);

      const startVideo = () => {
        if (!video.paused) return;
        video.play().catch(() => {});
      };

      const syncVideoSource = () => {
        const preferredSrc = getPreferredSrc();
        if (!preferredSrc || video.getAttribute('src') === preferredSrc) return;

        video.setAttribute('src', preferredSrc);
        video.load();
      };

      syncVideoSource();
      startVideo();
      const handleViewportChange = () => {
        syncVideoSource();
        startVideo();
      };

      if (typeof desktopQuery.addEventListener === 'function') {
        desktopQuery.addEventListener('change', handleViewportChange);
      } else {
        desktopQuery.addListener(handleViewportChange);
      }

      video.addEventListener('loadeddata', startVideo, { once: true });
      video.addEventListener('canplay', startVideo, { once: true });
      window.addEventListener('pageshow', startVideo);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') startVideo();
      });
    }
  </script>
)}

---
type Props = {
  posterSrc: string;
  posterAlt?: string;
  videoWebmSrc?: string;
  mobileVideoMp4Src?: string;
  videoMp4Src?: string;
  class?: string;
};

const {
  posterSrc,
  posterAlt = "",
  videoWebmSrc = "",
  mobileVideoMp4Src = "",
  videoMp4Src = "",
  class: className = "",
} = Astro.props as Props;

const hasVideo = Boolean(mobileVideoMp4Src || videoWebmSrc || videoMp4Src);
---

<div class={`hero-media ${className}`.trim()} aria-hidden="true">
  {hasVideo ? (
    <video
      class="hero-media__video"
      muted
      loop
      playsinline
      preload="metadata"
      poster={posterSrc}
      data-hero-video
      data-mobile-src={mobileVideoMp4Src}
      data-desktop-src={videoMp4Src || videoWebmSrc}
    ></video>
  ) : (
    <img
      class="hero-media__poster"
      src={posterSrc}
      alt={posterAlt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  )}
</div>

{hasVideo && (
  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);

    if (video && !reduceMotion && !saveData) {
      const isMobile = window.matchMedia('(max-width: 47.99rem)').matches;
      const source = isMobile
        ? video.dataset.mobileSrc
        : video.dataset.desktopSrc;

      const startVideo = () => {
        if (!source || video.src) return;
        video.src = source;
        video.play().catch(() => {});
      };

      startVideo();
    }
  </script>
)}

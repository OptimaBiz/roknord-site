---
const checks = [
  {
    title: "Область и ресурсы",
    text: "Сопоставляем заявленную область с оборудованием, помещениями и компетентностью персонала.",
  },
  {
    title: "СМК и записи",
    text: "Проверяем, подтверждают ли записи выполнение установленных процедур.",
  },
  {
    title: "Персонал и практика",
    text: "Сверяем полномочия и подтверждения компетентности с фактически выполняемыми работами.",
  },
  {
    title: "Сведения во ФГИС",
    text: "Проверяем согласованность сведений во ФГИС с внутренними документами и записями.",
  },
];
---

<section id="approach" class="section section--dark ilogic" aria-labelledby="ilogic-title">
  <div class="section__inner page-container">
    <header class="ilogic__intro" data-reveal>
      <p class="section__eyebrow">Предмет проверки</p>
      <h2 id="ilogic-title" class="section__title">Что именно проверяем</h2>
      <p class="section__lead">Документа недостаточно: важно, чтобы требования, процедуры, записи и работа организации подтверждали друг друга.</p>
    </header>

    <div class="ilogic__formula" aria-label="Логика проверки" data-reveal>
      <span>Требование</span><i aria-hidden="true">→</i><span>Процедура</span><i aria-hidden="true">→</i><span>Запись</span><i aria-hidden="true">→</i><span>Доказательство</span>
    </div>

    <ol class="ilogic__checks" data-reveal>
      {checks.map((item, index) => (
        <li>
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>

    <aside class="ilogic__example" aria-label="Пример результата проверки" data-reveal>
      <span>Пример результата</span>
      <p><strong>Расхождение:</strong> фактически выполняемая работа не подтверждена действующей записью.</p>
      <p><strong>В отчёте:</strong> применимое требование, оценка риска и рекомендуемое действие.</p>
    </aside>
  </div>
</section>

<style>
  .ilogic .section__inner,
  .ilogic__intro,
  .ilogic__checks,
  .ilogic__checks li,
  .ilogic__example {
    display: grid;
  }

  .ilogic .section__inner {
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .ilogic__intro {
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    gap: 0.75rem clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .ilogic__intro .section__eyebrow {
    grid-column: 1 / -1;
  }

  .ilogic__intro .section__title,
  .ilogic__intro .section__lead,
  .ilogic__checks,
  .ilogic__checks h3,
  .ilogic__checks p,
  .ilogic__example p {
    margin: 0;
  }

  .ilogic__formula {
    display: grid;
    grid-template-columns: repeat(7, auto);
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    color: var(--lrqa-white);
    font-family: var(--font-family-mono);
    font-size: clamp(0.78rem, 0.4vw + 0.7rem, 1rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    border: 1px solid var(--lrqa-dark-border);
  }

  .ilogic__formula i {
    color: var(--color-mint-action);
    font-style: normal;
  }

  .ilogic__checks {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--lrqa-dark-border);
    border-left: 1px solid var(--lrqa-dark-border);
  }

  .ilogic__checks li {
    align-content: start;
    gap: 0.65rem;
    min-height: 13.5rem;
    padding: clamp(1.25rem, 2vw, 1.8rem);
    border-right: 1px solid var(--lrqa-dark-border);
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .ilogic__checks li > span,
  .ilogic__example > span {
    color: var(--color-mint-action);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .ilogic__checks h3 {
    color: var(--lrqa-white);
    font-size: clamp(1.1rem, 0.65vw + 1rem, 1.55rem);
    line-height: 1.18;
  }

  .ilogic__checks p,
  .ilogic__example p {
    color: var(--lrqa-border-soft);
    line-height: 1.6;
  }

  .ilogic__example {
    grid-template-columns: minmax(9rem, 0.35fr) repeat(2, minmax(0, 1fr));
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--lrqa-dark-border);
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .ilogic__example strong {
    color: var(--lrqa-white);
  }

  @media (max-width: 64rem) {
    .ilogic__intro,
    .ilogic__example {
      grid-template-columns: 1fr;
    }

    .ilogic__checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .ilogic__formula {
      grid-template-columns: 1fr auto;
      justify-content: stretch;
      gap: 0.65rem 1rem;
    }

    .ilogic__formula i {
      transform: rotate(90deg);
    }

    .ilogic__formula i:last-of-type {
      display: none;
    }

    .ilogic__formula span:last-child {
      grid-column: 1 / -1;
    }

    .ilogic__checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ilogic__checks li {
      min-height: 0;
      padding: 0.9rem;
    }

    .ilogic__checks h3 {
      font-size: 1rem;
    }

    .ilogic__checks p {
      font-size: 0.82rem;
      line-height: 1.48;
    }
  }
</style>

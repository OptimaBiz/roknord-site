---
const outcomes = [
  { title: "Что уже готово", text: "Отделяем рабочие элементы системы от того, что требует внимания." },
  { title: "Где возникает риск", text: "Показываем расхождения между требованиями, документами, записями и практикой." },
  { title: "Чем он подтверждён", text: "Каждый вывод связываем с требованием и доступными доказательствами." },
  { title: "Что делать дальше", text: "Расставляем действия по приоритету, чтобы команда не исправляла всё подряд." },
];
---

<section id="result" class="section section--grey audit-outcome" aria-labelledby="outcome-title">
  <div class="section__inner page-container">
    <header class="audit-outcome__intro" data-reveal>
      <p class="section__eyebrow">Результат аудита</p>
      <h2 id="outcome-title" class="section__title">После проверки у вас остаётся ясный план, а не ещё одна папка документов</h2>
      <p class="section__lead">Итоговый материал помогает принять решение: что исправить своими силами, где нужна экспертная помощь и к чему можно не возвращаться.</p>
    </header>

    <ol class="audit-outcome__list" data-reveal>
      {outcomes.map((item, index) => (
        <li><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>
      ))}
    </ol>

    <div class="audit-outcome__bottom" data-reveal>
      <p><span>Главный итог</span><strong>Руководитель понимает реальное состояние готовности и последовательность следующих шагов.</strong></p>
      <a href="#contact" data-contact-context="Аудит готовности: результат и состав отчёта">Уточнить состав результата <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .audit-outcome .section__inner,.audit-outcome__intro,.audit-outcome__list{display:grid}.audit-outcome .section__inner{gap:clamp(2.5rem,5vw,4.5rem)}.audit-outcome__intro{grid-template-columns:minmax(0,1.2fr) minmax(18rem,.7fr);gap:.85rem clamp(2rem,7vw,8rem);align-items:end}.audit-outcome__intro .section__eyebrow{grid-column:1/-1}.audit-outcome__intro .section__title,.audit-outcome__intro .section__lead{margin:0}.audit-outcome__intro .section__title{max-width:18ch}
  .audit-outcome__list{grid-template-columns:repeat(2,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-border);border-left:1px solid var(--lrqa-border)}.audit-outcome__list li{display:grid;grid-template-columns:2.5rem 1fr;gap:1rem;min-height:11rem;padding:clamp(1.25rem,2.4vw,2rem);background:var(--lrqa-white);border-right:1px solid var(--lrqa-border);border-bottom:1px solid var(--lrqa-border)}.audit-outcome__list li>span{color:var(--lrqa-muted);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.audit-outcome__list li div{display:grid;align-content:start;gap:.55rem}.audit-outcome__list h3,.audit-outcome__list p{margin:0}.audit-outcome__list h3{color:var(--lrqa-navy);font-size:clamp(1.15rem,.65vw + 1rem,1.55rem)}.audit-outcome__list p{max-width:33rem;color:var(--lrqa-muted);font-size:.95rem;line-height:1.55}
  .audit-outcome__bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding-top:1.5rem;border-top:3px solid var(--lrqa-navy)}.audit-outcome__bottom p{display:grid;gap:.45rem;max-width:54rem;margin:0}.audit-outcome__bottom p span{color:var(--lrqa-muted);font-size:var(--font-size-2xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.audit-outcome__bottom p strong{color:var(--lrqa-navy);font-size:clamp(1.25rem,1vw + 1rem,2rem);line-height:1.28}.audit-outcome__bottom a{display:inline-flex;gap:.7rem;color:var(--lrqa-navy);font-weight:var(--font-weight-semibold);text-decoration:none;border-bottom:1px solid var(--lrqa-border)}.audit-outcome__bottom a span{color:var(--color-accent-strong)}
  @media(max-width:64rem){.audit-outcome__intro,.audit-outcome__bottom{grid-template-columns:1fr}.audit-outcome__bottom a{width:fit-content}}
  @media(max-width:47.99rem){.audit-outcome__list{grid-template-columns:1fr}.audit-outcome__list li{min-height:0}.audit-outcome__intro .section__title{max-width:none}}
</style>

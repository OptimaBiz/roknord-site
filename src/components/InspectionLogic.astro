---
import { homepageContent, type SiteLocale } from "../data/homepage";
type Props = { locale?: SiteLocale };
const { locale = "ru" } = Astro.props as Props;
const content = homepageContent[locale].outcome;
const example = locale === "en" ? {
  eyebrow: "Illustrative example · not a client report",
  title: "From a recorded observation to a verifiable action",
  note: "In a training sample, a work record names a person whose method authorisation could not be traced in the documents provided. Missing evidence in a sample does not itself prove a lack of competence.",
  entries: [
    ["Observation", "A method authorisation record is not found in the provided register."],
    ["Risk", "Available materials do not yet establish the basis of the authorisation."],
    ["Next step", "Check source evidence and update the register where justified."],
  ],
  link: "Read the worked example (in Russian)",
} : {
  eyebrow: "Учебный пример · не клиентский отчёт",
  title: "От наблюдения — к проверяемому действию",
  note: "В учебной выборке указан исполнитель, но в представленных документах не найдено подтверждение допуска к методу. Само по себе отсутствие записи в выборке не доказывает отсутствие компетентности.",
  entries: [
    ["Наблюдение", "В представленном реестре не найдено подтверждение допуска."],
    ["Риск", "На доступных материалах основание допуска пока не прослеживается."],
    ["Действие", "Проверить исходные подтверждения и актуальность реестра."],
  ],
  link: "Посмотреть полный учебный пример",
};
---

<section id="result" class="section section--grey audit-outcome" aria-labelledby="outcome-title">
  <div class="section__inner page-container">
    <header class="audit-outcome__intro" data-reveal>
      <p class="section__eyebrow">{content.eyebrow}</p>
      <h2 id="outcome-title" class="section__title">{content.title}</h2>
      <p class="section__lead">{content.lead}</p>
    </header>

    <ol class="audit-outcome__list" data-reveal>
      {content.items.map((item, index) => (
        <li><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>
      ))}
    </ol>

    <aside class="audit-outcome__sample" aria-label={example.eyebrow} data-reveal>
      <div class="audit-outcome__sample-copy">
        <p class="audit-outcome__sample-label">{example.eyebrow}</p>
        <h3>{example.title}</h3>
        <p>{example.note}</p>
        <a href="/materials/audit-report-example/">{example.link} <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="audit-outcome__sample-steps">
        {example.entries.map(([term, description]) => (
          <div><dt>{term}</dt><dd>{description}</dd></div>
        ))}
      </dl>
    </aside>

    <div class="audit-outcome__bottom" data-reveal>
      <p><span>{content.resultLabel}</span><strong>{content.result}</strong></p>
      <a href="#contact" data-contact-context={content.context}>{content.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .audit-outcome .section__inner,.audit-outcome__intro,.audit-outcome__list{display:grid}.audit-outcome .section__inner{gap:clamp(2.5rem,5vw,4.5rem)}.audit-outcome__intro{grid-template-columns:minmax(0,1.2fr) minmax(18rem,.7fr);gap:.85rem clamp(2rem,7vw,8rem);align-items:end}.audit-outcome__intro .section__eyebrow{grid-column:1/-1}.audit-outcome__intro .section__title,.audit-outcome__intro .section__lead{margin:0}.audit-outcome__intro .section__title{max-width:18ch}
  .audit-outcome__list{grid-template-columns:repeat(2,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-border);border-left:1px solid var(--lrqa-border)}.audit-outcome__list li{display:grid;grid-template-columns:2.5rem 1fr;gap:1rem;min-height:11rem;padding:clamp(1.25rem,2.4vw,2rem);background:var(--lrqa-white);border-right:1px solid var(--lrqa-border);border-bottom:1px solid var(--lrqa-border)}.audit-outcome__list li>span{color:var(--lrqa-muted);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.audit-outcome__list li div{display:grid;align-content:start;gap:.55rem}.audit-outcome__list h3,.audit-outcome__list p{margin:0}.audit-outcome__list h3{color:var(--lrqa-navy);font-size:clamp(1.15rem,.65vw + 1rem,1.55rem)}.audit-outcome__list p{max-width:33rem;color:var(--lrqa-muted);font-size:.95rem;line-height:1.55}
  .audit-outcome__bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding-top:1.5rem;border-top:3px solid var(--lrqa-navy)}.audit-outcome__bottom p{display:grid;gap:.45rem;max-width:54rem;margin:0}.audit-outcome__bottom p span{color:var(--lrqa-muted);font-size:var(--font-size-2xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.audit-outcome__bottom p strong{color:var(--lrqa-navy);font-size:clamp(1.25rem,1vw + 1rem,2rem);line-height:1.28}.audit-outcome__bottom a{display:inline-flex;gap:.7rem;color:var(--lrqa-navy);font-weight:var(--font-weight-semibold);text-decoration:none;border-bottom:1px solid var(--lrqa-border)}.audit-outcome__bottom a span{color:var(--color-accent-strong)}
  .audit-outcome__sample{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(1.25rem,4vw,4.5rem);padding:clamp(1.4rem,3vw,2.6rem);background:var(--lrqa-navy);color:var(--lrqa-white);border-top:4px solid var(--color-mint-action)}
  .audit-outcome__sample-copy{display:grid;align-content:start;gap:clamp(.75rem,1.5vw,1rem)}
  .audit-outcome__sample-label{margin:0;color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .audit-outcome__sample h3{margin:0;font-size:clamp(1.5rem,1.5vw + 1rem,2.5rem);font-weight:var(--font-weight-semibold);letter-spacing:-.035em;line-height:1.14}
  .audit-outcome__sample-copy>p:not(.audit-outcome__sample-label){max-width:39rem;margin:0;color:var(--lrqa-border-soft);line-height:1.65}
  .audit-outcome__sample-copy>a{justify-self:start;margin-top:.5rem;padding-bottom:.3rem;color:var(--color-mint-action);font-weight:var(--font-weight-semibold);text-decoration:none;border-bottom:1px solid currentColor}
  .audit-outcome__sample-copy>a:focus-visible{outline:var(--focus-outline-width) solid var(--color-mint-action);outline-offset:var(--focus-outline-offset)}
  .audit-outcome__sample-steps{display:grid;align-content:start;gap:0;margin:0}
  .audit-outcome__sample-steps>div{display:grid;grid-template-columns:6.8rem minmax(0,1fr);gap:1.1rem;padding:1rem 0;border-bottom:1px solid var(--lrqa-dark-border)}
  .audit-outcome__sample-steps>div:first-child{border-top:1px solid var(--lrqa-dark-border)}
  .audit-outcome__sample-steps dt{color:var(--color-mint-action);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold)}
  .audit-outcome__sample-steps dd{margin:0;color:var(--lrqa-white);font-size:var(--font-size-sm);line-height:1.55}
  @media(max-width:64rem){.audit-outcome__sample{grid-template-columns:1fr}.audit-outcome__intro,.audit-outcome__bottom{grid-template-columns:1fr}.audit-outcome__bottom a{width:fit-content}}
  @media(max-width:47.99rem){.audit-outcome__sample-steps>div{grid-template-columns:1fr;gap:.3rem}.audit-outcome__list{grid-template-columns:1fr}.audit-outcome__list li{min-height:0}.audit-outcome__intro .section__title{max-width:none}}
</style>

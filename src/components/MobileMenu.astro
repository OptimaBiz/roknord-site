---
import { audienceLinks, type NavItem } from '../data/siteNavigation';
type Props = { serviceLinks: NavItem[]; sectionLinks: NavItem[]; utilityLinks: NavItem[] };
const { serviceLinks, sectionLinks, utilityLinks } = Astro.props;
const current = (href: string) => Astro.url.pathname === href ? 'page' as const : undefined;
const companyLinks = utilityLinks.filter(item => !['/account/', '/contacts/'].includes(item.href));
---

<details class="mobile-menu">
  <summary aria-label="Открыть меню" aria-controls="mobile-drawer" aria-expanded="false">
    <span class="mobile-menu__icon" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="mobile-menu__label">Меню</span>
  </summary>
  <div class="mobile-menu-panel" id="mobile-drawer">
    <div class="mobile-menu-content">
      <a class="mobile-menu-account" href="/account/" aria-current={current('/account/')}>
        <span><strong>Личный кабинет</strong><small>Договор, документы и ход работ</small></span>
        <span class="mobile-menu-arrow--external" aria-hidden="true">→</span>
      </a>
      <nav aria-label="Мобильное меню">
        <div class="mobile-menu-resources">
          {sectionLinks.map(item => <a href={item.href} aria-current={current(item.href)}>{item.label}<span class:list={[{ 'mobile-menu-arrow--external': item.href.startsWith('https:') }]} aria-hidden="true">→</span></a>)}
        </div>
        <details class="mobile-menu-group">
          <summary aria-controls="mobile-services"><span>Услуги<small>Подготовка, аудит и корректирующие действия</small></span></summary>
          <div class="mobile-menu-group__links" id="mobile-services">
            {serviceLinks.map(item => <a href={item.href} aria-current={current(item.href)}>{item.label}<span aria-hidden="true">→</span></a>)}
            <div class="mobile-menu-specialties">
              <a href="/occupational-safety/" aria-current={current('/occupational-safety/')}>Охрана труда<span aria-hidden="true">→</span></a>
              <a href="/152-fz/" aria-current={current('/152-fz/')}>Услуги по 152-ФЗ<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </details>
        <details class="mobile-menu-group">
          <summary aria-controls="mobile-audiences"><span>Кому помогаем<small>Выберите направление вашей организации</small></span></summary>
          <div class="mobile-menu-group__links" id="mobile-audiences">
            {audienceLinks.map(item => <a href={item.href} aria-current={current(item.href)}>{item.label}<span aria-hidden="true">→</span></a>)}
          </div>
        </details>
        <div class="mobile-menu-company" aria-label="Компания">
          {companyLinks.map(item => <a href={item.href} aria-current={current(item.href)}>{item.label}{item.href.startsWith('mailto:') && <span class="mobile-menu-link-note">Написать на почту</span>}</a>)}
        </div>
      </nav>
    </div>
    <div class="mobile-menu-actions">
      <div class="mobile-menu-contact">
        <a href="tel:+78123898178">+7 (812) 389-81-78</a>
        <a href="/contacts/" aria-current={current('/contacts/')}>Контакты <span aria-hidden="true">→</span></a>
      </div>
      <a class="service-cta cta-angled mobile-menu-cta motion-control" href="/#contact">Разобрать задачу <span aria-hidden="true">→</span></a>
    </div>
  </div>
</details>

---
type NavItem = { label: string; href: string; isLogin?: boolean };
type Props = { serviceLinks: NavItem[]; audienceLinks: NavItem[]; sectionLinks: NavItem[]; utilityLinks: NavItem[] };
const { serviceLinks, audienceLinks, sectionLinks, utilityLinks } = Astro.props;
---

<details class="mobile-menu">
  <summary aria-label="Открыть меню" aria-controls="mobile-drawer" aria-expanded="false">
    <span class="mobile-menu__icon" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="mobile-menu__label">Меню</span>
  </summary>
  <nav class="mobile-menu-panel" id="mobile-drawer" aria-label="Мобильное меню">
    <details class="mobile-menu-group mobile-menu-group--primary">
      <summary>Услуги</summary>
      <div class="mobile-menu-group__links mobile-menu-service-groups">
        <details class="mobile-menu-subgroup">
          <summary>Росаккредитация (ФСА)</summary>
          <div class="mobile-menu-subgroup__links">
            {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>
        <a class="mobile-menu-service-link" href="/occupational-safety/">Охрана труда</a>
        <a class="mobile-menu-service-link" href="/152-fz/">Услуги по 152-ФЗ</a>
      </div>
    </details>
    <details class="mobile-menu-group mobile-menu-group--primary">
      <summary>Кому помогаем</summary>
      <div class="mobile-menu-group__links">
        {audienceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </details>
    {sectionLinks.map((item) => <a class="mobile-menu-primary-link" href={item.href}>{item.label}</a>)}
    <details class="mobile-menu-group mobile-menu-group--company">
      <summary>Компания</summary>
      <div class="mobile-menu-group__links">
        {utilityLinks.map((item) => item.isLogin ? <a href={item.href} data-login-trigger>{item.label}</a> : <a href={item.href}>{item.label}</a>)}
      </div>
    </details>
    <a class="service-cta cta-angled mobile-menu-cta motion-control" href="/#contact">Разобрать задачу</a>
  </nav>
</details>

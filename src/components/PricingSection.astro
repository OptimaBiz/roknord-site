---
const included = [
  "Предварительный анализ документов",
  "Проверка одной площадки",
  "Итоговый отчёт и разбор результатов",
];

const formats = [
  { kicker: "Когда нужен единый контур подготовки", name: "Полный комплекс" },
  { kicker: "Когда задача уже локализована", name: "Точечный блок" },
  { kicker: "Когда готовность важно поддерживать", name: "Периодический аудит" },
];
---

<section id="pricing" class="section section--light formats-section" aria-labelledby="formats-title">
  <div class="section__inner page-container">
    <header class="formats-intro" data-reveal>
      <p class="section__eyebrow">Первый этап</p>
      <h2 id="formats-title" class="section__title">Стоимость аудита готовности</h2>
      <p class="section__lead">Начинаем с проверки текущего состояния. Дальнейшие работы заказчик выбирает после получения результатов.</p>
    </header>

    <article class="pricing-start" aria-labelledby="pricing-start-title" data-reveal>
      <div class="pricing-start__main">
        <span class="pricing-start__badge">Базовый формат</span>
        <h3 id="pricing-start-title">Независимый аудит готовности</h3>
        <p>Ведущий аудитор анализирует документы, проводит проверку на площадке и готовит материалы с приоритетами дальнейших действий.</p>

        <ul class="pricing-start__included" aria-label="Что входит в базовый формат">
          {included.map((item, index) => <li><span aria-hidden="true">0{index + 1}</span><strong>{item}</strong></li>)}
        </ul>
      </div>

      <aside class="pricing-start__offer" aria-label="Стоимость и срок независимого аудита готовности">
        <dl class="pricing-start__facts">
          <div>
            <dt>Стоимость</dt>
            <dd><span class="pricing-start__from">от</span><strong>150 000 ₽</strong><span>с НДС</span></dd>
          </div>
          <div>
            <dt>Срок</dt>
            <dd><strong>5–10</strong><span>рабочих дней</span></dd>
          </div>
        </dl>
        <a class="pricing-start__cta cta-angled motion-control" href="#contact" data-contact-context="Независимый аудит готовности: объём и стоимость"><span>Обсудить объём аудита</span><span aria-hidden="true">→</span></a>
      </aside>

      <p class="pricing-start__note">Один ведущий аудитор, одна площадка и один рабочий день выездной проверки. Транспортные расходы оплачиваются дополнительно. Дополнительных специалистов и их стоимость согласовываем до начала работ.</p>
    </article>

    <div class="formats-after" data-reveal>
      <header>
        <p>После аудита</p>
        <h3>Только необходимый объём сопровождения</h3>
        <span>Формат выбираем по выявленным рискам и фиксируем до начала работ.</span>
      </header>

      <ol aria-label="Сценарии дальнейшей работы">
        {formats.map((format, index) => (
          <li>
            <span aria-hidden="true">0{index + 1}</span>
            <div><small>{format.kicker}</small><strong>{format.name}</strong></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .formats-section .section__inner,
  .formats-intro,
  .pricing-start,
  .pricing-start__main,
  .pricing-start__offer,
  .pricing-start__included,
  .formats-after,
  .formats-after header,
  .formats-after ol,
  .formats-after li,
  .formats-after li div {
    display: grid;
  }

  .formats-section .section__inner {
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .formats-intro {
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 0.75rem clamp(2rem, 6vw, 6.5rem);
    align-items: end;
  }

  .formats-intro .section__eyebrow {
    grid-column: 1 / -1;
  }

  .formats-intro .section__title,
  .formats-intro .section__lead,
  .pricing-start h3,
  .pricing-start p,
  .pricing-start dl,
  .pricing-start dd,
  .pricing-start__included,
  .formats-after h3,
  .formats-after p,
  .formats-after ol {
    margin: 0;
  }

  .pricing-start {
    grid-template-columns: minmax(0, 1.45fr) minmax(19rem, 0.7fr);
    color: var(--lrqa-white);
    background: var(--lrqa-navy);
    border-top: 4px solid var(--color-mint-action);
  }

  .pricing-start__main {
    align-content: start;
    gap: 0.85rem;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    border-right: 1px solid var(--lrqa-dark-border);
  }

  .pricing-start__badge,
  .pricing-start__included span,
  .pricing-start__facts dt,
  .formats-after header > p,
  .formats-after li > span,
  .formats-after small {
    font-size: var(--font-size-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .pricing-start__badge,
  .pricing-start__included span,
  .formats-after li > span {
    color: var(--color-mint-action);
  }

  .pricing-start h3 {
    font-size: clamp(2rem, 2vw + 1rem, 3.25rem);
    line-height: 1;
  }

  .pricing-start__main > p {
    max-width: 42rem;
    color: var(--lrqa-border);
    line-height: 1.65;
  }

  .pricing-start__included {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--lrqa-dark-border);
    border-left: 1px solid var(--lrqa-dark-border);
  }

  .pricing-start__included li {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1rem;
    border-right: 1px solid var(--lrqa-dark-border);
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .pricing-start__included strong {
    font-size: var(--font-size-sm);
    line-height: 1.45;
  }

  .pricing-start__offer {
    align-content: space-between;
    gap: 1.75rem;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    background: var(--lrqa-navy-2);
  }

  .pricing-start__facts {
    display: grid;
    gap: 1.5rem;
  }

  .pricing-start__facts > div + div {
    padding-top: 1.5rem;
    border-top: 1px solid var(--lrqa-dark-border);
  }

  .pricing-start__facts dt {
    color: var(--lrqa-muted-2);
  }

  .pricing-start__facts dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .pricing-start__facts dd strong {
    font-size: clamp(1.7rem, 1.5vw + 1rem, 2.4rem);
    line-height: 1.06;
    white-space: nowrap;
  }

  .pricing-start__facts dd span {
    color: var(--lrqa-border);
    font-size: var(--font-size-sm);
  }

  .pricing-start__from {
    color: var(--lrqa-border-soft) !important;
    font-size: var(--font-size-lg) !important;
    font-weight: var(--font-weight-semibold);
  }

  .pricing-start__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--cta-padding-y) calc(var(--cta-padding-x) + var(--button-bevel) * 0.5);
    color: var(--lrqa-black);
    background: var(--gradient-button-primary);
    font-weight: var(--button-font-weight);
    text-decoration: none;
  }

  .pricing-start__note {
    grid-column: 1 / -1;
    padding: 1rem clamp(1.75rem, 3.5vw, 3rem);
    color: var(--lrqa-border);
    font-size: var(--font-size-sm);
    line-height: 1.55;
    border-top: 1px solid var(--lrqa-dark-border);
  }

  .formats-after {
    grid-template-columns: minmax(16rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .formats-after header {
    gap: 0.55rem;
  }

  .formats-after header > p,
  .formats-after small {
    color: var(--lrqa-muted);
  }

  .formats-after h3 {
    font-size: clamp(1.35rem, 1vw + 1rem, 2rem);
    line-height: 1.12;
  }

  .formats-after header > span {
    color: var(--lrqa-muted);
    line-height: 1.55;
  }

  .formats-after ol {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--lrqa-border);
  }

  .formats-after li {
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--lrqa-border-soft);
  }

  .formats-after li div {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
  }

  .formats-after strong {
    font-size: var(--font-size-lg);
  }

  @media (max-width: 64rem) {
    .formats-intro,
    .pricing-start,
    .formats-after {
      grid-template-columns: 1fr;
    }

    .pricing-start__main {
      border-right: 0;
      border-bottom: 1px solid var(--lrqa-dark-border);
    }

    .pricing-start__offer {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.8fr);
      align-items: end;
    }

    .pricing-start__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pricing-start__facts > div + div {
      padding-top: 0;
      padding-left: 1.5rem;
      border-top: 0;
      border-left: 1px solid var(--lrqa-dark-border);
    }
  }

  @media (max-width: 48rem) {
    .pricing-start__main,
    .pricing-start__offer {
      padding: 1.35rem;
    }

    .pricing-start__included {
      grid-template-columns: 1fr;
    }

    .pricing-start__included li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .pricing-start__offer,
    .pricing-start__facts {
      grid-template-columns: 1fr;
    }

    .pricing-start__facts > div + div {
      padding-top: 1.1rem;
      padding-left: 0;
      border-top: 1px solid var(--lrqa-dark-border);
      border-left: 0;
    }

    .pricing-start__note {
      padding: 1rem 1.35rem;
    }

    .formats-after li div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

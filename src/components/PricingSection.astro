---
const formats = [
  {
    name: "Точечная задача",
    lead: "Когда нужно проверить отдельный блок, разобраться с замечаниями или актуализировать область.",
    items: ["Чёткие границы работы", "Письменный результат", "Рекомендации по следующим шагам"],
  },
  {
    name: "Полное сопровождение",
    lead: "Когда нужна подготовка организации и команды к процедуре от диагностики до контрольной проверки.",
    items: ["Независимый аудит", "План и внедрение изменений", "Подготовка команды", "Сопровождение ключевых этапов"],
    featured: true,
  },
  {
    name: "Постоянная поддержка",
    lead: "Когда внутренней функции качества нужна регулярная экспертная опора между процедурами.",
    items: ["Контроль изменений", "Поддержка СМК и записей", "Календарь рисков", "Подготовка к очередным процедурам"],
  },
];
---

<section id="pricing" class="section section--light formats-section" aria-labelledby="formats-title">
  <div class="section__inner page-container">
    <header class="formats-intro">
      <p class="section__eyebrow">Форматы работы</p>
      <h2 id="formats-title" class="section__title">Подключаемся ровно настолько, насколько нужно вашей команде</h2>
      <p class="section__lead">Не продаём одинаковый пакет всем. Объём зависит от процедуры, состояния системы, сроков и того, что команда может сделать самостоятельно.</p>
    </header>

    <div class="formats-grid">
      {formats.map((format) => (
        <article class:list={["format-card", format.featured && "format-card--featured"]}>
          {format.featured && <span class="format-card__badge">Основной формат</span>}
          <h3>{format.name}</h3>
          <p>{format.lead}</p>
          <ul>{format.items.map((item) => <li>{item}</li>)}</ul>
          <a href="#contact"><span>Обсудить формат</span><span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <div class="formats-note">
      <strong>Стоимость определяем после короткого разбора.</strong>
      <p>На неё влияют тип аккредитованного лица, размер области, количество площадок, состояние документов и срок до процедуры. До начала работ фиксируем состав, результат и цену.</p>
    </div>
  </div>
</section>

<style>
  .formats-section .section__inner,.formats-intro,.format-card{display:grid}.formats-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}.formats-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.formats-intro .section__eyebrow{grid-column:1/-1}.formats-intro .section__title,.formats-intro .section__lead{margin:0}
  .formats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.format-card{grid-template-rows:auto auto 1fr auto;gap:1.35rem;padding:clamp(1.5rem,3vw,2.8rem);background:var(--lrqa-white);border:1px solid var(--lrqa-border-soft)}.format-card--featured{color:var(--lrqa-white);background:var(--lrqa-navy);border-color:var(--lrqa-navy);border-top:4px solid var(--color-mint-action)}.format-card__badge{width:fit-content;color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.format-card h3,.format-card p,.formats-note strong,.formats-note p{margin:0}.format-card h3{font-size:clamp(1.4rem,1.3vw + 1rem,2.3rem);line-height:1.08}.format-card p{color:var(--lrqa-muted);line-height:var(--line-height-relaxed)}.format-card--featured p{color:var(--lrqa-border-soft)}.format-card ul{display:grid;align-content:start;gap:.75rem;margin:0;padding:1.25rem 0 0;list-style:none;border-top:1px solid var(--lrqa-border-soft)}.format-card--featured ul{border-color:var(--lrqa-dark-border)}.format-card li{position:relative;padding-left:1.2rem;color:var(--lrqa-muted-dark);line-height:1.45}.format-card--featured li{color:var(--lrqa-border-soft)}.format-card li::before{content:"";position:absolute;top:.6em;left:0;width:.38rem;height:.38rem;background:var(--color-mint-action)}.format-card a{display:inline-flex;justify-content:space-between;gap:1rem;padding-top:1.2rem;color:var(--lrqa-black);border-top:1px solid var(--lrqa-border-soft);font-weight:var(--font-weight-semibold);text-decoration:none}.format-card--featured a{color:var(--lrqa-white);border-color:var(--lrqa-dark-border)}.format-card a span:last-child{color:var(--color-mint-action)}
  .formats-note{display:grid;grid-template-columns:minmax(16rem,.58fr) minmax(0,1.42fr);gap:1rem clamp(2rem,5vw,5rem);padding-top:1.5rem;border-top:1px solid var(--lrqa-border)}.formats-note p{color:var(--lrqa-muted);line-height:var(--line-height-relaxed)}
  @media(max-width:64rem){.formats-intro,.formats-note{grid-template-columns:1fr}.formats-grid{grid-template-columns:1fr 1fr}.format-card--featured{grid-row:1/span 2}}@media(max-width:48rem){.formats-grid{grid-template-columns:1fr}.format-card--featured{grid-row:auto}}
</style>

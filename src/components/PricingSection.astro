---
import type { SiteLocale } from "../data/homepage";
type Props = { locale?: SiteLocale };
const { locale = "ru" } = Astro.props as Props;
const en = locale === "en";
const copy = en ? {
  eyebrow: "Engagement options", title: "Choose the required preparation scope", lead: "The independent audit may be a standalone review or the first stage of comprehensive preparation. Scope, timeframe and budget are fixed in the proposal and contract.",
  recommended: "Recommended", forWhom: "For", included: "Included", duration: "Timeframe", cost: "Cost",
  note: "When a comprehensive preparation agreement is signed, the independent audit fee is credited towards the total contract value.",
  plans: [
    { title:"Independent readiness audit", audience:"For teams that need an independent review and a prioritised risk map.", included:["Scope, records and actual-practice review","Management-system review","Report, risk map and action plan"], duration:"5–10 working days", cost:"from RUB 100,000 + 22% VAT", cta:"Order an audit", context:"Independent readiness audit", featured:false },
    { title:"Comprehensive accreditation / competence confirmation preparation", audience:"For organisations that need one coordinated preparation programme and evidence package.", included:["Full readiness audit and scope update","Management system and records setup","Corrective action and procedure support"], duration:"from 30 working days", cost:"Calculated against the scope", cta:"Request a comprehensive estimate", context:"Comprehensive procedure preparation", featured:true },
    { title:"Nonconformity and management-system corrective action", audience:"For organisations that have received an assessment report with nonconformities.", included:["Assessment-report and cause review","Supporting evidence preparation","Corrective-action submission package"], duration:"from 10 working days", cost:"from RUB 150,000 + 22% VAT", cta:"Review nonconformities", context:"Corrective action after nonconformities", featured:false },
  ],
} : {
  eyebrow: "Форматы работы", title: "Выберите необходимый объём подготовки", lead: "Независимый аудит может быть отдельной проверкой или первым этапом комплексной подготовки. Состав, сроки и бюджет фиксируем в предложении и договоре.",
  recommended: "Рекомендуемый формат", forWhom: "Для кого", included: "Что входит", duration: "Срок", cost: "Стоимость",
  note: "При заключении договора на комплексную подготовку стоимость независимого аудита засчитывается в общую смету договора.",
  plans: [
    { title:"Независимый аудит готовности", audience:"Командам, которым нужен независимый срез и приоритетная карта рисков.", included:["Проверка области, записей и практики","Анализ СМК","Отчёт, карта рисков и план действий"], duration:"5–10 рабочих дней", cost:"от 100 000 ₽ + НДС 22%", cta:"Заказать аудит", context:"Независимый аудит готовности", featured:false },
    { title:"Комплексная подготовка к аккредитации / ПК", audience:"Организациям, которым нужна единая программа подготовки и пакет доказательств.", included:["Полный аудит и актуализация области","Настройка СМК и архива записей","Корректирующие действия и сопровождение"], duration:"от 30 рабочих дней", cost:"расчёт по ТЗ и области", cta:"Запросить расчёт под ключ", context:"Комплексная подготовка к аккредитации или ПК", featured:true },
    { title:"Устранение несоответствий и СМК", audience:"Организациям, получившим акт с несоответствиями по результатам оценки.", included:["Разбор акта и причин расхождений","Подготовка доказательств","Пакет корректирующих действий для ФСА"], duration:"от 10 рабочих дней", cost:"от 150 000 ₽ + НДС 22%", cta:"Разобрать несоответствия", context:"Устранение несоответствий", featured:false },
  ],
};
---

<section id="pricing" class="section section--light pricing-matrix" aria-labelledby="pricing-title">
  <div class="section__inner page-container">
    <header class="pricing-matrix__intro" data-reveal><p class="section__eyebrow">{copy.eyebrow}</p><h2 id="pricing-title" class="section__title">{copy.title}</h2><p class="section__lead">{copy.lead}</p></header>
    <div class="pricing-matrix__grid">
      {copy.plans.map((plan) => (
        <article class:list={["pricing-plan", plan.featured && "pricing-plan--featured"]} data-reveal>
          {plan.featured && <p class="pricing-plan__badge">{copy.recommended}</p>}
          <h3>{plan.title}</h3>
          <dl><div><dt>{copy.duration}</dt><dd>{plan.duration}</dd></div><div><dt>{copy.cost}</dt><dd>{plan.cost}</dd></div></dl>
          <div class="pricing-plan__audience"><strong>{copy.forWhom}</strong><p>{plan.audience}</p></div>
          <div class="pricing-plan__included"><strong>{copy.included}</strong><ul>{plan.included.map((item) => <li>{item}</li>)}</ul></div>
          <a class:list={["pricing-plan__cta", plan.featured && "cta-angled"]} href="#contact" data-contact-context={plan.context}>{plan.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <p class="pricing-matrix__note" data-reveal>{copy.note}</p>
  </div>
</section>

<style>
  .pricing-matrix .section__inner,.pricing-matrix__intro{display:grid}.pricing-matrix .section__inner{gap:clamp(2rem,4.5vw,4rem)}.pricing-matrix__intro{grid-template-columns:minmax(0,1fr) minmax(18rem,.7fr);gap:.8rem clamp(2rem,7vw,7rem);align-items:end}.pricing-matrix__intro .section__eyebrow{grid-column:1/-1}.pricing-matrix__intro h2,.pricing-matrix__intro p{margin:0}.pricing-matrix__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch;border-top:1px solid var(--lrqa-border);border-left:1px solid var(--lrqa-border)}
  .pricing-plan{position:relative;display:grid;grid-template-rows:auto auto auto auto 1fr auto;gap:1.05rem;min-width:0;padding:clamp(1.35rem,2.1vw,2rem);background:var(--lrqa-white);border-right:1px solid var(--lrqa-border);border-bottom:1px solid var(--lrqa-border)}.pricing-plan--featured{color:var(--lrqa-white);background:var(--lrqa-navy);border-top:5px solid var(--color-mint-action);padding-top:calc(clamp(1.35rem,2.1vw,2rem) - 5px)}.pricing-plan__badge{margin:0;color:var(--color-mint-action);font-size:var(--font-size-2xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.pricing-plan:not(.pricing-plan--featured) .pricing-plan__badge{display:none}.pricing-plan h3,.pricing-plan p,.pricing-plan ul,.pricing-plan dl,.pricing-plan dd{margin:0}.pricing-plan h3{color:var(--lrqa-navy);font-size:clamp(1.45rem,1.15vw + 1rem,2.25rem);line-height:1.08}.pricing-plan--featured h3{color:var(--lrqa-white)}.pricing-plan__audience,.pricing-plan__included{display:grid;align-content:start;gap:.5rem}.pricing-plan__audience>strong,.pricing-plan__included>strong,.pricing-plan dt{color:var(--lrqa-muted);font-size:var(--font-size-2xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.pricing-plan--featured .pricing-plan__audience>strong,.pricing-plan--featured .pricing-plan__included>strong,.pricing-plan--featured dt{color:var(--lrqa-muted-2)}.pricing-plan__audience p,.pricing-plan li,.pricing-plan dd{font-size:.93rem;line-height:1.5}.pricing-plan--featured .pricing-plan__audience p,.pricing-plan--featured li,.pricing-plan--featured dd{color:var(--lrqa-border-soft)}.pricing-plan ul{display:grid;gap:.45rem;padding:0;list-style:none}.pricing-plan li{position:relative;padding-left:1rem}.pricing-plan li::before{content:"";position:absolute;top:.65em;left:0;width:.38rem;height:.38rem;background:var(--color-mint-action)}.pricing-plan dl{display:grid;grid-template-columns:.75fr 1.25fr;gap:.8rem;padding:.9rem 0;border-top:1px solid var(--lrqa-border-soft);border-bottom:1px solid var(--lrqa-border-soft)}.pricing-plan--featured dl{border-color:var(--lrqa-dark-border)}.pricing-plan dl>div{display:grid;align-content:start;gap:.25rem}.pricing-plan dd{font-weight:var(--font-weight-semibold)}.pricing-plan__cta{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.25rem;padding:.85rem 0;color:var(--lrqa-navy);font-weight:var(--font-weight-bold);text-decoration:none;border-top:2px solid var(--lrqa-navy)}.pricing-plan--featured .pricing-plan__cta{padding:.85rem 1.3rem;color:var(--lrqa-black);background:var(--gradient-button-primary);border:0}.pricing-plan__cta span{color:var(--color-accent-strong)}.pricing-matrix__note{margin:0;padding:1rem 1.25rem;color:var(--lrqa-navy);font-weight:var(--font-weight-semibold);line-height:1.5;border-left:4px solid var(--color-mint-action);background:var(--lrqa-card-light)}
  @media(max-width:70rem){.pricing-matrix__grid{grid-template-columns:1fr}.pricing-plan{grid-template-rows:auto;}.pricing-plan--featured{order:-1}}
  @media(max-width:64rem){.pricing-matrix__intro{grid-template-columns:1fr}}
</style>

---
const packages = [
  {
    name: "Первичный аудит готовности",
    price: "150 000 ₽",
    priceNote: "с НДС",
    lead: "Подходит, когда нужно быстро понять реальное состояние подготовки и определить приоритеты.",
    deliverables: ["Карта рисков по документам, области и практике", "Замечания к критичным несогласованностям", "План первоочередных корректирующих действий"],
    featured: true,
  },
  {
    name: "Сопровождение подготовки",
    price: "По запросу",
    priceNote: "после оценки объёма",
    lead: "Подходит, когда после аудита требуется помощь с внедрением изменений и контрольной проверкой.",
    deliverables: ["Работа с выбранными блоками СМК и доказательной базы", "Методические рекомендации по корректирующим действиям", "Контроль готовности перед подачей или ВКС"],
    featured: false,
  },
];
---

<section id="pricing" class="pricing-section section section--light" aria-labelledby="pricing-title">
  <div class="section__inner page-container">
    <header class="pricing-intro">
      <p class="section__eyebrow">Стоимость</p>
      <h2 id="pricing-title" class="section__title">Начните с аудита и расширяйте работу только там, где это действительно нужно</h2>
      <p class="section__lead">До оценки материалов не предлагаем лишний объём сопровождения. Сначала фиксируем риски и только затем определяем дальнейшие действия.</p>
    </header>

    <div class="pricing-grid" aria-label="Форматы работы">
      {packages.map((pkg) => (
        <article class:list={["pricing-card", pkg.featured && "pricing-card--featured"]}>
          <div class="pricing-card__header">
            {pkg.featured && <span class="pricing-card__badge">Рекомендуемый старт</span>}
            <h3>{pkg.name}</h3>
            <div class="pricing-card__price"><strong>{pkg.price}</strong><span>{pkg.priceNote}</span></div>
          </div>
          <p class="pricing-card__lead">{pkg.lead}</p>
          <div class="pricing-card__deliverables"><p>Что получите</p><ul>{pkg.deliverables.map((item) => <li>{item}</li>)}</ul></div>
          <a class="pricing-card__cta motion-control" href="#contact"><span>Получить оценку</span><span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <div class="pricing-note"><strong>Что влияет на итоговую стоимость</strong><p>Тип аккредитованного лица, объём области, состояние СМК, количество проверяемых записей и срок до процедуры.</p></div>
  </div>
</section>

<style>
  .pricing-section{border-top:1px solid var(--lrqa-border-soft)}.pricing-section .section__inner,.pricing-intro,.pricing-card,.pricing-card__header,.pricing-card__price,.pricing-card__deliverables,.pricing-note{display:grid}.pricing-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}
  .pricing-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.pricing-intro .section__eyebrow{grid-column:1/-1}.pricing-intro .section__title,.pricing-intro .section__lead,.pricing-card h3,.pricing-card p,.pricing-note strong,.pricing-note p{margin:0}
  .pricing-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.pricing-card{grid-template-rows:auto auto 1fr auto;gap:1.5rem;min-width:0;padding:clamp(1.5rem,3.5vw,3.25rem);background:var(--lrqa-white);border:1px solid var(--lrqa-border-soft)}.pricing-card--featured{color:var(--lrqa-white);background:var(--lrqa-navy);border-color:var(--lrqa-navy);border-top:4px solid var(--color-mint-action)}.pricing-card__header,.pricing-card__price,.pricing-card__deliverables{gap:.75rem}.pricing-card__badge{width:fit-content;color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.pricing-card h3{max-width:20ch;font-size:clamp(1.35rem,1.5vw + 1rem,2.4rem);line-height:1.08;text-wrap:balance}.pricing-card__price strong{font-family:var(--font-family-mono);font-size:clamp(2rem,3vw,3.5rem);line-height:1}.pricing-card__price span,.pricing-card__lead{color:var(--lrqa-muted)}.pricing-card--featured .pricing-card__price span,.pricing-card--featured .pricing-card__lead{color:var(--lrqa-border-soft)}.pricing-card__lead{line-height:var(--line-height-relaxed)}
  .pricing-card__deliverables{align-content:start;padding-top:1.25rem;border-top:1px solid var(--lrqa-border-soft)}.pricing-card--featured .pricing-card__deliverables{border-color:var(--lrqa-dark-border)}.pricing-card__deliverables>p{font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.pricing-card__deliverables ul{display:grid;gap:.75rem;margin:0;padding:0;list-style:none}.pricing-card__deliverables li{position:relative;padding-left:1.25rem;color:var(--lrqa-muted-dark);line-height:1.5}.pricing-card--featured .pricing-card__deliverables li{color:var(--lrqa-border-soft)}.pricing-card__deliverables li::before{content:"";position:absolute;top:.65em;left:0;width:.4rem;height:.4rem;background:var(--color-mint-action)}.pricing-card__cta{display:inline-flex;justify-content:space-between;gap:1rem;padding-top:1.25rem;color:var(--lrqa-black);border-top:1px solid var(--lrqa-border-soft);font-weight:var(--font-weight-semibold);text-decoration:none}.pricing-card--featured .pricing-card__cta{color:var(--lrqa-white);border-color:var(--lrqa-dark-border)}.pricing-card__cta span:last-child{color:var(--color-mint-action);font-size:1.4rem}
  .pricing-note{grid-template-columns:minmax(13rem,.45fr) minmax(0,1.55fr);gap:1rem clamp(2rem,5vw,5rem);padding-top:1.5rem;border-top:1px solid var(--lrqa-border)}.pricing-note p{color:var(--lrqa-muted);line-height:var(--line-height-relaxed)}@media(max-width:64rem){.pricing-intro,.pricing-note{grid-template-columns:1fr}}@media(max-width:48rem){.pricing-grid{grid-template-columns:1fr}}
</style>

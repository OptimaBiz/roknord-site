---
const packages = [
  {
    name: "Первичный аудит",
    price: "150 000 ₽",
    priceNote: "цена с НДС",
    lead: "Для тех, кто хочет быстро понять, где слабые места до процедуры, не тратя время на длинную подготовку.",
    deliverables: [
      "Карта рисков по документам и области",
      "Замечания к области аккредитации",
      "Первичный план корректирующих действий",
    ],
    cta: "Начать",
    href: "#contact",
    featured: false,
  },
  {
    name: "Сопровождение «под ключ»",
    price: "По запросу",
    priceNote: "после оценки объёма",
    lead: "ПК, актуализация области, корректирующие действия, подготовка команды к ВКС.",
    deliverables: [
      "Разбор документов СМК",
      "Методические рекомендации по доказательной базе",
      "Подготовка к ВКС",
    ],
    cta: "Обсудить",
    href: "#contact",
    featured: true,
  },
];

const commonItems = [
  "Конфиденциальность материалов",
  "Независимая экспертная оценка",
  "Работа по актуальным требованиям",
  "Практические рекомендации",
  "Понятная приоритизация рисков",
];
---

<section id="pricing" class="pricing-section section section--light" aria-labelledby="pricing-title">
  <div class="section__inner page-container">
    <div class="pricing-shell">
      <header class="pricing-intro">
        <p class="section__eyebrow">Форматы работы</p>
        <h2 id="pricing-title" class="section__title">
          Выберите уровень экспертного вовлечения — под задачу и ситуацию.
        </h2>
        <p class="section__lead">
          Первичный аудит помогает быстро увидеть слабые места. Сопровождение — выстроить полную доказательную базу и провести команду через процедуру.
        </p>
      </header>

      <div class="pricing-grid" aria-label="Форматы работы">
        {packages.map((pkg) => (
          <article class={`pricing-card${pkg.featured ? " pricing-card--featured" : ""}`}>
            <div class="pricing-card__top">
              {pkg.featured && <span class="pricing-card__badge">Расширенный формат</span>}
              <h3 class="pricing-card__name">{pkg.name}</h3>
              <div class="pricing-card__price">
                <strong>{pkg.price}</strong>
                <span>{pkg.priceNote}</span>
              </div>
            </div>

            <p class="pricing-card__lead">{pkg.lead}</p>

            <div class="pricing-card__deliverables">
              <p class="pricing-card__deliverables-label">Что получите на выходе</p>
              <ul>
                {pkg.deliverables.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            <a class="pricing-card__link" href={pkg.href}>
              <span>{pkg.cta}</span>
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <div class="pricing-common" aria-label="Что входит во все форматы">
        <p class="pricing-common__label">Что входит во все форматы</p>
        <ul class="pricing-common__list">
          {commonItems.map((item) => (
            <li class="pricing-common__item">
              <span class="pricing-common__check" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pricing-cta">
        <p class="pricing-cta__question">Не уверены, какой формат подходит?</p>
        <a class="pricing-cta__btn motion-control" href="#contact">Задать вопрос</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    border-top: 1px solid var(--lrqa-border-soft);
  }

  .pricing-shell,
  .pricing-intro {
    display: grid;
  }

  .pricing-shell {
    gap: clamp(var(--space-9), 5vw, var(--space-12));
  }

  .pricing-intro {
    gap: var(--space-4);
    max-width: 54rem;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .pricing-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-6);
    min-width: 0;
    padding: clamp(var(--space-6), 3vw, var(--space-9));
    border: 1px solid var(--lrqa-border-soft);
    background: var(--lrqa-white);
    color: var(--lrqa-black);
    transition: border-color var(--duration-normal) var(--easing-standard);
  }

  .pricing-card--featured {
    border-color: var(--lrqa-mint);
  }

  .pricing-card__top,
  .pricing-card__price,
  .pricing-card__deliverables {
    display: grid;
    gap: var(--space-3);
  }

  .pricing-card__badge {
    width: fit-content;
    padding: var(--space-2) var(--space-3);
    background: var(--color-editorial-accent);
    color: var(--lrqa-white);
    font-size: var(--font-size-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .pricing-card__name,
  .pricing-card__lead,
  .pricing-card__deliverables-label,
  .pricing-common__label,
  .pricing-cta__question {
    margin: 0;
  }

  .pricing-card__name {
    font-size: var(--type-card-title);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
  }

  .pricing-card__price strong {
    font-family: var(--font-family-mono);
    font-size: var(--type-data-display);
    line-height: 1;
  }

  .pricing-card__price span,
  .pricing-card__lead {
    color: var(--lrqa-muted);
  }

  .pricing-card__lead {
    line-height: var(--line-height-relaxed);
  }

  .pricing-card__deliverables {
    align-content: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--lrqa-border-soft);
  }

  .pricing-card__deliverables-label,
  .pricing-common__label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .pricing-card__deliverables ul,
  .pricing-common__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pricing-card__deliverables li {
    position: relative;
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    color: var(--lrqa-muted-dark);
  }

  .pricing-card__deliverables li::before {
    content: "";
    position: absolute;
    top: 1.05rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--lrqa-mint);
  }

  .pricing-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--button-height-md);
    padding: var(--cta-padding-y) var(--cta-padding-x);
    background: var(--lrqa-mint);
    color: var(--lrqa-black);
    font-weight: var(--font-weight-bold);
  }

  .pricing-card__link span:last-child {
    transition: transform var(--duration-fast) var(--easing-standard);
  }

  .pricing-card__link:hover span:last-child,
  .pricing-card__link:focus-visible span:last-child {
    transform: translateX(var(--space-1));
  }

  .pricing-common {
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border: 1px solid var(--lrqa-border-soft);
  }

  .pricing-common__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .pricing-common__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--lrqa-muted-dark);
    line-height: var(--line-height-snug);
  }

  .pricing-common__check {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.1rem;
    background: var(--lrqa-mint);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }

  .pricing-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border: 1px solid var(--lrqa-border-soft);
  }

  .pricing-cta__question {
    font-size: var(--type-lead);
    font-weight: var(--font-weight-semibold);
  }

  .pricing-cta__btn {
    padding: var(--cta-padding-y) var(--cta-padding-x);
    background: var(--gradient-button-primary);
    color: var(--lrqa-black);
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
  }

  @media (hover: hover) {
    .pricing-card:hover {
      border-color: var(--lrqa-mint);
    }
  }

  @media (max-width: 60rem) {
    .pricing-common__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .pricing-grid,
    .pricing-common__list {
      grid-template-columns: 1fr;
    }

    .pricing-card {
      grid-template-rows: auto;
    }

    .pricing-cta {
      align-items: flex-start;
    }
  }
</style>

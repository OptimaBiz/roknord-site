---
const formats = [
  {
    name: "Полный комплекс",
    lead: "Ведём лабораторию или орган по сертификации от корректирующих действий и сборки доказательной базы до тренировки сотрудников и сопровождения во время процедуры ФСА.",
    priceLabel: "Стоимость",
    price: "Рассчитывается по итогам аудита",
    priceNote: "Цена и объём фиксируются в договоре до старта работ.",
    featured: true,
  },
  {
    name: "Точечный блок",
    lead: "Глубокая проработка конкретной проблемы: расширение или актуализация ОА, переработка СМК, подготовка отчёта о корректирующих действиях, отладка работы с ФГИС.",
    priceLabel: "Стоимость",
    price: "По объёму задач",
    priceNote: "Границы задачи и результат согласуем до начала работ.",
  },
  {
    name: "Внешний контроль качества",
    lead: "Периодический независимый аудит вашей системы между процедурами Росаккредитации. Удерживаем СМК в рабочем состоянии, проверяем новые записи и предупреждаем риски до следующего ПК.",
    priceLabel: "Условие",
    price: "Доступно по результатам первичного аудита",
    priceNote: "Годовой график и формат согласовываются индивидуально.",
  },
];
---

<section id="pricing" class="section section--light formats-section" aria-labelledby="formats-title">
  <div class="section__inner page-container">
    <header class="formats-intro">
      <p class="section__eyebrow">Форматы работы</p>
      <h2 id="formats-title" class="section__title">Начинаем с аудита. Итоговый объём сопровождения определяем только после диагностики</h2>
      <p class="section__lead">Мы не продаём «пакетное сопровождение» вслепую. Сначала — аудит за фиксированную стоимость, по итогам которого вы получаете точную карту рисков и смету дальнейших работ.</p>
    </header>

    <article class="pricing-start" aria-labelledby="pricing-start-title">
      <div class="pricing-start__head">
        <span class="pricing-start__badge">Стартовый шаг</span>
        <h3 id="pricing-start-title">Первичный аудит</h3>
      </div>
      <dl class="pricing-start__facts">
        <div>
          <dt>Стоимость</dt>
          <dd><span class="pricing-start__from">от</span><strong>150 000 ₽</strong><span>с НДС</span></dd>
        </div>
        <div>
          <dt>Срок</dt>
          <dd><strong>5–10</strong><span>рабочих дней</span></dd>
        </div>
      </dl>
      <div class="pricing-start__scope">
        <span>Что входит</span>
        <p>Аудит СМК, первичных записей, данных во ФГИС и практики на выборке. На выходе — детальный реестр несоответствий и карта рисков с пошаговым планом исправления.</p>
        <a class="pricing-start__cta cta-angled motion-control" href="#contact"><span>Обсудить условия аудита</span><span aria-hidden="true">→</span></a>
      </div>
      <p class="pricing-start__credit">
        Аудит можно взять отдельной работой. Если после него продолжаем сопровождение — его стоимость засчитывается в счёт дальнейших работ.
      </p>
    </article>

    <div class="formats-block">
      <p class="formats-block__label">Форматы сопровождения — после аудита</p>
      <div class="formats-grid">
        {formats.map((format, index) => (
          <article class:list={["format-card", format.featured && "format-card--featured"]}>
            <span class="format-card__num" aria-hidden="true">0{index + 1}</span>
            <h3>{format.name}</h3>
            <p>{format.lead}</p>
            <div class="format-card__price">
              <span>{format.priceLabel}</span>
              <strong>{format.price}</strong>
              <em>{format.priceNote}</em>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .formats-section .section__inner,.formats-intro,.format-card{display:grid}.formats-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}.formats-intro{grid-template-columns:minmax(0,1.25fr) minmax(16rem,.75fr);gap:1rem clamp(1.5rem,4vw,4.5rem);align-items:end}.formats-intro .section__eyebrow{grid-column:1/-1}.formats-intro .section__title,.formats-intro .section__lead{margin:0}
  .formats-intro .section__title{font-size:clamp(1.55rem,1.7vw + .85rem,2.35rem);line-height:1.18;text-wrap:balance;overflow-wrap:break-word}
  .pricing-start{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1.15fr);gap:clamp(1.5rem,3vw,3rem);align-items:start;padding:clamp(1.5rem,3vw,2.8rem);color:var(--lrqa-white);background:var(--lrqa-navy);border-top:4px solid var(--color-mint-action)}
  .pricing-start__head{display:grid;align-content:start;gap:.75rem}
  .pricing-start__badge{color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .pricing-start h3,.pricing-start p,.pricing-start dt,.pricing-start dd{margin:0}
  .pricing-start h3{font-size:clamp(1.6rem,1.6vw + 1rem,2.6rem);line-height:1.06}
  .pricing-start__facts{display:grid;gap:1.1rem;margin:0;padding-right:clamp(1.5rem,3vw,3rem);border-right:1px solid var(--lrqa-dark-border)}
  .pricing-start__facts dt{color:var(--lrqa-muted-2);font-size:var(--font-size-xs);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .pricing-start__facts dd{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem;margin-top:.3rem}
  .pricing-start__facts dd strong{font-size:clamp(1.5rem,1.2vw + 1rem,2.1rem);line-height:1.1;white-space:nowrap}
  .pricing-start__from{color:var(--lrqa-border-soft);font-size:var(--font-size-lg);font-weight:var(--font-weight-semibold)}
  .pricing-start__facts dd span{color:var(--lrqa-border-soft);font-size:var(--font-size-sm)}
  .pricing-start__scope{display:grid;align-content:start;gap:.7rem}
  .pricing-start__scope>span{color:var(--color-mint-action);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .pricing-start__scope p{color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}
  .pricing-start__cta{display:inline-flex;align-items:center;gap:.75rem;width:fit-content;margin-top:.5rem;padding:var(--cta-padding-y) calc(var(--cta-padding-x) + var(--button-bevel)*.5);color:var(--lrqa-black);background:var(--gradient-button-primary);font-weight:var(--button-font-weight);text-decoration:none}
  .pricing-start__credit{grid-column:1/-1;margin:0;padding:.85rem 0 0 1rem;color:var(--lrqa-white);font-size:var(--font-size-sm);line-height:var(--line-height-relaxed);border-top:1px solid var(--lrqa-dark-border);border-left:3px solid var(--color-mint-action);padding-left:1rem;margin-top:.35rem}
  .formats-block{display:grid;gap:1.25rem}
  .formats-block__label{margin:0;color:var(--lrqa-muted);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .formats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .format-card{grid-template-rows:auto auto 1fr auto;gap:.9rem;padding:clamp(1.5rem,3vw,2.5rem);background:var(--lrqa-white);border:1px solid var(--lrqa-border-soft)}
  .format-card--featured{border-color:var(--lrqa-navy);border-top:4px solid var(--color-mint-action)}
  .format-card__num{color:var(--lrqa-muted-2);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}
  .format-card h3,.format-card p{margin:0}
  .format-card h3{font-size:clamp(1.3rem,1vw + 1rem,1.85rem);line-height:1.1}
  .format-card p{color:var(--lrqa-muted);line-height:var(--line-height-relaxed)}
  .format-card__price{display:grid;gap:.3rem;padding-top:1.2rem;border-top:1px solid var(--lrqa-border-soft)}
  .format-card__price>span{color:var(--lrqa-muted-2);font-size:var(--font-size-xs);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}
  .format-card__price strong{font-size:var(--font-size-lg);line-height:1.25}
  .format-card__price em{color:var(--lrqa-muted);font-size:var(--font-size-sm);font-style:normal;line-height:var(--line-height-relaxed)}
  @media(max-width:64rem){.formats-intro{grid-template-columns:1fr}.pricing-start{grid-template-columns:1fr}.pricing-start__facts{grid-template-columns:1fr 1fr;padding-right:0;padding-bottom:1.25rem;border-right:0;border-bottom:1px solid var(--lrqa-dark-border)}.formats-grid{grid-template-columns:1fr}}
  @media(max-width:36rem){.pricing-start__facts{grid-template-columns:1fr}.pricing-start__cta{width:100%;justify-content:center}}
</style>

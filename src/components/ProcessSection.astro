---
const processSteps = [
  { step: "01", title: "Анализ документов", text: "Изучаем область, СМК, записи и исходные данные по ресурсам.", output: "План проверки" },
  { step: "02", title: "Проверка фактической практики", text: "Проверяем фактическую практику дистанционно и, при необходимости, на площадке.", output: "Наблюдения и подтверждающие материалы" },
  { step: "03", title: "Сопоставление", text: "Сверяем требования, процедуры, записи и фактическую работу.", output: "Карта рисков и реестр расхождений" },
  { step: "04", title: "Отчёт и разбор", text: "Определяем приоритеты и обсуждаем дальнейшие действия.", output: "Итоговый отчёт и план действий" },
];
---

<section id="formats" class="section section--dark process-section" aria-labelledby="process-title">
  <div class="section__inner page-container">
    <header class="process-intro" data-reveal>
      <p class="section__eyebrow">Процесс</p>
      <h2 id="process-title" class="section__title">Как проходит аудит</h2>
      <p class="section__lead">Рокнорд координирует работу от анализа документов и выезда на площадку до единого отчёта, карты рисков и плана действий.</p>
    </header>

    <div class="process-scroll-story">
      <div class="process-scroll-stage">
        <ol class="process-timeline">
          {processSteps.map((item) => (
            <li class="process-step">
              <span class="process-step__number">{item.step}</span>
              <div class="process-step__copy"><h3>{item.title}</h3><p>{item.text}</p></div>
              <div class="process-step__output"><span>Результат этапа</span><strong>{item.output}</strong></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <a class="process-cta" href="#contact" data-contact-context="Независимый аудит готовности" data-reveal>Обсудить аудит <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .process-section .section__inner,
  .process-intro,
  .process-timeline,
  .process-step__copy,
  .process-step__output { display: grid; }

  .process-section .section__inner { gap: clamp(2rem, 4vw, 3.5rem); }
  .process-scroll-story,
  .process-scroll-stage { width: 100%; min-width: 0; }
  .scroll-story-ui { display: none; }

  .process-intro { grid-template-columns: minmax(0, .9fr) minmax(20rem, 1.1fr); gap: 1rem clamp(2rem, 6vw, 7rem); align-items: end; }
  .process-intro .section__eyebrow { grid-column: 1 / -1; }
  .process-intro .section__title,
  .process-intro .section__lead { margin: 0; }

  .process-timeline { position: relative; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--lrqa-dark-border); border-left: 1px solid var(--lrqa-dark-border); }
  .process-timeline::before { content: ""; position: absolute; top: -2px; left: 0; width: 100%; height: 3px; background: var(--color-mint-action); }
  .process-step { display: grid; align-content: start; gap: clamp(1rem, 2vw, 1.5rem); min-height: 20rem; padding: clamp(1.35rem, 2.4vw, 2rem); border-right: 1px solid var(--lrqa-dark-border); border-bottom: 1px solid var(--lrqa-dark-border); }
  .process-step__number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; color: var(--lrqa-black); background: var(--color-mint-action); font-family: var(--font-family-mono); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); }
  .process-step__copy,
  .process-step__output { gap: .65rem; }
  .process-step h3,
  .process-step p,
  .process-step__output span,
  .process-step__output strong { margin: 0; }
  .process-step h3 { color: var(--lrqa-white); font-size: clamp(1.1rem, .65vw + 1rem, 1.5rem); line-height: 1.18; }
  .process-step p { color: var(--lrqa-border-soft); font-size: var(--font-size-sm); line-height: 1.6; }
  .process-step__output { align-self: end; padding-top: 1rem; border-top: 1px solid var(--lrqa-dark-border); }
  .process-step__output span { color: var(--lrqa-muted-2); font-size: var(--font-size-2xs); font-weight: var(--font-weight-bold); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .process-step__output strong { color: var(--lrqa-white); font-size: var(--font-size-sm); line-height: 1.45; }

  .process-cta { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; padding: 1rem 0; color: var(--lrqa-white); font-weight: var(--font-weight-semibold); text-decoration: none; border-top: 1px solid var(--lrqa-dark-border); border-bottom: 1px solid var(--lrqa-dark-border); }
  .process-cta span { color: var(--color-mint-action); font-size: 1.25rem; transition: transform var(--duration-normal) var(--easing-emphasis); }
  .process-cta:hover span,
  .process-cta:focus-visible span { transform: translateX(.35rem); }

  @media(max-width:64rem) {
    .process-intro { grid-template-columns: 1fr; }
    .process-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .process-step { min-height: 18rem; }
  }

  @media(max-width:48rem) {
    .process-timeline { grid-template-columns: 1fr; border-top: 0; }
    .process-timeline::before { display: none; }
    .process-step { grid-template-columns: auto minmax(0, 1fr); align-content: start; gap: .9rem 1rem; min-height: 0; padding: 1.25rem; background: color-mix(in srgb, var(--lrqa-white) 3%, var(--lrqa-navy-2)); border-top: 1px solid var(--lrqa-dark-border); }
    .process-step__number { width: fit-content; height: auto; padding: .4rem .55rem; color: var(--color-mint-action); background: transparent; border: 1px solid color-mix(in srgb, var(--color-mint-action) 55%, transparent); }
    .process-step__copy { align-content: start; gap: .45rem; }
    .process-step h3 { font-size: clamp(1.2rem, 5.5vw, 1.5rem); }
    .process-step__copy p { display: none; }
    .process-step__output { grid-column: 2; align-self: start; padding-top: .8rem; }
    .process-step__output strong { font-size: .92rem; }
  }
</style>

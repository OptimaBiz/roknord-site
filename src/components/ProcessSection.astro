---
const processSteps = [
  { step: "01", title: "Предварительный анализ документов", text: "Изучаем область аккредитации, документы СМК, записи, сведения во ФГИС и исходные данные по персоналу и оборудованию.", output: "План аудита и перечень вопросов для проверки на площадке" },
  { step: "02", title: "Выездная проверка на площадке", text: "Проверяем фактическую деятельность, доступность ресурсов, компетентность персонала и практическое выполнение работ.", output: "Фактические наблюдения и подтверждающие материалы" },
  { step: "03", title: "Сопоставление требований и доказательств", text: "Сопоставляем требования, внутренние процедуры, записи, сведения во ФГИС и результаты проверки фактической практики.", output: "Карта рисков и реестр выявленных расхождений" },
  { step: "04", title: "Итоговый отчёт и разбор результатов", text: "Систематизируем выводы, определяем приоритеты и обсуждаем рекомендуемые действия по устранению выявленных рисков.", output: "Итоговый отчёт и план дальнейших действий" },
];
---

<section id="formats" class="section section--dark process-section" aria-labelledby="process-title">
  <div class="section__inner page-container">
    <header class="process-intro" data-reveal>
      <p class="section__eyebrow">Процесс</p>
      <h2 id="process-title" class="section__title">Как проходит независимый аудит готовности</h2>
      <p class="section__lead">Сначала анализируем документы, затем проверяем фактическую деятельность на площадке. После сопоставления требований, записей и практики готовим итоговый отчёт с картой рисков, реестром расхождений и планом действий.</p>
    </header>

    <ol class="process-timeline" data-reveal>
      {processSteps.map((item) => (
        <li class="process-step">
          <span class="process-step__number">{item.step}</span>
          <div class="process-step__copy"><h3>{item.title}</h3><p>{item.text}</p></div>
          <div class="process-step__output"><span>Результат этапа</span><strong>{item.output}</strong></div>
        </li>
      ))}
    </ol>
    <a class="process-cta" href="#contact" data-contact-context="Независимый аудит готовности" data-reveal>Разобрать задачу <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .process-section .section__inner,.process-intro,.process-timeline,.process-step__copy,.process-step__output{display:grid}.process-section .section__inner{gap:clamp(2.5rem,5vw,4.5rem)}
  .process-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.process-intro .section__eyebrow{grid-column:1/-1}.process-intro .section__title,.process-intro .section__lead{margin:0}
  .process-timeline{position:relative;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-dark-border);border-left:1px solid var(--lrqa-dark-border)}.process-timeline::before{content:"";position:absolute;top:-2px;left:0;width:100%;height:3px;background:var(--color-mint-action);transform:scaleX(0);transform-origin:left;transition:transform 1.4s var(--easing-emphasis)}.process-timeline.is-revealed::before{transform:scaleX(1)}.process-step{display:grid;align-content:start;gap:clamp(1.25rem,2.3vw,2rem);min-height:27rem;padding:clamp(1.35rem,2.4vw,2.2rem);border-right:1px solid var(--lrqa-dark-border);border-bottom:1px solid var(--lrqa-dark-border)}.process-step__number{display:grid;place-items:center;width:2.5rem;height:2.5rem;color:var(--lrqa-black);background:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}.process-step__copy,.process-step__output{gap:.65rem}.process-step h3,.process-step p,.process-step__output span,.process-step__output strong{margin:0}.process-step h3{color:var(--lrqa-white);font-size:clamp(1.1rem,.65vw + 1rem,1.5rem);line-height:1.18}.process-step p{color:var(--lrqa-border-soft);font-size:var(--font-size-sm);line-height:1.6}.process-step__output{align-self:end;padding-top:1rem;border-top:1px solid var(--lrqa-dark-border)}.process-step__output span{color:var(--lrqa-muted-2);font-size:var(--font-size-2xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.process-step__output strong{color:var(--lrqa-white);font-size:var(--font-size-sm);line-height:1.45}
  @media(max-width:64rem){.process-intro{grid-template-columns:1fr}.process-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}.process-step{min-height:23rem}}
  @media(max-width:48rem){.process-timeline{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(17.5rem,85vw);overflow-x:auto;overscroll-behavior-inline:contain;scroll-padding-inline:1px;scroll-snap-type:x mandatory;scrollbar-color:var(--color-mint-action) var(--lrqa-dark-border)}.process-timeline::before{display:none}.process-step{grid-template-columns:2.5rem minmax(0,1fr);min-height:27rem;scroll-snap-align:start}.process-step__copy,.process-step__output{grid-column:2}.process-step__output{align-self:end}}
  .process-cta{display:inline-flex;align-items:center;justify-content:space-between;gap:1rem;width:100%;padding:1rem 0;color:var(--lrqa-white);font-weight:var(--font-weight-semibold);text-decoration:none;border-top:1px solid var(--lrqa-dark-border);border-bottom:1px solid var(--lrqa-dark-border)}.process-cta span{color:var(--color-mint-action);font-size:1.25rem;transition:transform var(--duration-normal) var(--easing-emphasis)}.process-cta:hover span,.process-cta:focus-visible span{transform:translateX(.35rem)}
</style>

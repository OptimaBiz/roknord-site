---
const processSteps = [
  { step: "01", title: "Предварительный анализ документов", text: "Изучаем область аккредитации, документы СМК, записи, сведения во ФГИС и исходные данные по персоналу и оборудованию.", output: "План аудита и перечень вопросов для проверки на площадке" },
  { step: "02", title: "Выездная проверка на площадке", text: "Проверяем фактическую деятельность, доступность ресурсов, компетентность персонала и практическое выполнение работ.", output: "Фактические наблюдения и подтверждающие материалы" },
  { step: "03", title: "Сопоставление требований и доказательств", text: "Сопоставляем требования, внутренние процедуры, записи, сведения во ФГИС и результаты проверки фактической практики.", output: "Карта рисков и реестр выявленных расхождений" },
  { step: "04", title: "Итоговый отчёт и разбор результатов", text: "Систематизируем выводы, определяем приоритеты и обсуждаем рекомендуемые действия по устранению выявленных рисков.", output: "Итоговый отчёт и план дальнейших действий" },
];
---

<section id="formats" class="section section--dark process-section" aria-labelledby="process-title">
  <div class="section__inner page-container">
    <header class="process-intro">
      <p class="section__eyebrow">Процесс</p>
      <h2 id="process-title" class="section__title">Как проходит независимый аудит готовности</h2>
      <p class="section__lead">Сначала анализируем документы, затем проверяем фактическую деятельность на площадке. После сопоставления требований, записей и практики готовим итоговый отчёт с картой рисков, реестром расхождений и планом действий.</p>
    </header>

    <ol class="process-timeline">
      {processSteps.map((item) => (
        <li class="process-step">
          <span class="process-step__number">{item.step}</span>
          <div class="process-step__copy"><h3>{item.title}</h3><p>{item.text}</p></div>
          <div class="process-step__output"><span>Результат этапа</span><strong>{item.output}</strong></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-section .section__inner,.process-intro,.process-timeline,.process-step__copy,.process-step__output{display:grid}.process-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}
  .process-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.process-intro .section__eyebrow{grid-column:1/-1}.process-intro .section__title,.process-intro .section__lead{margin:0}
  .process-timeline{margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-dark-border)}.process-step{display:grid;grid-template-columns:4rem minmax(12rem,.72fr) minmax(0,1.28fr);gap:clamp(1rem,3vw,3rem);padding:clamp(1.35rem,2.8vw,2.4rem) 0;border-bottom:1px solid var(--lrqa-dark-border)}.process-step__number{color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-sm)}.process-step__copy,.process-step__output{gap:.55rem}.process-step h3,.process-step p,.process-step__output span,.process-step__output strong{margin:0}.process-step h3{color:var(--lrqa-white);font-size:clamp(1.1rem,.65vw + 1rem,1.55rem);line-height:1.25}.process-step p{color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}.process-step__output{padding-left:clamp(1rem,3vw,3rem);border-left:1px solid var(--lrqa-dark-border)}.process-step__output span{color:var(--lrqa-muted-2);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.process-step__output strong{color:var(--lrqa-white);line-height:1.4}
  @media(max-width:64rem){.process-intro{grid-template-columns:1fr}}@media(max-width:48rem){.process-step{grid-template-columns:2.5rem minmax(0,1fr)}.process-step__output{grid-column:2;padding-top:1rem;padding-left:0;border-top:1px solid var(--lrqa-dark-border);border-left:0}}
</style>

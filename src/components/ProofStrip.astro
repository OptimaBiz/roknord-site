---
const auditChecks = [
  { number: "01", title: "Где вы сейчас", text: "Проверяем документы, записи, область, ФГИС и фактическую практику." },
  { number: "02", title: "Что действительно критично", text: "Отделяем риски для процедуры от косметических правок и лишней работы." },
  { number: "03", title: "Как двигаться дальше", text: "Фиксируем приоритеты, ответственных, сроки и доказательства результата." },
];
---

<section id="approach" class="section section--dark audit-start" aria-labelledby="audit-start-title">
  <div class="section__inner page-container">
    <header class="audit-start__intro">
      <p class="section__eyebrow">Первый шаг</p>
      <h2 id="audit-start-title" class="section__title">Сначала проводим первичный аудит — затем берёмся за исправления и сопровождение</h2>
      <p class="section__lead">Без диагностики нельзя честно назвать объём, сроки и стоимость. Поэтому любой проект начинается с короткой независимой проверки текущего состояния.</p>
    </header>

    <ol class="audit-start__grid">
      {auditChecks.map((item) => (
        <li>
          <span>{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>

    <div class="audit-start__note">
      <strong>Аудит не заканчивается отчётом.</strong>
      <p>Его задача — дать рабочую основу для следующего этапа: устранения рисков, подготовки доказательной базы, обучения команды и сопровождения процедуры.</p>
    </div>
  </div>
</section>

<style>
  .audit-start .section__inner,.audit-start__intro{display:grid}.audit-start .section__inner{gap:clamp(2.5rem,6vw,5rem)}.audit-start__intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.audit-start__intro .section__eyebrow{grid-column:1/-1}.audit-start__intro .section__title,.audit-start__intro .section__lead{margin:0}
  .audit-start__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-dark-border);border-left:1px solid var(--lrqa-dark-border)}.audit-start__grid li{display:grid;align-content:start;gap:.9rem;min-height:17rem;padding:clamp(1.4rem,2.8vw,2.6rem);border-right:1px solid var(--lrqa-dark-border);border-bottom:1px solid var(--lrqa-dark-border)}.audit-start__grid li>span{color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.audit-start__grid h3,.audit-start__grid p,.audit-start__note strong,.audit-start__note p{margin:0}.audit-start__grid h3{color:var(--lrqa-white);font-size:clamp(1.35rem,1.2vw + 1rem,2.1rem);line-height:1.08}.audit-start__grid p{color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}
  .audit-start__note{display:grid;grid-template-columns:minmax(15rem,.5fr) minmax(0,1.5fr);gap:1rem clamp(2rem,5vw,5rem);padding-top:1.5rem;border-top:1px solid var(--lrqa-dark-border)}.audit-start__note strong{color:var(--color-mint-action);font-size:clamp(1.1rem,.55vw + 1rem,1.5rem)}.audit-start__note p{max-width:52rem;color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}
  @media(max-width:64rem){.audit-start__intro,.audit-start__note{grid-template-columns:1fr}.audit-start__grid{grid-template-columns:1fr 1fr}.audit-start__grid li:last-child{grid-column:1/-1;min-height:0}}
  @media(max-width:42rem){.audit-start__grid{grid-template-columns:1fr}.audit-start__grid li:last-child{grid-column:auto}.audit-start__grid li{min-height:0}}
</style>

---
const workAreas = [
  { number: "01", title: "Разобраться", text: "Фиксируем задачу, сроки, слабые места и реальный объём подготовки." },
  { number: "02", title: "Привести в порядок", text: "Согласуем область, документы, записи, ФГИС и фактическую работу." },
  { number: "03", title: "Подготовить команду", text: "Помогаем сотрудникам понимать свои роли и уверенно показывать практику." },
  { number: "04", title: "Сопроводить процедуру", text: "Остаёмся рядом при подаче, подготовке к ВКС и работе с замечаниями." },
];
---

<section id="approach" class="section section--dark assurance-section" aria-labelledby="assurance-title">
  <div class="section__inner page-container">
    <header class="assurance-intro">
      <p class="section__eyebrow">Что мы берём на себя</p>
      <h2 id="assurance-title" class="section__title">Сложную процедуру превращаем в понятный рабочий план</h2>
      <p class="section__lead">Не оставляем вас один на один с отчётом. Находим проблемы, помогаем их исправить и проверяем, что изменения действительно работают.</p>
    </header>

    <ol class="assurance-grid">
      {workAreas.map((item) => (
        <li>
          <span class="assurance-grid__number">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>

    <div class="assurance-note">
      <strong>Аудит — только начало.</strong>
      <p>Он нужен, чтобы увидеть реальную картину. Основная работа начинается дальше: приоритеты, исправления, внедрение и сопровождение до процедуры.</p>
    </div>
  </div>
</section>

<style>
  .assurance-section .section__inner,.assurance-intro{display:grid}.assurance-section .section__inner{gap:clamp(2.5rem,6vw,5rem)}.assurance-intro{grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:1rem clamp(2rem,6vw,7rem);align-items:end}.assurance-intro .section__eyebrow{grid-column:1/-1}.assurance-intro .section__title,.assurance-intro .section__lead{margin:0}
  .assurance-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;list-style:none;border-top:1px solid var(--lrqa-dark-border);border-left:1px solid var(--lrqa-dark-border)}.assurance-grid li{display:grid;align-content:start;gap:1rem;min-height:19rem;padding:clamp(1.35rem,2.5vw,2.4rem);border-right:1px solid var(--lrqa-dark-border);border-bottom:1px solid var(--lrqa-dark-border)}.assurance-grid__number{color:var(--color-mint-action);font-family:var(--font-family-mono);font-size:var(--font-size-xs)}.assurance-grid h3,.assurance-grid p,.assurance-note strong,.assurance-note p{margin:0}.assurance-grid h3{color:var(--lrqa-white);font-size:clamp(1.35rem,1.4vw + 1rem,2.2rem);line-height:1.05}.assurance-grid p{color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}
  .assurance-note{display:grid;grid-template-columns:minmax(13rem,.45fr) minmax(0,1.55fr);gap:1rem clamp(2rem,5vw,5rem);padding-top:1.5rem;border-top:1px solid var(--lrqa-dark-border)}.assurance-note strong{color:var(--color-mint-action);font-size:clamp(1.15rem,.6vw + 1rem,1.55rem)}.assurance-note p{max-width:50rem;color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}
  @media(max-width:64rem){.assurance-intro,.assurance-note{grid-template-columns:1fr}.assurance-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:42rem){.assurance-grid{grid-template-columns:1fr}.assurance-grid li{min-height:0}}
</style>

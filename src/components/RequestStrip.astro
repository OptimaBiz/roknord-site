<section class="request-strip" aria-label="Быстрый запрос">
  <div class="request-strip__inner page-container">
    <div class="request-strip__contact-group">
      <a class="request-strip__phone motion-control" href="tel:+78123898178">
        <img class="request-strip__phone-icon" src="/icons/phone_icon.svg" alt="" aria-hidden="true" decoding="async" />
        <span>+7 (812) 389-81-78</span>
      </a>
      <span class="request-strip__separator" aria-hidden="true"></span>
      <a class="request-strip__action motion-control" href="#contact">
        <img class="request-strip__icon" src="/icons/envelope_icon.svg" alt="" aria-hidden="true" decoding="async" />
        <span>Задать вопрос эксперту</span>
      </a>
    </div>
  </div>
  <script is:inline>
    (() => {
      const initialize = () => {
        const strip = document.querySelector(".request-strip");
        const formats = document.getElementById("formats");
        if (!strip || !formats) return;

        let updateQueued = false;

        const updateState = () => {
          const stripRect = strip.getBoundingClientRect();
          const formatsRect = formats.getBoundingClientRect();
          const isStuck = stripRect.top <= 0;
          const phoneOnly = formatsRect.top <= stripRect.height;

          strip.classList.toggle("request-strip--stuck", isStuck);
          strip.classList.toggle("request-strip--phone-only", phoneOnly);
          updateQueued = false;
        };

        const queueUpdate = () => {
          if (updateQueued) return;
          updateQueued = true;
          window.requestAnimationFrame(updateState);
        };

        window.addEventListener("scroll", queueUpdate, { passive: true });
        window.addEventListener("resize", queueUpdate);
        updateState();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialize, { once: true });
      } else {
        initialize();
      }
    })();
  </script>
</section>

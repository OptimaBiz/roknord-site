---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
  note: string;
};

const { eyebrow, title, description, note } = Astro.props as Props;
---

<main id="content">
  <section class="section-placeholder" aria-labelledby="section-placeholder-title">
    <div class="section-placeholder__inner page-container">
      <p class="section__eyebrow">{eyebrow}</p>
      <h1 id="section-placeholder-title">{title}</h1>
      <p class="section-placeholder__description">{description}</p>
      <div class="section-placeholder__status">
        <span>Раздел в разработке</span>
        <p>{note}</p>
      </div>
      <a class="section-placeholder__link" href="/">На главную <span aria-hidden="true">→</span></a>
    </div>
  </section>
</main>

<style>
  .section-placeholder {
    min-height: min(42rem, calc(100svh - var(--header-total-height)));
    display: grid;
    align-items: center;
    color: var(--lrqa-white);
    background: var(--lrqa-navy);
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .section-placeholder__inner {
    display: grid;
    align-content: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .section-placeholder h1,
  .section-placeholder p { margin: 0; }

  .section-placeholder h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: .92;
    text-wrap: balance;
  }

  .section-placeholder__description {
    max-width: 42rem;
    color: var(--lrqa-border-soft);
    font-size: clamp(1.05rem, 1vw + .8rem, 1.45rem);
    line-height: 1.55;
  }

  .section-placeholder__status {
    display: grid;
    gap: .55rem;
    max-width: 38rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--lrqa-dark-border);
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .section-placeholder__status > span {
    color: var(--color-mint-action);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .section-placeholder__status p {
    color: var(--lrqa-white);
    line-height: 1.5;
  }

  .section-placeholder__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, 38rem);
    padding: 1rem 0;
    color: var(--lrqa-white);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-bottom: 1px solid var(--lrqa-dark-border);
  }

  .section-placeholder__link span {
    color: var(--color-mint-action);
    font-size: 1.25rem;
    transition: transform var(--duration-normal) var(--easing-emphasis);
  }

  .section-placeholder__link:hover span,
  .section-placeholder__link:focus-visible span { transform: translateX(.35rem); }

  @media(prefers-reduced-motion:reduce) {
    .section-placeholder__link span { transition: none; }
    .section-placeholder__link:hover span { transform: none; }
  }
</style>

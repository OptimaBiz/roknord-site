---
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://api.roknord.ru/contact.php";
---
<section class="pdn-form-section" id="audit-form" aria-labelledby="form-title"><div class="page-container pdn-form-grid"><div><p class="pdn-label">Заявка</p><h2 id="form-title">Подтвердить объём и срок</h2><p>Укажите сайт или ИНН и телефон. Уточним контур обработки данных и подтвердим, что входит в стандартную услугу за 22&nbsp;000 ₽. Расширенный объём согласуем отдельно.</p><p class="pdn-form-section__contact">Или позвоните: <a href="tel:+78123898178" data-pdn-goal="pdn_audit_form_phone_click">+7 (812) 389-81-78</a></p></div>
  <form class="pdn-form" action={contactEndpoint} method="POST" data-pdn-form novalidate>
    <input type="hidden" name="_subject" value="Заявка: аудит и документы по 152-ФЗ"/><input type="hidden" name="form_name" value="Аудит и документы по 152-ФЗ"/><input type="hidden" name="consent_version" value="1.1-2026-08-13"/><input type="hidden" name="consent_timestamp" data-consent-timestamp/><input type="hidden" name="consent_page" data-consent-page/><input type="hidden" name="name" value="Заявка на аудит и документы по 152-ФЗ"/><input type="hidden" name="email" value="hello@roknord.ru"/><input type="hidden" name="message" data-request-message/><input type="hidden" name="attribution" data-attribution/><input type="hidden" name="selfcheck" data-selfcheck-input/><input type="text" name="_gotcha" class="pdn-trap" tabindex="-1" autocomplete="off" aria-hidden="true"/>
    <fieldset data-form-step="1"><legend>Как устроен ваш контур?</legend><div class="pdn-form__options">{['Сайт и формы','Сайт, CRM и сервисы','Несколько сайтов или систем','Не знаю — нужна оценка'].map((item, i) => <label><input type="radio" name="audit_scope" value={item} required checked={i === 3}/><span>{item}</span></label>)}</div><button class="button button-primary cta-angled" type="button" data-form-next>Продолжить →</button></fieldset>
    <fieldset data-form-step="2" hidden><legend>Оставьте контакты</legend><label class="pdn-field"><span>Сайт или ИНН</span><input name="company_reference" type="text" maxlength="120" placeholder="example.ru или ИНН" required/></label><label class="pdn-field"><span>Телефон</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern="^[+0-9()\\s-]{6,24}$" placeholder="+7 000 000 00 00" required/></label><label class="pdn-consent"><input name="personal_data_consent" type="checkbox" value="accepted" required/><span>Даю <a href="/personal-data-consent/" target="_blank">согласие на обработку персональных данных</a>.</span></label><p class="pdn-form__policy">Порядок обработки данных описан в <a href="/privacy-policy/" target="_blank">Политике обработки персональных данных</a>.</p><button class="button button-primary cta-angled" type="submit">Обсудить аудит и документы →</button><button class="pdn-form__back" type="button" data-form-back>← Изменить вариант</button></fieldset>
    <p class="pdn-form__status" role="status" aria-live="polite">До начала работы подтвердим объём, срок и состав документов. Дополнительные задачи выполняем только после согласования.</p>
    <div class="pdn-form__success" hidden tabindex="-1"><h3>Заявка получена</h3><p>Свяжемся, чтобы уточнить контур обработки данных и подтвердить состав услуги, срок и стоимость.</p><a href="/">Вернуться на сайт Рокнорд →</a></div>
  </form></div></section>
<script define:vars={{ contactEndpoint }}>
  (() => {
    const form = document.querySelector('[data-pdn-form]'); if (!(form instanceof HTMLFormElement)) return;
    const step1 = form.querySelector('[data-form-step="1"]'); const step2 = form.querySelector('[data-form-step="2"]'); const status = form.querySelector('.pdn-form__status');
    const attributionKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','yclid'];
    const current = new URL(location.href); const stored = JSON.parse(sessionStorage.getItem('pdnAuditAttribution') || '{}');
    attributionKeys.forEach((key) => { if (current.searchParams.get(key)) stored[key] = current.searchParams.get(key); });
    stored.landing_page ||= location.href; stored.referrer ||= document.referrer; sessionStorage.setItem('pdnAuditAttribution', JSON.stringify(stored));
    form.querySelector('[data-attribution]').value = JSON.stringify(stored); form.querySelector('[data-selfcheck-input]').value = sessionStorage.getItem('pdnAuditSelfcheck') || '[]';
    form.addEventListener('focusin', () => window.__pdnGoal?.('pdn_audit_form_start'), { once: true });
    form.querySelector('[data-form-next]').addEventListener('click', () => { step1.hidden = true; step2.hidden = false; step2.querySelector('input').focus(); window.__pdnGoal?.('pdn_audit_form_step_2'); });
    form.querySelector('[data-form-back]').addEventListener('click', () => { step2.hidden = true; step1.hidden = false; });
    form.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.reportValidity()) return; status.textContent = 'Отправляем заявку…'; const button = form.querySelector('[type="submit"]'); button.disabled = true; const submittedAt = new Date().toISOString(); const selfcheck = sessionStorage.getItem('pdnAuditSelfcheck') || '[]'; const scope = form.querySelector('[name="audit_scope"]:checked')?.value || ''; const reference = form.querySelector('[name="company_reference"]')?.value || ''; form.querySelector('[data-selfcheck-input]').value = selfcheck; form.querySelector('[data-consent-timestamp]').value = submittedAt; form.querySelector('[data-consent-page]').value = location.href; form.querySelector('[data-request-message]').value = `Аудит и документы по 152-ФЗ\nКонтур: ${scope}\nСайт или ИНН: ${reference}\nСамодиагностика: ${selfcheck}\nAttribution: ${JSON.stringify(stored)}`; const data = new FormData(form); data.append('submitted_at', submittedAt);
      try { const response = await fetch(contactEndpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } }); if (!response.ok) throw new Error('submit'); window.__pdnGoal?.('pdn_audit_form_submit'); window.__pdnGoal?.('form_submit'); [...form.children].forEach((item) => item.hidden = true); const success = form.querySelector('.pdn-form__success'); success.hidden = false; success.focus(); }
      catch { status.textContent = 'Не удалось отправить заявку. Позвоните нам: +7 (812) 389-81-78.'; button.disabled = false; }
    });
  })();
</script>

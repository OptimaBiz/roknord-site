---
const scenarios = [
  ['Обновили сайт', 'Появились новые формы, аналитика, чат или сервисы, которые получают данные посетителей.'],
  ['Внедрили CRM', 'Заявки переходят между сайтом, CRM, почтой, телефонией и другими системами.'],
  ['Подключили подрядчиков', 'Доступ к данным получили внешние исполнители или облачные сервисы.'],
  ['Процессы изменились', 'Документы и сведения в Роскомнадзоре могут уже не отражать фактическую работу.'],
];
---
<section class="pdn-section pdn-section--light" aria-labelledby="scenarios-title">
  <div class="page-container">
    <div class="pdn-intro"><p class="pdn-label">Когда нужна услуга</p><h2 id="scenarios-title">Когда стоит проверить обработку данных</h2><p>Особенно если менялись сайт, системы, подрядчики или внутренние процессы, а документы остались прежними.</p></div>
    <div class="scenario-grid scenario-grid--compact">{scenarios.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
  </div>
</section>

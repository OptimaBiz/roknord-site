---
const scenarios = [
  ['Поменяли сайт', 'Добавились формы, аналитика, чат или новые сервисы.'],
  ['Внедрили CRM', 'Заявки начали автоматически переходить между системами.'],
  ['Документы делали давно', 'Бизнес изменился, а документы остались прежними.'],
  ['Подключили подрядчиков', 'К данным получили доступ внешние исполнители.'],
  ['Меняли процессы после уведомления РКН', 'Сведения в реестре могут не учитывать текущую работу.'],
  ['Не можете описать путь заявки', 'Непонятно, куда попадают данные и кто имеет к ним доступ.'],
];
---
<section class="pdn-section pdn-section--light" aria-labelledby="scenarios-title">
  <div class="page-container">
    <div class="pdn-intro"><p class="pdn-label">Когда нужен аудит</p><h2 id="scenarios-title">Проверьте себя</h2></div>
    <div class="scenario-grid scenario-grid--compact">{scenarios.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
  </div>
</section>

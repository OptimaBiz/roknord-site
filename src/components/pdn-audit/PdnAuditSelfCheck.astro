<section class="pdn-section pdn-section--light" aria-labelledby="selfcheck-title" data-selfcheck>
  <div class="page-container">
    <div class="pdn-intro"><p class="pdn-label">Быстрая самодиагностика</p><h2 id="selfcheck-title">Политика на сайте ещё не означает, что контур ПДн оформлен правильно</h2><p>Отметьте, что используется в вашей компании. Проверка займёт несколько секунд.</p></div>
    <div class="selfcheck__grid">
      {['Есть формы заявки на сайте','Заявки попадают в CRM','Используется аналитика','Есть чат, обратный звонок или учёт звонков','Клиенты пишут в мессенджеры','Есть сотрудники','Используются облачные сервисы','Есть рассылки','Доступ имеют подрядчики','Уведомление в РКН уже подавалось'].map((item) => <label class="selfcheck__item"><input type="checkbox" value={item} /><span>{item}</span></label>)}
    </div>
    <div class="selfcheck__result" aria-live="polite"><strong data-selfcheck-count>0 точек</strong><p data-selfcheck-message>Даже простой контур требует корректного оформления обработки персональных данных.</p><a class="button button-primary cta-angled" href="#audit-form" data-selfcheck-cta>Проверить этот контур →</a></div>
  </div>
</section>
<script is:inline>
  (() => {
    const root = document.querySelector('[data-selfcheck]');
    if (!root) return;
    const inputs = [...root.querySelectorAll('input[type="checkbox"]')];
    const count = root.querySelector('[data-selfcheck-count]');
    const message = root.querySelector('[data-selfcheck-message]');
    let started = false;
    const goal = (name) => window.__pdnGoal?.(name);
    const update = () => {
      const selected = inputs.filter((input) => input.checked);
      count.textContent = `${selected.length} ${selected.length === 1 ? 'точка' : selected.length < 5 ? 'точки' : 'точек'}`;
      message.textContent = selected.length >= 5 ? 'У вас развитый контур обработки ПДн. Проверки одной политики на сайте недостаточно.' : selected.length >= 2 ? 'У вас несколько взаимосвязанных точек обработки. Их стоит проверять как единый процесс.' : 'Даже простой контур требует корректного оформления обработки персональных данных.';
      sessionStorage.setItem('pdnAuditSelfcheck', JSON.stringify(selected.map((input) => input.value)));
      if (!started) { started = true; goal('pdn_audit_selfcheck_start'); }
      if (selected.length === 5) goal('pdn_audit_selfcheck_complete');
    };
    inputs.forEach((input) => input.addEventListener('change', update));
  })();
</script>

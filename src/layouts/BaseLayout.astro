---
import "../styles/global.css";
import "../styles/sections.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookiePanel from "../components/CookiePanel.astro";
import ScrollUpControl from "../components/ScrollUpControl.astro";
import LoginModal from "../components/LoginModal.astro";

type Props = {
  title: string;
  description: string;
};

const {
  title,
  description,
} = Astro.props as Props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="" id="theme-color-meta" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      const themeColorMeta = document.getElementById("theme-color-meta");
      if (themeColorMeta) {
        const themeColor = getComputedStyle(document.documentElement).getPropertyValue("--color-bg").trim();
        if (themeColor) themeColorMeta.setAttribute("content", themeColor);
      }
    </script>

    <script is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=111070145", "ym");

      ym(111070145, "init", {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: "dataLayer",
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });

      // ClientRouter меняет страницу без перезагрузки — Metrika сама такие переходы не видит.
      document.addEventListener("astro:after-swap", function () {
        if (typeof ym === "function") {
          ym(111070145, "hit", location.href, { title: document.title, referer: document.referrer });
        }
      });
    </script>
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/111070145" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <a class="skip-link" href="#content">Перейти к содержимому</a>
    <div class="site-shell">
      <Header />
      <slot />
      <Footer />
      <CookiePanel />
      <ScrollUpControl />
      <LoginModal />
    </div>
  </body>
</html>

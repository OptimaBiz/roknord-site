---
import "../styles/global.css";
import "../styles/sections.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookiePanel from "../components/CookiePanel.astro";
import ScrollUpControl from "../components/ScrollUpControl.astro";
import PdnAuditFooter from "../components/pdn-audit/PdnAuditFooter.astro";
import { organizationSchema } from "../data/organization";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  landingFooter?: boolean;
  privatePage?: boolean;
};

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, "https://roknord.ru").href,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogImage = 'https://roknord.ru/images/hero/roknord-hero-poster.jpg',
  publishedTime,
  robots,
  structuredData,
  landingFooter = false,
  privatePage = false,
} = Astro.props as Props;

const pageStructuredDataItems = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const structuredDataItems = [organizationSchema, ...pageStructuredDataItems];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="РОКНОРД" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="theme-color" content="" id="theme-color-meta" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260904" />
    <link rel="icon" href="/favicon.ico?v=20260904" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260904" />
    <link rel="manifest" href="/site.webmanifest?v=20260904" />
    <title>{title}</title>
    {structuredDataItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      const themeColorMeta = document.getElementById("theme-color-meta");
      if (themeColorMeta) {
        const themeColor = getComputedStyle(document.documentElement).getPropertyValue("--lrqa-nav").trim();
        if (themeColor) themeColorMeta.setAttribute("content", themeColor);
      }
    </script>

    {!privatePage && <script is:inline>
      const roknordMetrikaId = 111070145;
      const roknordMetrikaSrc = `https://mc.yandex.ru/metrika/tag.js?id=${roknordMetrikaId}`;
      window.__roknordGoalQueue = window.__roknordGoalQueue || [];

      window.__roknordReachGoal = function (name, params) {
        try {
          if (window.localStorage.getItem("roknord-cookie-consent") !== "accepted") return false;
        } catch {
          return false;
        }

        if (window.__roknordAnalyticsOn && typeof window.ym === "function") {
          window.ym(roknordMetrikaId, "reachGoal", name, params || {});
          return true;
        }

        window.__roknordGoalQueue.push({ name, params: params || {} });
        return false;
      };

      window.__roknordStorePendingConversion = function (params) {
        try {
          window.sessionStorage.setItem("roknord-pending-conversion", JSON.stringify({
            ...params,
            createdAt: new Date().toISOString(),
          }));
        } catch {}
      };

      window.__roknordEnableAnalytics = function () {
        if (window.__roknordAnalyticsOn || window.__roknordAnalyticsLoading) return;
        window.__roknordAnalyticsLoading = true;

        window.ym = window.ym || function () {
          (window.ym.a = window.ym.a || []).push(arguments);
        };
        window.ym.l = Number(new Date());

        const initialize = function () {
          try {
            if (window.localStorage.getItem("roknord-cookie-consent") !== "accepted") {
              window.__roknordAnalyticsLoading = false;
              return;
            }
          } catch {
            window.__roknordAnalyticsLoading = false;
            return;
          }

          if (window.__roknordAnalyticsOn) return;
          window.__roknordAnalyticsOn = true;
          window.__roknordAnalyticsLoading = false;
          window.ym(roknordMetrikaId, "init", {
            ssr: true,
            webvisor: true,
            clickmap: true,
            ecommerce: "dataLayer",
            referrer: document.referrer,
            url: location.href,
            accurateTrackBounce: true,
            trackLinks: true,
          });

          const queuedGoals = window.__roknordGoalQueue.splice(0);
          queuedGoals.forEach(function (goal) {
            window.ym(roknordMetrikaId, "reachGoal", goal.name, goal.params);
          });
          window.dispatchEvent(new CustomEvent("roknord:analytics-ready"));
        };

        const existingScript = document.querySelector('script[data-roknord-metrika]');
        if (existingScript) {
          if (existingScript.dataset.loaded === "true") initialize();
          else existingScript.addEventListener("load", initialize, { once: true });
          return;
        }

        const script = document.createElement("script");
        script.async = true;
        script.src = roknordMetrikaSrc;
        script.dataset.roknordMetrika = "";
        script.addEventListener("load", function () {
          script.dataset.loaded = "true";
          initialize();
        }, { once: true });
        script.addEventListener("error", function () {
          window.__roknordAnalyticsLoading = false;
        }, { once: true });
        document.head.appendChild(script);
      };

      window.__roknordDisableAnalytics = function () {
        if (window.__roknordAnalyticsOn && typeof window.ym === "function") {
          try { window.ym(roknordMetrikaId, "destruct"); } catch {}
        }
        window.__roknordAnalyticsOn = false;
        window.__roknordAnalyticsLoading = false;
        window.__roknordGoalQueue.length = 0;

        const cookieNames = document.cookie
          .split(";")
          .map((part) => part.split("=")[0]?.trim())
          .filter((name) => name && (name.startsWith("_ym") || name.startsWith("yabs")));
        const domains = ["", location.hostname, ".roknord.ru"];
        cookieNames.forEach((name) => {
          domains.forEach((domain) => {
            document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${domain ? `; Domain=${domain}` : ""}`;
          });
        });
      };

      try {
        if (window.localStorage.getItem("roknord-cookie-consent") === "accepted") {
          window.__roknordEnableAnalytics();
        }
      } catch (e) {}

      // Цели phone_click / email_click. Делегируем на document, чтобы не зависеть
      // от того, в какой секции лежит ссылка. form_submit передаётся после успешного ответа формы.
      if (!window.__roknordGoalsBound) {
        window.__roknordGoalsBound = true;

        document.addEventListener("click", function (event) {
          if (!(event.target instanceof Element)) return;
          var link = event.target.closest('a[href^="tel:"], a[href^="mailto:"]');
          if (!link) return;
          var goal = link.getAttribute("href").indexOf("tel:") === 0 ? "phone_click" : "email_click";
          window.__roknordReachGoal(goal, {
            page: window.location.pathname,
            target: link.getAttribute("href"),
          });
        });
      }

      try {
        const pendingConversion = window.sessionStorage.getItem("roknord-pending-conversion");
        if (pendingConversion) {
          window.sessionStorage.removeItem("roknord-pending-conversion");
          const conversion = JSON.parse(pendingConversion);
          window.__roknordReachGoal("form_submit", conversion);
        }
      } catch {}
    </script>
    }
  </head>
  <body>
    <a class="skip-link" href="#content">Перейти к содержимому</a>
    <div class="site-shell">
      <Header />
      <slot />
      {landingFooter ? <PdnAuditFooter /> : <Footer showCookieSettings={!privatePage} />}
      {!privatePage && <CookiePanel />}
      <ScrollUpControl />
    </div>
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealItems.forEach((item) => item.classList.add('is-revealed'));
          return;
        }

        document.documentElement.classList.add('motion-ready');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        revealItems.forEach((item) => observer.observe(item));
      })();
    </script>
    <script is:inline>
      (() => {
        const mobileQuery = window.matchMedia('(max-width: 47.99rem)');
        const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        const stories = Array.from(document.querySelectorAll('[data-scroll-story]'));
        let frameId = 0;

        const reset = () => {
          stories.forEach((story) => {
            story.classList.remove('is-scroll-story');
            story.style.removeProperty('--scroll-story-distance');
            const track = story.querySelector('[data-scroll-track]');
            if (track instanceof HTMLElement) track.style.removeProperty('transform');
          });
        };

        const update = () => {
          frameId = 0;
          stories.forEach((story) => {
            if (!(story instanceof HTMLElement) || !story.classList.contains('is-scroll-story')) return;
            const stage = story.querySelector('[data-scroll-stage]');
            const track = story.querySelector('[data-scroll-track]');
            if (!(stage instanceof HTMLElement) || !(track instanceof HTMLElement)) return;
            const distance = Math.max(0, track.scrollWidth - stage.clientWidth);
            const availableScroll = Math.max(1, story.offsetHeight - stage.offsetHeight);
            const travelled = Math.min(Math.max(-story.getBoundingClientRect().top, 0), availableScroll);
            track.style.transform = `translate3d(${-distance * (travelled / availableScroll)}px, 0, 0)`;
          });
        };

        const requestUpdate = () => {
          if (!frameId) frameId = window.requestAnimationFrame(update);
        };

        const setup = () => {
          reset();
          if (!mobileQuery.matches || reducedMotionQuery.matches) return;
          stories.forEach((story) => {
            if (!(story instanceof HTMLElement)) return;
            const stage = story.querySelector('[data-scroll-stage]');
            const track = story.querySelector('[data-scroll-track]');
            if (!(stage instanceof HTMLElement) || !(track instanceof HTMLElement)) return;
            const distance = Math.max(0, track.scrollWidth - stage.clientWidth);
            if (distance < 2) return;
            story.style.setProperty('--scroll-story-distance', `${Math.ceil(distance)}px`);
            story.classList.add('is-scroll-story');
          });
          requestUpdate();
        };

        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', setup, { passive: true });
        mobileQuery.addEventListener?.('change', setup);
        reducedMotionQuery.addEventListener?.('change', setup);
        window.addEventListener('load', setup, { once: true });
        setup();
      })();
    </script>
  </body>
</html>

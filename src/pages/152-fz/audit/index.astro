---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PdnAuditHero from "../../../components/pdn-audit/PdnAuditHero.astro";
import PdnAuditVisuals from "../../../components/pdn-audit/PdnAuditVisuals.astro";
import PdnAuditResult from "../../../components/pdn-audit/PdnAuditResult.astro";
import PdnAuditDetails from "../../../components/pdn-audit/PdnAuditDetails.astro";
import PdnAuditScenarios from "../../../components/pdn-audit/PdnAuditScenarios.astro";
import PdnAuditPricing from "../../../components/pdn-audit/PdnAuditPricing.astro";
import PdnAuditFaq from "../../../components/pdn-audit/PdnAuditFaq.astro";
import PdnAuditLeadForm from "../../../components/pdn-audit/PdnAuditLeadForm.astro";
import { pdnAuditFaqs as faq } from "../../../components/pdn-audit/pdnAuditFaqData";
import "../../../styles/pdn-audit.css";

const title = "Аудит по 152-ФЗ с комплектом документов за 22 000 ₽ | РОКНОРД";
const description = "Аудит по 152-ФЗ с документами за 22 000 ₽. За 48 часов проверим сайт, CRM и сведения Роскомнадзора, подготовим карту рисков, план исправлений, политику, согласия и проект уведомления.";
const canonical = "https://roknord.ru/152-fz/audit/";
const image = "https://roknord.ru/images/pdn-audit/shema-marshruta-personalnyh-dannyh-152-fz.webp";
const jsonLd = [{"@context":"https://schema.org","@type":"Service","name":"Аудит по 152-ФЗ со стандартным комплектом документов","description":description,"image":image,"provider":{"@type":"Organization","name":"ООО «РОКНОРД»","url":"https://roknord.ru/"},"areaServed":{"@type":"Country","name":"Россия"},"url":canonical,"offers":{"@type":"Offer","price":"22000","priceCurrency":"RUB","url":canonical}},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://roknord.ru/"},{"@type":"ListItem","position":2,"name":"152-ФЗ","item":"https://roknord.ru/152-fz/"},{"@type":"ListItem","position":3,"name":"Аудит и документы по 152-ФЗ","item":canonical}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(([question,answer])=>({"@type":"Question","name":question,"acceptedAnswer":{"@type":"Answer","text":answer}}))}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogImage={image} landingHeader landingFooter>
  <Fragment slot="head"><meta name="robots" content="index, follow" /></Fragment>
  <main id="content" class="pdn-audit">
    <PdnAuditHero /><PdnAuditScenarios /><PdnAuditVisuals /><PdnAuditResult /><PdnAuditDetails /><PdnAuditPricing /><PdnAuditFaq /><PdnAuditLeadForm />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>
    (() => {
      const metrikaId = 111070145;
      window.__pdnGoal = (name, params = {}) => { if (window.__roknordAnalyticsOn && typeof window.ym === 'function') window.ym(metrikaId, 'reachGoal', name, params); };
      window.__pdnGoal('pdn_audit_view');
      document.addEventListener('click', (event) => { const target = event.target instanceof Element ? event.target.closest('[data-pdn-goal]') : null; if (target) window.__pdnGoal(target.dataset.pdnGoal); });
      document.querySelectorAll('[data-pdn-observe]').forEach((element) => { const observer = new IntersectionObserver((entries) => { if (!entries[0].isIntersecting) return; window.__pdnGoal(element.dataset.pdnObserve); observer.disconnect(); }, { threshold: .25 }); observer.observe(element); });
    })();
  </script>
</BaseLayout>

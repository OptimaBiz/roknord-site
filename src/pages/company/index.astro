---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ООО «РОКНОРД» — официальный сайт компании"
  description="ООО «РОКНОРД» — экспертное сопровождение бизнеса в регулируемых и обязательных процедурах. Реквизиты, направления работы и контакты компании. ИНН 7807406530."
>
  <main id="content" class="company-page">
    <section class="company-page__hero">
      <div class="page-container">
        <p class="section__eyebrow">Компания</p>
        <h1>ООО «РОКНОРД»</h1>
        <p class="company-page__lead">Экспертное сопровождение бизнеса в регулируемых и обязательных процедурах.</p>
        <p>РОКНОРД работает с задачами в области Росаккредитации, персональных данных и других обязательных требований к деятельности организаций.</p>
      </div>
    </section>

    <div class="company-page__content page-container">
      <section class="company-page__section" aria-labelledby="company-facts-title">
        <p class="section__eyebrow">Идентификация</p>
        <h2 id="company-facts-title">Компания</h2>
        <dl class="company-page__facts">
          <div><dt>Юридическое лицо</dt><dd>ООО «РОКНОРД»</dd></div>
          <div><dt>Бренд латиницей</dt><dd>ROKNORD</dd></div>
          <div><dt>Дата регистрации</dt><dd>28 июля 2026 года</dd></div>
          <div><dt>ИНН</dt><dd>7807406530</dd></div>
          <div><dt>ОГРН</dt><dd>1267800054686</dd></div>
          <div><dt>КПП</dt><dd>780701001</dd></div>
          <div><dt>Регион</dt><dd>Санкт-Петербург</dd></div>
        </dl>
      </section>

      <section class="company-page__section" aria-labelledby="company-directions-title">
        <p class="section__eyebrow">Работа</p>
        <h2 id="company-directions-title">Направления</h2>
        <ul class="company-page__directions">
          <li>Подготовка к процедурам Росаккредитации и подтверждению компетентности</li>
          <li>Подготовка к первичной аккредитации</li>
          <li>Анализ и актуализация области аккредитации</li>
          <li>152-ФЗ и процессы обработки персональных данных</li>
          <li>Охрана труда и другие обязательные процедуры по мере запуска направлений</li>
        </ul>
      </section>

      <section class="company-page__links" aria-label="Дополнительная информация">
        <article><p class="section__eyebrow">Принципы</p><h2>Наш подход</h2><p>Независимая проверка требований, документов, записей и фактической практики.</p><a href="/company/mission/">Миссия, видение и ценности <span aria-hidden="true">→</span></a></article>
        <article><p class="section__eyebrow">Проект</p><h2>РАЛ-Атлас</h2><p>Информационный проект ООО «РОКНОРД» для работы с данными реестра аккредитованных лиц.</p><a href="https://atlas.roknord.ru/">Перейти в РАЛ-Атлас <span aria-hidden="true">→</span></a></article>
        <article><p class="section__eyebrow">Связаться</p><h2>Контакты и реквизиты</h2><p>Адрес, телефон, email и юридические идентификаторы компании.</p><a href="/contacts/">Контакты</a><a href="/requisites/">Реквизиты</a></article>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .company-page{background:var(--lrqa-card-light);color:var(--lrqa-black)}.company-page__hero{padding-block:clamp(4rem,8vw,8rem);color:var(--lrqa-white);background:var(--lrqa-navy)}.company-page__hero>div{display:grid;gap:var(--space-5)}.company-page h1,.company-page h2,.company-page p{margin:0}.company-page h1{max-width:13ch;font-size:var(--type-page-title);line-height:.95}.company-page__hero p{max-width:48rem;color:var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}.company-page__hero .company-page__lead{color:var(--lrqa-white);font-size:var(--type-lead)}.company-page__content{display:grid;gap:var(--space-12);padding-block:clamp(4rem,8vw,8rem)}.company-page__section{display:grid;grid-template-columns:minmax(12rem,.45fr) minmax(0,1fr);gap:var(--space-4) var(--space-8);padding-top:var(--space-6);border-top:1px solid var(--lrqa-border)}.company-page__section .section__eyebrow{grid-column:1}.company-page__section h2{grid-column:1;font-size:var(--type-section-title)}.company-page__facts,.company-page__directions{grid-column:2;grid-row:1/span 3;margin:0}.company-page__facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5)}.company-page__facts div{display:grid;gap:var(--space-1)}.company-page__facts dt{color:var(--lrqa-muted);font-size:var(--font-size-xs)}.company-page__facts dd{margin:0;color:var(--lrqa-muted-dark)}.company-page__directions{display:grid;gap:0;padding:0;list-style:none}.company-page__directions li{padding:var(--space-4) 0;border-bottom:1px solid var(--lrqa-border-soft);line-height:var(--line-height-relaxed)}.company-page__links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--lrqa-border);border-bottom:1px solid var(--lrqa-border)}.company-page__links article{display:grid;align-content:start;gap:var(--space-4);padding:var(--space-6);border-right:1px solid var(--lrqa-border)}.company-page__links article:last-child{border-right:0}.company-page__links h2{font-size:clamp(1.4rem,2vw,2rem)}.company-page__links p:not(.section__eyebrow){color:var(--lrqa-muted-dark);line-height:var(--line-height-relaxed)}.company-page__links a{width:fit-content;color:var(--lrqa-black);font-weight:var(--font-weight-semibold);text-decoration:underline;text-decoration-color:var(--color-mint-action);text-underline-offset:.2em}@media(max-width:48rem){.company-page__section{grid-template-columns:1fr}.company-page__section .section__eyebrow,.company-page__section h2,.company-page__facts,.company-page__directions{grid-column:1;grid-row:auto}.company-page__facts{grid-template-columns:1fr}.company-page__links{grid-template-columns:1fr}.company-page__links article{border-right:0;border-bottom:1px solid var(--lrqa-border)}.company-page__links article:last-child{border-bottom:0}}
</style>

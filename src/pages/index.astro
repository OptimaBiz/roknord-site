---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import InspectionLogic from "../components/InspectionLogic.astro";
import Scenarios from "../components/Scenarios.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ExpertMaterial from "../components/ExpertMaterial.astro";
import AudienceSection from "../components/AudienceSection.astro";
import ExpertiseTeamSection from "../components/ExpertiseTeamSection.astro";
import MissionTeaser from "../components/MissionTeaser.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Рокнорд — подготовка аккредитованных лиц командой под задачу"
  description="Рокнорд формирует команду профильных специалистов и отвечает за проекты по независимой проверке и подготовке к аккредитации и подтверждению компетентности."
>
  <main id="content">
    <Hero />
    <Scenarios />
    <PricingSection />
    <InspectionLogic />
    <ProcessSection />
    <AudienceSection />
    <ExpertiseTeamSection />
    <MissionTeaser />
    <ExpertMaterial />
    <FaqSection />
    <ContactForm
      eyebrow="Первый шаг"
      title="Разберите задачу с Рокнорд"
      description="Укажите тип организации, процедуру, основной вопрос и сроки. Мы определим необходимый состав компетенций и предложим формат первого этапа."
      submitLabel="Отправить запрос"
      statusText="Ответим в течение рабочего дня. Используем данные для ответа на обращение в соответствии с Политикой в отношении обработки персональных данных."
    />
  </main>
</BaseLayout>

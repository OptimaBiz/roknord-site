---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import InspectionLogic from "../components/InspectionLogic.astro";
import Scenarios from "../components/Scenarios.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ExpertMaterial from "../components/ExpertMaterial.astro";
import AudienceSection from "../components/AudienceSection.astro";
import ExpertiseTeamSection from "../components/ExpertiseTeamSection.astro";
import MissionTeaser from "../components/MissionTeaser.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactForm from "../components/ContactForm.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://roknord.ru/#website",
  url: "https://roknord.ru/",
  name: "РОКНОРД",
  alternateName: ["ROKNORD", "ООО РОКНОРД", "roknord.ru"],
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://roknord.ru/#organization",
  name: "РОКНОРД",
  legalName: "Общество с ограниченной ответственностью «РОКНОРД»",
  alternateName: ["ООО «РОКНОРД»", "ROKNORD"],
  url: "https://roknord.ru/",
  logo: "https://roknord.ru/images/brand/roknord-logo.png",
  email: "hello@roknord.ru",
  telephone: "+7-812-389-81-78",
  foundingDate: "2026-07-28",
  taxID: "7807406530",
  identifier: [
    { "@type": "PropertyValue", propertyID: "ИНН", value: "7807406530" },
    { "@type": "PropertyValue", propertyID: "ОГРН", value: "1267800054686" },
    { "@type": "PropertyValue", propertyID: "КПП", value: "780701001" },
  ],
  address: {
    "@type": "PostalAddress",
    postalCode: "198320",
    addressCountry: "RU",
    addressRegion: "Санкт-Петербург",
    addressLocality: "Красное Село",
    streetAddress: "ул. Свободы, д. 57Д, пом. 7-Н, офис 615",
  },
};
---

<BaseLayout
  title="РОКНОРД — экспертное сопровождение бизнеса в регулируемых процедурах"
  description="ООО «РОКНОРД» — экспертное сопровождение бизнеса в регулируемых и обязательных процедурах: Росаккредитация, 152-ФЗ, охрана труда. Санкт-Петербург. ИНН 7807406530."
  structuredData={[websiteSchema, organizationSchema]}
>
  <main id="content">
    <Hero />
    <Scenarios />
    <PricingSection />
    <InspectionLogic />
    <ProcessSection />
    <AudienceSection />
    <ExpertiseTeamSection />
    <MissionTeaser />
    <ExpertMaterial />
    <FaqSection />
    <ContactForm
      eyebrow="Первый шаг"
      title="Обсудите задачу с экспертом"
      description="Укажите тип организации, предстоящую процедуру и сроки. Мы предложим объём первого аудита."
      submitLabel="Отправить запрос"
      statusText="Ответим в течение рабочего дня. Используем данные для ответа на обращение в соответствии с Политикой в отношении обработки персональных данных."
    />
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import InspectionLogic from "../components/InspectionLogic.astro";
import Scenarios from "../components/Scenarios.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ExpertMaterial from "../components/ExpertMaterial.astro";
import AudienceSection from "../components/AudienceSection.astro";
import ExpertiseTeamSection from "../components/ExpertiseTeamSection.astro";
import MissionTeaser from "../components/MissionTeaser.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactForm from "../components/ContactForm.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://roknord.ru/#website",
  url: "https://roknord.ru/",
  name: "РОКНОРД",
  alternateName: ["ROKNORD", "ООО РОКНОРД", "roknord.ru"],
};

---

<BaseLayout
  title="РОКНОРД — подготовка к аккредитации и подтверждению компетентности"
  description="Начинаем с независимого аудита готовности, затем помогаем подготовиться к аккредитации или ПК: область, СМК, доказательства и корректирующие действия."
  structuredData={websiteSchema}
>
  <main id="content" class="home-content">
    <Hero />
    <Scenarios />
    <PricingSection />
    <InspectionLogic />
    <ProcessSection />
    <AudienceSection />
    <ExpertiseTeamSection />
    <MissionTeaser />
    <ExpertMaterial />
    <FaqSection />
    <ContactForm
      eyebrow="Первый шаг"
      title="Обсудите аудит готовности"
      description="Укажите тип организации, предстоящую процедуру и сроки. Определим объём первого аудита, а дальнейший план сформируем по его результатам."
      submitLabel="Отправить запрос"
      statusText="Ответим в течение рабочего дня. Используем данные для ответа на обращение в соответствии с Политикой в отношении обработки персональных данных."
    />
  </main>
</BaseLayout>

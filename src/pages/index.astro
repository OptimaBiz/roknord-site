---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import InspectionLogic from "../components/InspectionLogic.astro";
import Scenarios from "../components/Scenarios.astro";
import ProcessSection from "../components/ProcessSection.astro";
import AtlasBridge from "../components/AtlasBridge.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactForm from "../components/ContactForm.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://roknord.ru/#website",
  url: "https://roknord.ru/",
  name: "РОКНОРД",
  alternateName: ["ROKNORD", "ООО РОКНОРД", "roknord.ru"],
};

---

<BaseLayout
  title="Подготовка к аккредитации и подтверждению компетентности — РОКНОРД"
  description="Независимый аудит готовности к аккредитации и подтверждению компетентности: область, СМК, персонал, записи и фактическая практика. Реестр расхождений и план действий."
  structuredData={websiteSchema}
>
  <main id="content" class="home-content">
    <Hero />
    <Scenarios />
    <InspectionLogic />
    <ProcessSection />
    <PricingSection />
    <AtlasBridge />
    <FaqSection />
    <ContactForm
      eyebrow="Следующий шаг"
      title="Обсудим вашу процедуру и определим первый этап"
      description="Укажите тип организации, предстоящую процедуру и сроки. Согласуем состав, формат и границы независимого аудита готовности."
      submitLabel="Обсудить задачу"
      statusText="Ответим в течение рабочего дня. Используем данные для ответа на обращение в соответствии с Политикой в отношении обработки персональных данных."
    />
  </main>
</BaseLayout>

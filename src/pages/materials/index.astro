---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/service.css';
const resources = [
  { number: "01", kind: "PDF · по запросу", title: "Карта рисков перед ПК ОС СМ", desc: "Рабочие ориентиры для первичной самопроверки системы менеджмента, области и доказательств перед ПК.", link: "/materials/karta-riskov-pk-os-smk-2026/", action: "Открыть материал" },
  { number: "02", kind: "Пример · свободный доступ", title: "Как выглядит результат аудита", desc: "Учебная ситуация: наблюдение, основание, риск, рекомендуемое действие и проверка результата.", link: "/materials/audit-report-example/", action: "Изучить пример" },
  { number: "03", kind: "Статьи · первичные источники", title: "Разбор требований и изменений", desc: "Экспертные статьи с датами актуальности, практическими вопросами и ссылками на источники.", link: "/news/", action: "Перейти к публикациям" },
];
---
<BaseLayout title="Материалы для подготовки к аккредитации — Рокнорд" description="Карта рисков, учебный пример результата аудита и экспертные статьи для самостоятельной проверки документов и процессов.">
  <main id="content" class="service-page service-page--library">
    <header class="service-hero page-container">
      <p class="section__eyebrow">Библиотека Рокнорд</p>
      <h1>Материалы, которые помогают принимать решения</h1>
      <p class="service-lead">Ориентиры для самопроверки и подготовки доказательств. Состав требований к конкретной организации определяется отдельно.</p>
      <a class="service-hero__secondary" href="#materials-list">Выбрать материал <span aria-hidden="true">↓</span></a>
    </header>
    <section class="service-section page-container" id="materials-list" aria-labelledby="materials-title">
      <div class="service-intro">
        <h2 id="materials-title">Рабочая библиотека</h2>
        <p>Учебные примеры не заменяют аудит или заключение по конкретной организации. Каждый материал помогает задать правильные вопросы и разобраться в логике оценки.</p>
      </div>
      <div class="library-grid">
        {resources.map((item) => (
          <article class="library-card">
            <div class="library-card__meta"><span>{item.number}</span><span>{item.kind}</span></div>
            <h3><a href={item.link}>{item.title}</a></h3>
            <p>{item.desc}</p>
            <a class="library-card__action" href={item.link}>{item.action} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <p class="library-note">Нужен разбор вашей ситуации? <a href="/contacts/#contact">Опишите задачу специалистам Рокнорд →</a></p>
    </section>
  </main>
</BaseLayout>

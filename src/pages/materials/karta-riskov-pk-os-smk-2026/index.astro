---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "../../../components/ContactForm.astro";

const downloadHref = "/materials/karta-riskov-pk-os-smk-2026/download/";
---

<BaseLayout
  title="Карта рисков перед ПК ОС СМ — Рокнорд"
  description="Бесплатный экспертный материал Рокнорд: карта рисков перед подтверждением компетентности органов по сертификации систем менеджмента."
>
  <main id="content">
    <section class="material-download">
      <div class="material-download__inner page-container">
        <div class="material-download__copy">
          <p class="section__eyebrow">Экспертный материал</p>
          <h1 class="material-download__title">Карта рисков перед подтверждением компетентности ОС СМ</h1>
          <p class="material-download__lead">
            Материал помогает структурно проверить документы, записи, область аккредитации, СМК и доказательную базу до процедуры.
          </p>
          <div class="material-download__notice">
            <strong>Заполните короткую форму, чтобы получить PDF.</strong>
            <p>
              После успешной отправки формы откроется файл. Используем данные для предоставления материала и ответа на связанные с ним вопросы.
            </p>
          </div>
        </div>

        <ContactForm
          id="material-request"
          eyebrow="Скачивание"
          title="Получить PDF"
          description=""
          showMessage={false}
          submitLabel="Получить PDF"
          statusText="После отправки откроется PDF-файл."
          successUrl={downloadHref}
          gateKey="roknord-material-pk-os-smk-2026"
          subject="Запрос PDF: карта рисков перед ПК ОС СМ"
          formName="Получить PDF"
          embedded
        />
      </div>
    </section>
  </main>
</BaseLayout>

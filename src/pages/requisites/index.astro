---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/interior.css";
---

<BaseLayout
  title="Реквизиты ООО «РОКНОРД» — ИНН 7807406530, ОГРН 1267800054686"
  description="Юридические реквизиты ООО «РОКНОРД»: ИНН 7807406530, ОГРН 1267800054686, КПП 780701001, адрес и контакты."
>
  <main id="content" class="requisites-page">
    <div class="page-container requisites-page__inner">
      <p class="eyebrow">Юридическая информация</p>
      <h1>Реквизиты ООО «РОКНОРД»</h1>
      <p class="requisites-page__intro">Данные организации для договора, счёта и деловой переписки. Для уточнений используйте официальные контакты.</p>

      <div class="requisites-page__grid">
        <section class="requisites-page__section" aria-labelledby="company-details-title">
          <h2 id="company-details-title">Реквизиты</h2>
          <dl class="requisites-page__details">
            <div><dt>Полное наименование</dt><dd>Общество с ограниченной ответственностью «РОКНОРД»</dd></div>
            <div><dt>Сокращённое наименование</dt><dd>ООО «РОКНОРД»</dd></div>
            <div><dt>Бренд</dt><dd>РОКНОРД / ROKNORD</dd></div>
            <div class="requisites-page__inline-row">
              <div><dt>ИНН</dt><dd>7807406530 <button class="requisites-page__copy" type="button" data-copy-detail="7807406530" data-copy-label="ИНН" aria-label="Скопировать ИНН">Копировать</button></dd></div>
              <div><dt>КПП</dt><dd>780701001</dd></div>
            </div>
            <div><dt>ОГРН</dt><dd>1267800054686 <button class="requisites-page__copy" type="button" data-copy-detail="1267800054686" data-copy-label="ОГРН" aria-label="Скопировать ОГРН">Копировать</button></dd></div>
            <div><dt>Официальный сайт</dt><dd><a href="https://roknord.ru/">roknord.ru</a></dd></div>
          </dl>
          <p class="requisites-page__copy-status" data-copy-status role="status" aria-live="polite"></p>
        </section>

        <section class="requisites-page__section" aria-labelledby="address-title">
          <h2 id="address-title">Адрес</h2>
          <address class="requisites-page__address">
            198320, г. Санкт-Петербург, г. Красное Село,<br />
            ул. Свободы, д. 57Д, пом. 7-Н, офис 615
          </address>
          <p><a href="tel:+78123898178">+7(812)38-98-178</a></p>
          <p><a href="mailto:hello@roknord.ru">hello@roknord.ru</a></p>
          <section class="requisites-page__map-section" aria-labelledby="map-title">
            <h3 id="map-title">Как нас найти</h3>
            <div class="requisites-page__map">
              <iframe
                src="https://yandex.ru/map-widget/v1/?z=12&ol=biz&oid=101442465176"
                width="560"
                height="400"
                frameborder="0"
                title="Карта расположения офиса Рокнорд"
                loading="lazy"
              ></iframe>
            </div>
          </section>
        </section>
      </div>
    </div>
  </main>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy-detail]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copyDetail || "";
        const label = button.dataset.copyLabel || "Значение";
        const status = document.querySelector<HTMLElement>("[data-copy-status]");
        try {
          if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
          await navigator.clipboard.writeText(value);
          if (status) status.textContent = `${label} скопирован`;
        } catch {
          if (status) status.textContent = `Не удалось скопировать ${label}. Выделите номер и скопируйте вручную.`;
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .requisites-page__intro{max-width:43rem;margin:1rem 0 0;color:var(--lrqa-muted-dark);font-size:var(--type-lead);line-height:1.65}
  .requisites-page__details{gap:0}
  .requisites-page__details>div{padding:1rem 0;border-top:1px solid var(--lrqa-border-soft)}
  .requisites-page__details dd{color:var(--lrqa-black);font-weight:var(--font-weight-semibold);overflow-wrap:anywhere}
  .requisites-page__section>p a{font-size:clamp(1rem,1.4vw,1.2rem);font-weight:var(--font-weight-semibold)}
  .requisites-page__map{border:1px solid var(--lrqa-border)}
  @media(max-width:48rem){.requisites-page h1{font-size:clamp(2.2rem,10vw,3.2rem);line-height:1.05}.requisites-page__details .requisites-page__inline-row{gap:.6rem}}
  .requisites-page {
    background: var(--lrqa-card-light);
    color: var(--lrqa-black);
  }

  .requisites-page__inner {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .requisites-page .eyebrow {
    color: var(--lrqa-muted-dark);
  }

  .requisites-page h1 {
    margin: var(--space-3) 0 var(--space-4);
    color: var(--lrqa-black);
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    line-height: 0.98;
  }

  .requisites-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: var(--space-8);
    margin-top: var(--space-10);
  }

  .requisites-page__section,
  .requisites-page__map-section {
    padding-top: var(--space-6);
    border-top: 1px solid var(--lrqa-border);
  }

  .requisites-page h2,
  .requisites-page h3 {
    margin: 0 0 var(--space-5);
    color: var(--lrqa-black);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
  }

  .requisites-page__details {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .requisites-page__details div {
    display: grid;
    gap: var(--space-1);
  }

  .requisites-page__details .requisites-page__inline-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .requisites-page__details dt {
    color: var(--lrqa-muted);
    font-size: var(--font-size-xs);
  }

  .requisites-page__details dd,
  .requisites-page__address,
  .requisites-page p {
    margin: 0;
    color: var(--lrqa-muted-dark);
    font-size: var(--font-size-body);
    font-style: normal;
    line-height: var(--line-height-relaxed);
  }

  .requisites-page__section p + p {
    margin-top: var(--space-2);
  }

  .requisites-page a {
    color: var(--lrqa-black);
    text-decoration: underline;
    text-decoration-color: var(--lrqa-mint);
    text-underline-offset: 0.18em;
  }

  .requisites-page__map-section {
    margin-top: var(--space-7);
  }

  .requisites-page__map {
    overflow: hidden;
    border: 1px solid var(--lrqa-border);
  }

  .requisites-page__map iframe {
    display: block;
    width: 100%;
    height: clamp(18rem, 30vw, 24rem);
    border: 0;
  }

  @media (max-width: 48rem) {
    .requisites-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
